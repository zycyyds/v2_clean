errows():\n    ing_by_order[(r.subject_id, r.stay_id, r.orderid)].append((float(r[\"amount\"]), r[\"itemid\"]))\ngoldmap = {}\nfor _, r in ref.iterrows():\n    goldmap[(r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)] = r.amount\n\nSENT = {\"-999\", \"-998\", \"-997\", \"-990\", \"-888\", \"-1000\", \"-1\", \"9999\", \"99999\", \"999999\",\n        \"9999999\", \"oa\", \"\"}\nstats = defaultdict(lambda: [0, 0])\ntot = 0\nstatus_rows = defaultdict(lambda: [0, 0])\nfor _, r in ie.iterrows():\n    k = (r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)\n    g = goldmap.get(k)\n    if g is None or r[\"amount\"].strip() not in SENT:\n        continue\n    gf = float(g)\n    pairs = ing_by_order.get((r.subject_id, r.stay_id, r.orderid), [])\n    pairs = [(a, i) for a, i in pairs if a != 0]\n    if not pairs:\n        continue\n    if any((r.itemid, i) in P.IE_AMOUNT_FACTORS for a, i in pairs):\n        continue          # a known factor exists -> not the case of the validation slice\n    tot += 1\n    amts = [a for a, _ in pairs]\n    ing_amt = Counter(amts).most_common(1)[0][0]\n    oa = float(r[\"originalamount\"]) if r[\"originalamount\"] not in (\"\", None) else np.nan\n    ta = float(r[\"totalamount\"]) if r[\"totalamount\"] not in (\"\", None) else np.nan\n    rate = float(r[\"rate\"]) if r[\"rate\"] not in (\"\", None) else np.nan\n    dur = (pd.Timestamp(r.endtime) - pd.Timestamp(r.starttime)).total_seconds() / 3600.0\n    calc = rate * dur\n    cands = {\"originalamount\": oa, \"ingredient\": ing_amt, \"totalamount\": ta,\n             \"rate*duration\": calc}\n    for name, v in cands.items():\n        if not np.isfinite(v):\n            continue\n        if abs(v - gf) < 1e-12:\n            stats[name][0] += 1\n        elif abs(v - gf) <= 1e-6 * max(1.0, abs(gf)):\n            stats[name][1] += 1\n    st_ = r[\"statusdescription\"]\n    grp = status_rows[st_]\n    grp[0] += 1\n    best = min(abs(v - gf) for v in cands.values() if np.isfinite(v)) if any(\n        np.isfinite(v) for v in cands.values()) else np.nan\n    if np.isfinite(best) and best <= 1e-6 * max(1.0, abs(gf)):\n        grp[1] += 1\nprint(\"train placeholder rows without a known factor:\", tot)\nfor name, (e, n) in sorted(stats.items()):\n    print(\"  %-15s exact=%4d (%.4f)  near=%4d (%.4f)\" % (name, e, e / tot, e + n, (e + n) / tot))\nprint(\"\\nby statusdescription (rows / any candidate within 1e-6):\")\nfor st_, (n, ok) in sorted(status_rows.items(), key=lambda x: -x[1][0]):\n    print(\"  %-18s %4d %4d (%.3f)\" % (st_, n, ok, ok / max(n, 1)))\n"}
