y_id, r.orderid)].append((float(r[\"amount\"]), r[\"itemid\"]))\ngoldmap = {}\nfor _, r in ref.iterrows():\n    goldmap[(r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)] = r.amount\n\nSENT = {\"-999\", \"-998\", \"-997\", \"-990\", \"-888\", \"-1000\", \"-1\", \"9999\", \"99999\", \"999999\",\n        \"9999999\", \"oa\", \"\"}\nrecs = []\nfor _, r in ie.iterrows():\n    k = (r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)\n    g = goldmap.get(k)\n    if g is None or r[\"amount\"].strip() not in SENT:\n        continue\n    pairs = [(a, i) for a, i in ing_by_order.get((r.subject_id, r.stay_id, r.orderid), []) if a != 0]\n    oa = float(r[\"originalamount\"]) if r[\"originalamount\"] not in (\"\", None) else np.nan\n    if not np.isfinite(oa):\n        continue\n    recs.append(dict(stay=r.stay_id, ie_item=r.itemid, pairs=pairs, gold=float(g), orig=oa))\ndf = pd.DataFrame(recs)\nprint(\"placeholder rows with an original amount:\", len(df))\n\n\ndef learn(d):\n    rat = defaultdict(list)\n    for _, x in d.iterrows():\n        for a, i in x[\"pairs\"]:\n            rat[(x.ie_item, i)].append(x.gold / a)\n    return {k: Counter(v).most_common(1)[0][0] for k, v in rat.items()}\n\n\ndef predict(x, table, mode, tol=1e-6):\n    fac = None\n    for a, i in x[\"pairs\"]:\n        f = table.get((x.ie_item, i))\n        if f is not None:\n            v = a * f\n            if fac is None or abs(v - x.gold) < abs(fac - x.gold):\n                fac = v\n    if mode == \"factor\":\n        return fac if fac is not None else x.orig\n    if mode == \"original\":\n        return x.orig\n    if mode == \"combo\":\n        if fac is None:\n            return x.orig\n        if abs(fac - x.orig) <= tol * max(1.0, abs(x.orig)):\n            return fac\n        return x.orig\n    if mode == \"combo_factor\":\n        if fac is None:\n            return x.orig\n        if abs(fac - x.orig) <= tol * max(1.0, abs(x.orig)):\n            return fac