   217	def ce_apply_votes(chunk, votes, group_vals):
   218	    """valuenum of a chunk from the (itemid, value) group mode."""
   219	    val = chunk["value"].astype(str)
   220	    num_val = to_num(val)
   221	    vn = to_num(chunk["valuenum"])
   222	    keys = list(zip(chunk["itemid"].values, val.values))
   223	    mapped = []
   224	    fallback = []
   225	    for k, nv in zip(keys, num_val.values):
   226	        m = votes.get(k)
   227	        if m is None:
   228	            mapped.append(np.nan)
   229	            fallback.append(True)
   230	            continue
   231	        fallback.append(False)
   232	        if m == "E":
   233	            mapped.append(np.nan)
   234	            continue
   235	        v = float(m[1:])
   236	        if pd.notna(nv):
   237	            # the numeric value text carries the measurement itself
   238	            mapped.append(float(nv))
   239	            continue
   240	        vals = group_vals.get(k)
   241	        if vals and v != 0 and (v / 100.0) in vals:
   242	            v = v / 100.0
   243	        mapped.append(v)
   244	    mapped = pd.Series(mapped, index=chunk.index)
   245	    if any(fallback):
   246	        # no usable information in the group: the numeric value text carries the
   247	        # measurement, a text label has no code at all
   248	        alt = num_val
   249	        mapped = mapped.where(pd.Series(fallback, index=chunk.index) == False, alt)
   250	    return mapped
