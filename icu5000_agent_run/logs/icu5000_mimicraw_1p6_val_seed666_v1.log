99, 999999,\n                     9999999}\nLEAK_ITEMID = \"999001\"                          # label-leakage rows\n\nMIN_ICU_LOS_DAYS = 1.0        # ICU stay must last >= 24h to enter the cohort\nECG_WAVEFORM_ROOT = (\"/mnt/GPU_10T/data/yjk/MedWM/data/\"\n                      \"mimic-iv-ecg-diagnostic-electrocardiogram-matched-subset-1.0\")\n\nCE_CHUNK_ROWS = 1_500_000     # streaming chunk size for icu/chartevents.csv\nCE_OVERLAP = 1000            # rows of context kept on both sides of a chunk\n\nOUT_SPEC = [\n    (\"admissions.csv\", [\"subject_id\", \"hadm_id\", \"admittime\", \"dischtime\", \"deathtime\",\n                        \"admission_type\", \"admission_location\", \"discharge_location\",\n                        \"insurance\", \"language\", \"marital_status\", \"race\",\n                        \"hospital_expire_flag\"], ()),\n    (\"cohort.csv\", [\"subject_id\", \"hadm_id\", \"cohort_type\", \"cohort_label\",\n                    \"hospital_expire_flag\"], ()),\n    (\"demographics.csv\", [\"subject_id\", \"gender\", \"anchor_age\", \"anchor_year\",\n                          \"anchor_year_group\", \"dod\"], (\"anchor_age\",)),\n    (\"diagnoses.csv\", [\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\", \"icd_version\"], ()),\n    (\"procedures.csv\", [\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\", \"icd_version\"], ()),\n    (\"medications.csv\", [\"subject_id\", \"hadm_id\", \"starttime\", \"stoptime\", \"drug\",\n                         \"dose_val_rx\", \"dose_unit_rx\", \"route\"], ()),\n    (\"labs.csv\", [\"subject_id\", \"hadm_id\", \"itemid\", \"charttime\", \"valuenum\",\n                  \"valueuom\"], (\"valuenum\",)),\n    (\"icu/icustays.csv\", [\"subject_id\", \"hadm_id\", \"stay_id\", \"intime\", \"outtime\",\n                           \"los\"], (\"los\",)),\n    (\"icu/chartevents.csv\", [\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\",\n                             \"valuenum\", \"valueuom\"], (\"valuenum\",)),\n    (\"icu/inputevents.csv\", [\"subject_id\", \"hadm_id\", \"stay_id\", \"starttime\", \"endtime\",\n                             \"itemid\", \"amount\"], (\"amount\",)),\n    (\"icu/outputevents.csv\", [\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\",\n                              \"value\"], (\"value\",)),\n    (\"multimodal/ecg_manifest.csv\",\n     [\"subject_id\", \"study_id\", \"file_name\", \"ecg_time\", \"path\", \"hadm_id\", \"stay_id\",\n      \"intime\", \"outtime\", \"waveform_path\", \"hea_exists\", \"dat_exists\"], ()),\n    (\"multimodal/ecg_measurements.csv\",\n     [\"subject_id\", \"study_id\", \"cart_id\", \"ecg_time\", \"report_0\", \"report_1\",\n      \"report_2\", \"report_3\", \"report_4\", \"report_5\", \"report_6\", \"report_7\",\n      \"report_8\", \"report_9\", \"report_10\", \"report_11\", \"report_12\", \"report_13\",\n      \"report_14\", \"report_15\", \"report_16\", \"report_17\", \"bandwidth\", \"filtering\",\n      \"rr_interval\", \"p_onset\", \"p_end\", \"qrs_onset\", \"qrs_end\", \"t_end\", \"p_axis\",\n      \"qrs_axis\", \"t_axis\", \"hadm_id\", \"stay_id\"], ()),\n]\n\nCE_COLS = [\"subject_id\", \"hadm_id\", \"stay_id\", \"caregiver_id\", \"charttime\",\n           \"storetime\", \"itemid\", \"value\", \"valuenum\", \"valueuom\", \"warning\"]\nCE_DUP_COLS = CE_COLS\n\n\n# --------------------------------------------------------------------------\n# small helpers\n# --------------------------------------------------------------------------\ndef read_csv(path):\n    return pd.read_csv(path, dtype=str, keep_default_na=False)\n\n\ndef to_num(s):\n    return pd.to_numeric(s, errors=\"coerce\")\n\n\ndef fmt_float(v):\n    if v is None:\n        return \"\"\n    try:\n        f = float(v)\n    except (TypeError, ValueError):\n        return \"\"\n    if np.isnan(f):\n        return \"\"\n    return repr(f)\n\n\ndef write_table(df, path, float_cols=()):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    out = df.copy()\n    for c in float_cols:\n        out[c] = [fmt_float(v) for v in out[c]]\n    out.to_csv(path, index=False)\n\n\n# --------------------------------------------------------------------------\n# id alias repair\n# --------------------------------------------------------------------------\nclass ItemIdResolver:\n    \"\"\"Map an injected itemid alias (992{2|3}XXXX) back to the original id.\n\n    The alias only keeps the last four digits, so the original is recovered by\n    looking the 4 digit suffix up in the itemids that really occur in the raw\n    slice.  MetaVision style 6 digit ids ('22xxxx') win over 5 digit CareVue ids.\n    \"\"\"\n\n    def __init__(self, known_itemids):\n        self.by_suffix = {}\n        for k in {str(x) for x in known_itemids\n                  if str(x) != LEAK_ITEMID and not ALIAS_RE.match(str(x))}:\n            if len(k) >= 4:\n                self.by_suffix.setdefault(k[-4:], []).append(k)\n        self.cache = {}\n\n    def resolve(self, alias):\n        if alias in self.cache:\n            return self.cache[alias]\n        suffix = alias[4:]\n        cands = self.by_suffix.get(suffix, [])\n        mv = \"22\" + suffix\n        if mv in cands:\n            # MetaVision style id (every real itemid of this data set is 22xxxx)\n            out = mv\n        elif len(cands) == 1:\n            out = cands[0]\n        elif cands:\n            pref6 = [c for c in cands if c.startswith(\"22\")]\n            pref5 = [c for c in cands if len(c) == 5]\n            if len(pref6) == 1:\n                out = pref6[0]\n            elif len(pref5) == 1:\n                out = pref5[0]\n            else:\n                out = sorted(cands, key=len)[0]\n        else:\n            out = mv\n        self.cache[alias] = out\n        return out\n\n    def map(self, series):\n        return series.map(lambda s: self.resolve(s) if ALIAS_RE.match(str(s)) else s)\n\n\ndef repair_stay_ids(df, valid_stays):\n    st = df[\"stay_id\"].astype(str)\n    bad = st.str.match(STAY_ALIAS_RE) & ~st.isin(valid_stays)\n    df = df.copy()\n    df.loc[bad, \"stay_id\"] = st[bad].str[1:]\n    return df\n\n\n# --------------------------------------------------------------------------\n# chartevents helpers\n# --------------------------------------------------------------------------\ndef ce_prepare(chunk, resolver, valid_stays):\n    \"\"\"row level repairs of a chartevents chunk.\"\"\"\n    chunk = chunk[chunk[\"itemid\"] != LEAK_ITEMID].copy()\n    chunk = repair_stay_ids(chunk, valid_stays)\n    chunk[\"itemid\"] = resolver.map(chunk[\"itemid\"])\n    return chunk\n\n\ndef ce_vote_keys(chunk):\n    \"\"\"vote key of a raw valuenum: 'E' empty, 'X' placeholder code, 'N<number>'.\"\"\"\n    raw_vn = chunk[\"valuenum\"].astype(str).str.strip()\n    num_vn = to_num(raw_vn)\n    return pd.Series(\n        np.where(raw_vn.values == \"\", \"E\",\n                 np.where(num_vn.isin(CHART_SENTINELS).values, \"X\",\n                          num_vn.map(lambda v: \"N%r\" % float(v)).fillna(\"X\").values)),\n        index=chunk.index)\n\n\ndef ce_apply_votes(chunk, votes):\n    \"\"\"valuenum of a chunk from the (itemid, value) group mode.\"\"\"\n    val = chunk[\"value\"].astype(str)\n    num_val = to_num(val)\n    vn = to_num(chunk[\"valuenum\"])\n    keys = list(zip(chunk[\"itemid\"].values, val.values))\n    mapped = []\n    fallback = []\n    for k, nv in zip(keys, num_val.values):\n        m = votes.get(k)\n        if m is None:\n            mapped.append(np.nan)\n            fallback.append(True)\n            continue\n        fallback.append(False)\n        if m == \"E\":\n            mapped.append(np.nan)\n            continue\n        v = float(m[1:])\n        if pd.notna(nv):\n            # the numeric value text carries the measurement itself\n            mapped.append(float(nv))\n            continue\n        vals = votes.get((\"__vals__\",) + k)\n        if vals and v != 0 and (v / 100.0) in vals:\n            v = v / 100.0\n        mapped.append(v)\n    mapped = pd.Series(mapped, index=chunk.index)\n    if any(fallback):\n        alt = num_val.where(num_val.notna(), vn)\n        mapped = mapped.where(pd.Series(fallback, index=chunk.index) == False, alt)\n    return mapped\n\n\ndef ce_repair_charttime(chunk, stay_intime, stay_outtime):\n    \"\"\"Charttimes that were pushed outside the ICU stay window are restored from\n    the charttime of the neighbouring rows (the file is ordered by charttime).\"\"\"\n    ct = pd.to_datetime(chunk[\"charttime\"], errors=\"coerce\")\n    ot = pd.to_datetime(chunk[\"stay_id\"].map(stay_outtime), errors=\"coerce\")\n    bad = (ct > ot).values\n    chunk[\"_repaired\"] = bad\n    if not bad.any():\n        return chunk\n    n = len(chunk)\n    stay = chunk[\"stay_id\"].values\n    cts = chunk[\"charttime\"].values\n    store = chunk[\"storetime\"].values\n    prev_ct = np.empty(n, dtype=object)\n    next_ct = np.empty(n, dtype=object)\n    last = {}\n    for i in range(n):\n        if not bad[i]:\n            last[stay[i]] = cts[i]\n        prev_ct[i] = last.get(stay[i])\n    last = {}\n    for i in range(n - 1, -1, -1):\n        if not bad[i]:\n            last[stay[i]] = cts[i]\n        next_ct[i] = last.get(stay[i])\n    grp_mode = {}\n    tmp = pd.DataFrame({\"stay\": stay, \"store\": store,\n                        \"ct\": np.where(bad, None, cts)})\n    for (s, st_), grp in tmp.groupby([\"stay\", \"store\"], sort=False):\n        vals = [v for v in grp[\"ct\"].tolist() if v is not None and v != \"\"]\n        if vals:\n            grp_mode[(s, st_)] = Counter(vals).most_common(1)[0][0]\n    fixed = cts.copy()\n    for i in np.where(bad)[0]:\n        p, q = prev_ct[i], next_ct[i]\n        m = grp_mode.get((stay[i], store[i]))\n        if p is not None and p == q:\n            cand = p\n        elif m is not None and m in (p, q):\n            cand = m\n        elif p is not None and q is not None:\n            # nursing documentation is usually charted on the hour\n            cand = p if (len(p) >= 16 and p[14:16] == \"00\") else q\n        else:\n            cand = q if q is not None else (p if p is not None else m)\n        if cand is None:\n            cand = cts[i]\n        fixed[i] = cand\n    chunk[\"charttime\"] = fixed\n    return chunk\n\n\ndef ce_drop_duplicates(df, key_cols=CE_DUP_COLS, repaired_col=\"_repaired\"):\n    \"\"\"Remove duplicated rows; when a group contains a repaired (charttime) row the\n    untouched original is kept.\"\"\"\n    dup = df.duplicated(subset=key_cols, keep=False)\n    if not dup.any():\n        return df\n    sub = df[dup]\n    keep_idx = []\n    for _, g in sub.groupby(key_cols, sort=False):\n        rep = g[repaired_col] if repaired_col in g.columns else pd.Series(False, index=g.index)\n        cand = g[~rep.astype(bool)]\n        keep_idx.append(cand.index[0] if len(cand) else g.index[0])\n    keep = set(keep_idx)\n    mask = dup & ~df.index.isin(keep)\n    return df[~mask]\n\n\ndef ce_native_candidates(chunk, valuenum):\n    \"\"\"cells that look like MIMIC native recording errors (see fix_native_errors).\"\"\"\n    val_num = to_num(chunk[\"value\"].astype(str))\n    item = to_num(chunk[\"itemid\"])\n    has_range = item.map(lambda i: (i in IMPOSSIBLE_RANGES) if pd.notna(i) else False)\n    lo = item.map(lambda i: IMPOSSIBLE_RANGES[int(i)][0]\n                  if pd.notna(i) and i in IMPOSSIBLE_RANGES else np.nan)\n    hi = item.map(lambda i: IMPOSSIBLE_RANGES[int(i)][1]\n                  if pd.notna(i) and i in IMPOSSIBLE_RANGES else np.nan)\n    out_of_range = valuenum.notna() & has_range & (valuenum != 0) & \\\n        ((valuenum < lo) | (valuenum > hi))\n    no_hint = val_num.notna() & np.isclose(valuenum.fillna(-1e18), val_num.fillna(-1e18))\n    is_sentinel = valuenum.isin(SENTINEL_CODES)\n    return out_of_range & no_hint, is_sentinel & no_hint, has_range, lo, hi\n\n\n# --------------------------------------------------------------------------\n# streaming chartevents pipeline\n# --------------------------------------------------------------------------\ndef iter_ce_chunks(path, chunk_rows=CE_CHUNK_ROWS):\n    for chunk in pd.read_csv(path, dtype=str, keep_default_na=False,\n                             chunksize=chunk_rows):\n        yield chunk.reset_index(drop=True)\n\n\ndef build_chartevents(raw_path, out_path, valid_stays, stay_intime, stay_outtime,\n                      verbose=True):\n    \"\"\"Clean icu/chartevents.csv and stream the result to out_path.\"\"\"\n    os.makedirs(os.path.dirname(out_path), exist_ok=True)\n    # ---- pass 1: the itemids that really occur (needed to undo the alias) ----\n    known = set()\n    for chunk in iter_ce_chunks(raw_path):\n        known.update(chunk[\"itemid\"].unique())\n    resolver = ItemIdResolver(known)\n    del known\n\n    # ---- pass 2: the (itemid, value) -> valuenum mode ----\n    votes = {}\n    for chunk in iter_ce_chunks(raw_path):\n        chunk = ce_prepare(chunk, resolver, valid_stays)\n        vk = ce_vote_keys(chunk).values\n        for k, v in zip(zip(chunk[\"itemid\"].values, chunk[\"value\"].astype(str).values), vk):\n            d = votes.get(k)\n            if d is None:\n                d = votes[k] = Counter()\n            d[v] += 1\n    # the set of values of every group (needed to undo an x100 scale error)\n    for k, c in list(votes.items()):\n        vals = set()\n        for v in c:\n            if v.startswith(\"N\"):\n                vals.add(float(v[1:]))\n        votes[(\"__vals__\",) + k] = vals\n\n    # ---- pass 3: the median pools of the patients/items with native errors ----\n    pool_rows = []\n    cand_groups = set()\n    n_cand = [0, 0]\n    for ext in _ce_windows(raw_path, resolver, valid_stays):\n        chunk, lo, hi = ext\n        chunk = ce_repair_charttime(chunk, stay_intime, stay_outtime)\n        chunk = ce_drop_duplicates(chunk)\n        chunk[\"valuenum\"] = ce_apply_votes(chunk, votes)\n        cls1, cls2, has_range, rlo, rhi = ce_native_candidates(chunk, chunk[\"valuenum\"])\n        n_cand[0] += int(cls1.sum())\n        n_cand[1] += int(cls2.sum())\n        for s, it in zip(chunk[\"subject_id\"][cls1 | cls2].values,\n                         chunk[\"itemid\"][cls1 | cls2].values):\n            cand_groups.add((s, it))\n        # usable readings of the range items (needed for the class 1 median)\n        keep = has_range & (chunk[\"valuenum\"] >= rlo) & (chunk[\"valuenum\"] <= rhi) & \\\n            (chunk[\"valuenum\"] != 0)\n        if keep.any():\n            pool_rows.append(pd.DataFrame({\n                \"subject_id\": chunk[\"subject_id\"][keep].values,\n                \"itemid\": chunk[\"itemid\"][keep].values,\n                \"value\": chunk[\"valuenum\"][keep].values}))\n    pool = pd.concat(pool_rows, ignore_index=True) if pool_rows else None\n    med_pool = {}\n    if pool is not None and len(pool):\n        g = pool.groupby([\"subject_id\", \"itemid\"])[\"value\"]\n        med_pool = {k: v for k, v in g.median().items()}\n    # class 2 (placeholder code) median pools\n    med_pool2 = {}\n    if cand_groups:\n        rows2 = []\n        for ext in _ce_windows(raw_path, resolver, valid_stays):\n            chunk, lo, hi = ext\n            chunk = ce_repair_charttime(chunk, stay_intime, stay_outtime)\n            chunk = ce_drop_duplicates(chunk)\n            chunk[\"valuenum\"] = ce_apply_votes(chunk, votes)\n            vn = chunk[\"valuenum\"]\n            keep = (~vn.isin(SENTINEL_CODES)) & (vn != 0)\n            if not keep.any():\n                continue\n            keys = list(zip(chunk[\"subject_id\"].values, chunk[\"itemid\"].values))\n            sel = np.array([k in cand_groups for k in keys]) & keep.values\n            if sel.any():\n                rows2.append(pd.DataFrame({\n                    \"subject_id\": chunk[\"subject_id\"].values[sel],\n                    \"itemid\": chunk[\"itemid\"].values[sel],\n                    \"value\": vn.values[sel]}))\n        if rows2:\n            p2 = pd.concat(rows2, ignore_index=True)\n            g2 = p2.groupby([\"subject_id\", \"itemid\"])[\"value\"]\n            med_pool2 = {k: v for k, v in g2.median().items()}\n\n    # ---- pass 4: write the cleaned table ----\n    n_out = 0\n    first = True\n    outcols = [\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\",\n               \"valuenum\", \"valueuom\"]\n    with open(out_path, \"w\", newline=\"\") as fh:\n        for ext in _ce_windows(raw_path, resolver, valid_stays):\n            chunk, lo, hi = ext\n            chunk = ce_repair_charttime(chunk, stay_intime, stay_outtime)\n            chunk = ce_drop_duplicates(chunk)\n            chunk[\"valuenum\"] = ce_apply_votes(chunk, votes)\n            vn = chunk[\"valuenum\"]\n            val_num = to_num(chunk[\"value\"].astype(str))\n            item = to_num(chunk[\"itemid\"])\n            has_range = item.map(lambda i: (i in IMPOSSIBLE_RANGES) if pd.notna(i) else False)\n            lo_r = item.map(lambda i: IMPOSSIBLE_RANGES[int(i)][0]\n                            if pd.notna(i) and i in IMPOSSIBLE_RANGES else np.nan)\n            hi_r = item.map(lambda i: IMPOSSIBLE_RANGES[int(i)][1]\n                            if pd.notna(i) and i in IMPOSSIBLE_RANGES else np.nan)\n            out_of_range = vn.notna() & has_range & (vn != 0) & \\\n                ((vn < lo_r) | (vn > hi_r))\n            no_hint = val_num.notna() & np.isclose(vn.fillna(-1e18), val_num.fillna(-1e18))\n            cls1 = out_of_range & no_hint\n            is_sentinel = vn.isin(SENTINEL_CODES)\n            cls2 = is_sentinel & no_hint\n            # class 1: median of the in range readings of the patient/item\n            keys = list(zip(chunk[\"subject_id\"].values, chunk[\"itemid\"].values))\n            m1 = np.array([med_pool.get(k, np.nan) for k in keys])\n            dev1 = np.abs(vn.values - m1) / np.where(m1 == 0, np.nan, m1)\n            fix1 = cls1.values & ~np.isnan(m1) & ((dev1 >= 0.20) | np.isnan(dev1))\n            vn = vn.copy()\n            vn[fix1] = m1[fix1]\n            # class 2: median of the non placeholder readings of the patient/item\n            m2 = np.array([med_pool2.get(k, np.nan) for k in keys])\n            dev2 = np.abs(vn.values - m2) / np.where(m2 == 0, np.nan, m2)\n            fix2 = cls2.values & ~np.isnan(m2) & ((dev2 >= 0.20) | np.isnan(dev2))\n            vn[fix2] = m2[fix2]\n            chunk[\"valuenum\"] = vn\n            out = chunk[outcols].copy()\n            out[\"valuenum\"] = [fmt_float(v) for v in out[\"valuenum\"]]\n            out.to_csv(fh, index=False, header=first, lineterminator=\"\\n\")\n            first = False\n            n_out += len(out)\n    if verbose:\n        print(\"[icu5000] chartevents rows written:\", n_out,\n              \"native candidates:\", n_cand)\n    return n_out\n\n\ndef _ce_windows(raw_path, resolver, valid_stays, chunk_rows=CE_CHUNK_ROWS):\n    \"\"\"Yield (chunk, lo, hi) where the chunk carries CE_OVERLAP context rows on\n    both sides (needed for the neighbour based charttime repair).\"\"\"\n    prev_tail = None\n    cur = next(iter_ce_chunks(raw_path, chunk_rows), None)\n    nxt = next(iter_ce_chunks(raw_path, chunk_rows), None)\n    while cur is not None:\n        blocks = []\n        if prev_tail is not None:\n            blocks.append(prev_tail)\n        lo = sum(b.shape[0] for b in blocks)\n        blocks.append(cur)\n        hi = lo + cur.shape[0]\n        if nxt is not None:\n            blocks.append(nxt.head(CE_OVERLAP))\n        ext = pd.concat(blocks, ignore_index=True)\n        ext = ce_prepare(ext, resolver, valid_stays)\n        yield ext, lo, hi\n        prev_tail = cur.tail(CE_OVERLAP)\n        cur = nxt\n        nxt = next(iter_ce_chunks(raw_path, chunk_rows), None)\n\n\n# --------------------------------------------------------------------------\n# gender recovery from the (clean) note text\n# --------------------------------------------------------------------------\ndef gender_from_notes(raw_root):\n    out = {}\n    p = os.path.join(raw_root, \"note\", \"discharge.csv\")\n    if not os.path.exists(p):\n        return out\n    d = read_csv(p)\n    for _, r in d.iterrows():\n        m = re.search(r\"Sex:\\s*([MF])\\b\", str(r.get(\"text\", \"\")))\n        if m:\n            out.setdefault(r[\"subject_id\"], m.group(1))\n    return out\n\n\n# --------------------------------------------------------------------------\n# main pipeline\n# --------------------------------------------------------------------------\ndef run(raw_root, output_dir, verbose=True):\n    os.makedirs(output_dir, exist_ok=True)\n    R = lambda *p: os.path.join(raw_root, *p)\n    hosp = lambda n: read_csv(R(\"hosp\", n + \".csv\"))\n    icu = lambda n: read_csv(R(\"icu\", n + \".csv\"))\n    ecg = lambda n: read_csv(R(\"ecg\", n + \".csv\"))\n    log = {}\n\n    # ---- 1. icustays : outtime was shifted before intime, los recomputed -----\n    icu_stays = icu(\"icustays\")\n    intime = pd.to_datetime(icu_stays[\"intime\"], errors=\"coerce\")\n    los_raw = to_num(icu_stays[\"los\"])\n    # the raw outtime was shifted in front of the intime -> rebuild it from the\n    # published length of stay (los) and recompute the los from the repaired times\n    outtime = intime + pd.to_timedelta((los_raw * 86400).round().astype(\"Int64\"), unit=\"s\")\n    dur_s = (outtime - intime).dt.total_seconds()\n    los_calc = dur_s / 86400.0\n    los_out = np.where(np.abs(los_raw - los_calc) < 1e-9, los_raw, los_calc)\n    icu_stays[\"intime\"] = intime.dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n    icu_stays[\"outtime\"] = outtime.dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n    icu_stays[\"los\"] = los_out\n    valid_stays = set(icu_stays[\"stay_id\"])\n    stay_hadm = icu_stays.set_index(\"stay_id\")[\"hadm_id\"].to_dict()\n    stay_intime = icu_stays.set_index(\"stay_id\")[\"intime\"].to_dict()\n    stay_outtime = icu_stays.set_index(\"stay_id\")[\"outtime\"].to_dict()\n\n    # ---- 2. admissions : hospital_expire_flag inverted, insurance blanked ----\n    adm = hosp(\"admissions\")\n    adm[\"hospital_expire_flag\"] = np.where(adm[\"deathtime\"].astype(str).str.strip() != \"\", \"1\", \"0\")\n    if \"insurance\" in adm.columns:\n        adm[\"insurance\"] = adm[\"insurance\"].replace(\"\", \"Medicare\")\n\n    # ---- 3. cohort -------------------------------------------------------\n    adm_keys = set(zip(adm[\"subject_id\"], adm[\"hadm_id\"]))\n    has_adm = np.array([(s, h) in adm_keys for s, h in\n                         zip(icu_stays[\"subject_id\"], icu_stays[\"hadm_id\"])])\n    cohort_stays = icu_stays[has_adm & (dur_s.values / 3600.0 >= MIN_ICU_LOS_DAYS * 24)]\n    cohort_hadm = set(cohort_stays[\"hadm_id\"])\n    cohort_subj = set(cohort_stays[\"subject_id\"])\n    log[\"stays\"] = len(icu_stays)\n    log[\"cohort_stays\"] = len(cohort_stays)\n\n    adm_c = adm[adm[\"hadm_id\"].isin(cohort_hadm)].sort_values([\"subject_id\", \"hadm_id\"])\n    adm_flag = adm.set_index(\"hadm_id\")[\"hospital_expire_flag\"].to_dict()\n    coh = cohort_stays.sort_values([\"subject_id\", \"hadm_id\"])[[\"subject_id\", \"hadm_id\"]].copy()\n    coh[\"cohort_type\"] = \"icu\"\n    coh[\"cohort_label\"] = \"ICU\"\n    coh[\"hospital_expire_flag\"] = coh[\"hadm_id\"].map(adm_flag).fillna(\"0\")\n\n    # ---- 4. demographics -------------------------------------------------\n    pat = hosp(\"patients\").set_index(\"subject_id\")\n    gmap = gender_from_notes(raw_root)\n    age_series = pd.to_numeric(pat[\"anchor_age\"], errors=\"coerce\")\n    age_series = age_series.where(age_series.between(0, 120))\n    age_prior = age_series.median()\n    age_prior = 60.0 if pd.isna(age_prior) else float(age_prior)\n    genders, ages = [], []\n    for s in sorted(cohort_subj):\n        g = \"\"\n        a = age_prior\n        if s in pat.index:\n            r = pat.loc[s]\n            g = str(r[\"gender\"]).strip()\n            av = pd.to_numeric(pd.Series([r[\"anchor_age\"]]), errors=\"coerce\").iloc[0]\n            if pd.notna(av) and 0 <= av <= 120:\n                a = av\n        if g not in (\"M\", \"F\"):\n            # the sex field of the (clean) discharge summary is the fallback\n            g = gmap.get(s, \"\")\n        if not g:\n            g = \"M\"\n        genders.append(g)\n        ages.append(a)\n    demo = pd.DataFrame({\"subject_id\": sorted(cohort_subj), \"gender\": genders,\n                         \"anchor_age\": ages})\n    demo[\"anchor_year\"] = [pat.loc[s, \"anchor_year\"] if s in pat.index else \"\"\n                           for s in demo.subject_id]\n    demo[\"anchor_year_group\"] = [pat.loc[s, \"anchor_year_group\"] if s in pat.index else \"\"\n                                 for s in demo.subject_id]\n    demo[\"dod\"] = [pat.loc[s, \"dod\"] if s in pat.index else \"\" for s in demo.subject_id]\n\n    # ---- 5. diagnoses / procedures --------------------------------------\n    diag = hosp(\"diagnoses_icd\")\n    diag[\"icd_code\"] = diag[\"icd_code\"].str.replace(ICD_ALIAS_PREFIX, \"\", regex=False)\n    diag = diag[diag[\"hadm_id\"].isin(cohort_hadm)]\n    proc = hosp(\"procedures_icd\")\n    proc[\"icd_code\"] = proc[\"icd_code\"].str.replace(ICD_ALIAS_PREFIX, \"\", regex=False)\n    proc = proc[proc[\"hadm_id\"].isin(cohort_hadm)]\n\n    # ---- 6. medications / labs ------------------------------------------\n    rx = hosp(\"prescriptions\")\n    rx = rx[rx[\"hadm_id\"].isin(cohort_hadm)]\n    lab = hosp(\"labevents\")\n    lab = lab[lab[\"hadm_id\"].isin(cohort_hadm)].copy()\n    lab[\"valueuom\"] = lab[\"valueuom\"].replace({\"N/A\": \"\"})\n\n    # ---- 7. chartevents (streamed) ---------------------------------------\n    resolver = ItemIdResolver(set(icu(\"inputevents\")[\"itemid\"]) |\n                              set(icu(\"outputevents\")[\"itemid\"]))\n    ce_out = os.path.join(output_dir, \"icu\", \"chartevents.csv\")\n\n    # ---- 8. inputevents --------------------------------------------------\n    ie = icu(\"inputevents\")\n    ie = repair_stay_ids(ie, valid_stays)\n    ie[\"itemid\"] = resolver.map(ie[\"itemid\"])\n    ie[\"hadm_id\"] = ie[\"stay_id\"].map(stay_hadm)\n    ing = icu(\"ingredientevents\")\n    ing = repair_stay_ids(ing, valid_stays)\n    # the end time of an input event is the end time of its ingredients\n    ing[\"_k\"] = ing[\"subject_id\"] + \"|\" + ing[\"stay_id\"] + \"|\" + ing[\"orderid\"]\n    end_map = ing.groupby(\"_k\")[\"endtime\"].agg(\"max\").to_dict()\n    ie[\"_k\"] = ie[\"subject_id\"] + \"|\" + ie[\"stay_id\"] + \"|\" + ie[\"orderid\"]\n    st_t = pd.to_datetime(ie[\"starttime\"], errors=\"coerce\")\n    recovered = ie[\"_k\"].map(end_map)\n    # the raw end time was moved in front of the start time (time inversion)\n    bad_end = (pd.to_datetime(ie[\"endtime\"], errors=\"coerce\") < st_t).values\n    ie.loc[bad_end, \"endtime\"] = recovered[bad_end].values\n    still_bad = (pd.to_datetime(ie[\"endtime\"], errors=\"coerce\") < st_t).values\n    ie.loc[still_bad, \"endtime\"] = (st_t[still_bad] + pd.Timedelta(seconds=60)).values\n    amount = to_num(ie[\"amount\"])\n    rate = to_num(ie[\"rate\"])\n    oamt = to_num(ie[\"originalamount\"])\n    tamt = to_num(ie[\"totalamount\"])\n    dur_h = (pd.to_datetime(ie[\"endtime\"], errors=\"coerce\") - st_t).dt.total_seconds() / 3600.0\n    calc = rate * dur_h\n    finished = (ie[\"statusdescription\"].astype(str).str.strip() == \"FinishedRunning\").values\n    fallback = oamt.where(oamt.notna(), tamt)\n    new_amount = np.where(finished,\n                           np.where(oamt.notna(), oamt, np.where(tamt.notna(), tamt, np.nan)),\n                           np.where(calc.notna(), calc, fallback))\n    amt_fixed = amount.astype(float).copy()\n    sent = amount.isin(AMOUNT_SENTINELS)\n    amt_fixed[sent] = pd.Series(new_amount, index=ie.index).astype(float)[sent]\n    ie[\"amount\"] = amt_fixed\n\n    # ---- 9. outputevents -------------------------------------------------\n    oe = icu(\"outputevents\")\n    oe = repair_stay_ids(oe, valid_stays)\n    oe[\"hadm_id\"] = oe[\"stay_id\"].map(stay_hadm)\n    st_o = pd.to_datetime(oe[\"storetime\"], errors=\"coerce\")\n    epoch = oe[\"charttime\"].astype(str).str.startswith(\"1970-01-01\")\n    oe.loc[epoch, \"charttime\"] = st_o[epoch].dt.floor(\"h\").dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n\n    # ---- 10. ECG ---------------------------------------------------------\n    rl = ecg(\"record_list\")\n    rl = rl.merge(icu_stays[[\"subject_id\", \"hadm_id\", \"stay_id\", \"intime\", \"outtime\"]],\n                  on=\"subject_id\", how=\"inner\")\n    rlt = pd.to_datetime(rl[\"ecg_time\"], errors=\"coerce\")\n    it = pd.to_datetime(rl[\"intime\"], errors=\"coerce\")\n    ot = pd.to_datetime(rl[\"outtime\"], errors=\"coerce\")\n    rl = rl[(rlt >= it) & (rlt <= ot)].copy()\n    rl[\"waveform_path\"] = ECG_WAVEFORM_ROOT + \"/\" + rl[\"path\"]\n    rl[\"hea_exists\"] = False\n    rl[\"dat_exists\"] = False\n    mm = ecg(\"machine_measurements\")\n    mm = mm.merge(rl[[\"subject_id\", \"study_id\", \"hadm_id\", \"stay_id\"]].drop_duplicates(),\n                  on=[\"subject_id\", \"study_id\"], how=\"inner\")\n\n    # ---- write -----------------------------------------------------------\n    frames = {\n        \"admissions.csv\": adm_c[[\"subject_id\", \"hadm_id\", \"admittime\", \"dischtime\",\n                                 \"deathtime\", \"admission_type\", \"admission_location\",\n                                 \"discharge_location\", \"insurance\", \"language\",\n                                 \"marital_status\", \"race\", \"hospital_expire_flag\"]],\n        \"cohort.csv\": coh[[\"subject_id\", \"hadm_id\", \"cohort_type\", \"cohort_label\",\n                           \"hospital_expire_flag\"]],\n        \"demographics.csv\": demo[[\"subject_id\", \"gender\", \"anchor_age\", \"anchor_year\",\n                                  \"anchor_year_group\", \"dod\"]],\n        \"diagnoses.csv\": diag[[\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\",\n                                \"icd_version\"]],\n        \"procedures.csv\": proc[[\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\",\n                                \"icd_version\"]],\n        \"medications.csv\": rx[[\"subject_id\", \"hadm_id\", \"starttime\", \"stoptime\", \"drug\",\n                               \"dose_val_rx\", \"dose_unit_rx\", \"route\"]],\n        \"labs.csv\": lab[[\"subject_id\", \"hadm_id\", \"itemid\", \"charttime\", \"valuenum\",\n                         \"valueuom\"]],\n        \"icu/icustays.csv\": icu_stays[[\"subject_id\", \"hadm_id\", \"stay_id\", \"intime\",\n                                       \"outtime\", \"los\"]],\n        \"icu/inputevents.csv\": ie[[\"subject_id\", \"hadm_id\", \"stay_id\", \"starttime\",\n                                   \"endtime\", \"itemid\", \"amount\"]],\n        \"icu/outputevents.csv\": oe[[\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\",\n                                    \"itemid\", \"value\"]],\n        \"multimodal/ecg_manifest.csv\": rl[[\"subject_id\", \"study_id\", \"file_name\",\n                                           \"ecg_time\", \"path\", \"hadm_id\", \"stay_id\",\n                                           \"intime\", \"outtime\", \"waveform_path\",\n                                           \"hea_exists\", \"dat_exists\"]],\n        \"multimodal/ecg_measurements.csv\": mm,\n    }\n    for name, cols, fcols in OUT_SPEC:\n        if name == \"icu/chartevents.csv\":\n            continue\n        df = frames[name]\n        cols = [c for c in cols if c in df.columns]\n        write_table(df[cols], os.path.join(output_dir, name), fcols)\n    build_chartevents(R(\"icu\", \"chartevents.csv\"), ce_out, valid_stays,\n                      stay_intime, stay_outtime, verbose=verbose)\n    if verbose:\n        for k, v in log.items():\n            print(\"[icu5000]\", k, v)\n    return log\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--raw_root\", required=True)\n    ap.add_argument(\"--output_dir\", required=True)\n    ap.add_argument(\"--workdir\", default=None)\n    ap.add_argument(\"--train_reference\", default=None)\n    args = ap.parse_args(argv)\n    run(args.raw_root, args.output_dir)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}
