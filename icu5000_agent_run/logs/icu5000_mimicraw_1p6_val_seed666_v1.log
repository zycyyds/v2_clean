 r.amount\n\nSENT = {\"-999\", \"-998\", \"-997\", \"-990\", \"-888\", \"-1000\", \"-1\", \"9999\", \"99999\", \"999999\", \"9999999\", \"oa\", \"\"}\n\n\ndef num(x):\n    try:\n        return float(x)\n    except (TypeError, ValueError):\n        return np.nan\n\n\ndef build(pick_ing, ing_mode, fallback_order):\n    \"\"\"returns {key: amount}\"\"\"\n    res = {}\n    for _, r in ie.iterrows():\n        k = (r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)\n        amt = num(r[\"amount\"])\n        if not (r[\"amount\"].strip() in SENT):\n            res[k] = amt\n            continue\n        val = np.nan\n        if pick_ing:\n            ings = ing_by_order.get((r.subject_id, r.stay_id, r.orderid), [])\n            amts = [num(x[\"amount\"]) for x in ings]\n            amts = [a for a in amts if not np.isnan(a)]\n            if amts:\n                if ing_mode == \"first\":\n                    val = amts[0]\n                elif ing_mode == \"uniq_first\":\n                    val = sorted(set(amts))[0]\n                elif ing_mode == \"max\":\n                    val = max(amts)\n                elif ing_mode == \"sum\":\n                    val = sum(amts)\n                elif ing_mode == \"mode\":\n                    c = Counter(amts)\n                    val = c.most_common(1)[0][0]\n        if np.isnan(val):\n            for src in fallback_order:\n                v = num(r.get(src, \"\"))\n                if not np.isnan(v):\n                    val = v\n                    break\n        if np.isnan(val):\n            st = pd.Timestamp(r.starttime); en = pd.Timestamp(r.endtime)\n            rate = num(r[\"rate\"])\n            if not np.isnan(rate):\n                val = rate * ((en - st).total_seconds() / 3600.0)\n        res[k] = val\n    return res\n\n\ndef score(res):\n    hit = tot = 0\n    for k, g in goldmap.items():\n        v = res.get(k, np.nan)\n        tot += 1\n        if not np.isnan(v) and abs(v - float(g)) < 1e