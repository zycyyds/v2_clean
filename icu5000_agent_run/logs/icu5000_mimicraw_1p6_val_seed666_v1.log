g_by_order[(r.subject_id, r.stay_id, r.orderid)].append((float(r[\"amount\"]), r[\"itemid\"]))\ngoldmap = {}\nfor _, r in ref.iterrows():\n    goldmap[(r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)] = r.amount\n\nSENT = {\"-999\", \"-998\", \"-997\", \"-990\", \"-888\", \"-1000\", \"-1\", \"9999\", \"99999\", \"999999\",\n        \"9999999\", \"oa\", \"\"}\nrecs = []\nfor _, r in ie.iterrows():\n    k = (r.subject_id, r.hadm_id, r.stay_id, r.starttime, r.endtime, r.itemid)\n    g = goldmap.get(k)\n    if g is None or r[\"amount\"].strip() not in SENT:\n        continue\n    pairs = [(a, i) for a, i in ing_by_order.get((r.subject_id, r.stay_id, r.orderid), []) if a != 0]\n    if not pairs:\n        continue\n    recs.append(dict(stay=r.stay_id, ie_item=r.itemid, pairs=pairs, gold=float(g)))\ndf = pd.DataFrame(recs)\nprint(\"placeholder rows:\", len(df))\n\n\ndef snap(v, max_q=1000, tol=1e-6):\n    try:\n        f = Fraction(v).limit_denominator(max_q)\n    except (ValueError, ZeroDivisionError):\n        return v\n    if abs(float(f) - v) <= tol * max(abs(v), 1e-12):\n        return float(f)\n    return v\n\n\ndef learn(d, estimator):\n    rat = defaultdict(list)\n    for _, x in d.iterrows():\n        for a, i in x[\"pairs\"]:\n            rat[(x.ie_item, i)].append(x.gold / a)\n    out = {}\n    for k, v in rat.items():\n        if estimator == \"mode\":\n            out[k] = Counter(v).most_common(1)[0][0]\n        elif estimator == \"median\":\n            out[k] = float(np.median(v))\n        elif estimator == \"median_snap\":\n            out[k] = snap(float(np.median(v)))\n        elif estimator == \"mode_snap\":\n            out[k] = snap(Counter(v).most_common(1)[0][0])\n    return out\n\n\ndef score(d, table):\n    exact = near = tot = 0\n    for _, x in d.iterrows():\n        tot += 1\n        best = None\n        for a, i in x[\"pairs\"]:\n            f = table.get((x.ie_item, i))\n            if f is None:\n                continu