   261	        return chunk
   262	    n = len(chunk)
   263	    stay = chunk["stay_id"].values
   264	    cts = chunk["charttime"].values
   265	    store = chunk["storetime"].values
   266	    prev_ct = np.empty(n, dtype=object)
   267	    next_ct = np.empty(n, dtype=object)
   268	    last = {}
   269	    for i in range(n):
   270	        if not bad[i]:
   271	            last[stay[i]] = cts[i]
   272	        prev_ct[i] = last.get(stay[i])
   273	    last = {}
   274	    for i in range(n - 1, -1, -1):
   275	        if not bad[i]:
   276	            last[stay[i]] = cts[i]
   277	        next_ct[i] = last.get(stay[i])
   278	    grp_mode = {}
