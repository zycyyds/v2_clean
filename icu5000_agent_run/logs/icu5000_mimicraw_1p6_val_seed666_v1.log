edian(),\n            float((grp.store_ts.dt.floor(\"h\").dt.strftime(\"%Y-%m-%d %H:%M:%S\") == grp.gold).mean())))\n\nstays = sorted(df.stay.unique())\nlearn = set(stays[::2])\ntr = df[df.stay.isin(learn)]\nte = df[~df.stay.isin(learn)]\nmed = tr.groupby(\"item\")[\"delay\"].median()\nglob = tr.delay.median()\nprint(\"\\nglobal median delay:\", glob, \" per itemid medians:\", len(med))\n\n\ndef score(d, use_item, delay_map, glob_delay):\n    hit = 0\n    for _, r in d.iterrows():\n        dl = delay_map.get(r.item, glob_delay) if use_item else glob_delay\n        cand = (r.store_ts - pd.Timedelta(seconds=dl)).dt.floor(\"h\")\n        hit += int(cand.dt.strftime(\"%Y-%m-%d %H:%M:%S\") == r.gold)\n    return hit\n\n\nbase = score(te, False, {}, 0)\nprint(\"held-out baseline (floor of the storetime): %d/%d (%.4f)\" % (base, len(te), base / len(te)))\nfor shift in (0, 300, 600, 900, 1200, 1800):\n    c = score(te, True, med, glob)\n    print(\"  per itemid delay (median %d s) shift %4d: %d/%d (%.4f)\"\n          % (glob, shift, c, len(te), c / len(te)))\n# global delay sweep\nprint(\"\\nglobal delay sweep:\")\nfor dl in range(0, 3601, 300):\n    c = score(te, False, {}, dl)\n    print(\"   delay %4d s: %d/%d (%.4f)\" % (dl, c, len(te), c / len(te)))\n"}
