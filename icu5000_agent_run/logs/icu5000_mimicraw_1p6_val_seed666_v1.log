{"replace_all":false,"old_string":"def repair_chartevents_valuenum(ce):\n    \"\"\"* numeric `value` text -> valuenum = float(value)\n       * textual `value`      -> valuenum = the enum code observed for the same\n         (itemid, value) elsewhere in the table\n    \"\"\"\n    val = ce[\"value\"].astype(str)\n    vn = to_num(ce[\"valuenum\"])\n    num_val = to_num(val)\n    is_num = num_val.notna().values\n    out = vn.copy()\n    out[is_num] = num_val[is_num]\n    txt_idx = ce.index[~is_num]\n    if len(txt_idx):\n        sub = ce.loc[txt_idx]\n        clean = to_num(sub[\"valuenum\"])\n        clean = clean.where(~clean.isin(CHART_SENTINELS))\n        modes = clean.groupby([sub[\"itemid\"], sub[\"value\"]]).agg(\n            lambda s: Counter(s.dropna()).most_common(1)[0][0] if len(s.dropna()) else np.nan)\n        keys = list(zip(sub[\"itemid\"], sub[\"value\"]))\n        mapped = pd.Series([modes.get(k, np.nan) for k in keys], index=sub.index)\n        mapped = mapped.fillna(vn.loc[txt_idx])          # keep raw when unknown\n        out.loc[txt_idx] = mapped\n    return out","new_string":"def repair_chartevents_valuenum(ce):\n    \"\"\"* numeric `value` text -> valuenum = float(value)\n       * textual `value`      -> valuenum = the enum code that is observed for the\n         same (itemid, value) elsewhere in the table (the clean code is constant\n         for a given (itemid, value); injected placeholder codes and x100 scale\n         errors are outvoted by the mode).\n    \"\"\"\n    val = ce[\"value\"].astype(str)\n    vn = to_num(ce[\"valuenum\"])\n    num_val = to_num(val)\n    is_num = num_val.notna().values\n    out = vn.copy()\n    out[is_num] = num_val[is_num]\n    txt_idx = ce.index[~is_num]\n    if len(txt_idx):\n        sub = ce.loc[txt_idx]\n        raw_vn = sub[\"valuenum\"].astype(str).str.strip()\n        num_vn = to_num(raw_vn)\n        # placeholder codes never win the vote\n        good = num_vn.where(~num_vn.isin(CHART_SENTINELS))\n        # empty strings are a legitimate value (no code for this label)\n        good = good.where(good.notna(), np.where(raw_vn.values == \"\", np.nan, good))\n        codes = raw_vn.where(raw_vn == \"\", good.map(lambda v: np.nan if pd.isna(v) else v))\n        keys = list(zip(sub[\"itemid\"], sub[\"value\"]))\n        grp = pd.DataFrame({\"itemid\": sub[\"itemid\"].values, \"value\": sub[\"value\"].values,\n                            \"num\": good.values, \"empty\": (raw_vn.values == \"\")})\n        mode_num = grp.groupby([\"itemid\", \"value\"])[\"num\"].agg(\n            lambda s: Counter(s.dropna()).most_common(1)[0][0] if len(s.dropna()) else np.nan)\n        n_empty = grp.groupby([\"itemid\", \"value\"])[\"empty\"].sum()\n        n_num = grp.groupby([\"itemid\", \"value\"])[\"num\"].count()\n        mapped = []\n        for k in keys:\n            m = mode_num.get(k, np.nan)\n            if pd.isna(m):\n                mapped.append(np.nan)\n                continue\n            # a x100 scale error must not win: prefer the un-scaled value\n            vals = set(grp[(grp[\"itemid\"] == k[0]) & (grp[\"value\"] == k[1])][\"num\"].dropna())\n            if m / 100.0 in vals and m != 0:\n                m = m / 100.0\n            elif m * 100.0 in vals:\n                m = m * 100.0\n            mapped.append(m)\n        mapped = pd.Series(mapped, index=sub.index)\n        # groups whose clean value is empty (the label has no numeric code)\n        empty_grp = set(n_empty[(n_empty > 0) & (n_num == 0)].index)\n        mapped = pd.Series([np.nan if (k in empty_grp) else v\n                            for k, v in zip(keys, mapped.values)], index=sub.index)\n        mapped = mapped.fillna(vn.loc[txt_idx])\n        out.loc[txt_idx] = mapped\n    return out"}
