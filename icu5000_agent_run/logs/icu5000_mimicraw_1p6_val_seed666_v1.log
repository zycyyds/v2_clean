 = g.charttime.tolist()\n    bad = g._bad.tolist()\n    n = len(idx)\n    for a in range(n):\n        if not bad[a]:\n            continue\n        p = None\n        for b in range(a - 1, -1, -1):\n            if not bad[b]:\n                p = vals[b]\n                break\n        q = None\n        for b in range(a + 1, n):\n            if not bad[b]:\n                q = vals[b]\n                break\n        prev_ct[idx[a]] = p\n        next_ct[idx[a]] = q\n\nDELAYS = [0, 300, 600, 900, 1200, 1800, 2700]\nhits = Counter()\ntot = 0\nfor i in range(len(raw)):\n    if not raw._bad.iloc[i] or not raw.gold_ct.iloc[i]:\n        continue\n    p, q, g = prev_ct.get(i), next_ct.get(i), raw.gold_ct.iloc[i]\n    store = pd.Timestamp(raw.storetime.iloc[i])\n    tot += 1\n    hits[\"total\"] += 1\n    if p is not None and q is not None:\n        if p == q:\n            hits[\"p==q\"] += (p == g)\n        hits[\"prev\"] += (p == g)\n        hits[\"next\"] += (q == g)\n        mid = (pd.Timestamp(p) + (pd.Timestamp(q) - pd.Timestamp(p)) / 2).strftime(\"%Y-%m-%d %H:%M:%S\")\n        hits[\"mid\"] += (mid == g)\n        # the current rule\n        cur = p if (len(p) >= 16 and p[14:16] == \"00\") else q\n        hits[\"current\"] += (cur == g)\n        # closest point to (storetime - delay), restricted to the interval\n        for d in DELAYS:\n            target = store - pd.Timedelta(seconds=d)\n            lo, hi = pd.Timestamp(p), pd.Timestamp(q)\n            cand = target if lo <= target <= hi else (min(max(target, lo), hi))\n            hits[\"interval_d%d\" % d] += (cand.strftime(\"%Y-%m-%d %H:%M:%S\") == g)\n            # hour boundaries inside the interval, closest to the target\n            hs = []\n            h = lo.floor(\"h\")\n            while h <= hi:\n                hs.append(h)\n                h += pd.Timedelta(hours=1)\n            if hs:\n                best = min(hs, key=lambda x: abs((x - target).total_seconds()))\n                hits[\"hour_d%d\" % d] += (best.strftime(\"%Y-%m-%d %H:%M:%S\") == g)\n                hits[\"hour_first\"] += (hs[0].strftime(\"%Y-%m-%d %H:%M:%S\") == g)\n                hits[\"hour_last\"] += (hs[-1].strftime(\"%Y-%m-%d %H:%M:%S\") == g)\n    else:\n        hits[\"no_interval\"] += 1\nprint(\"overwritten rows with a reference chart time:\", tot)\nfor k, v in hits.most_common():\n    print(\"  %-14s %d (%.4f)\" % (k, v, v / tot))\n"}
