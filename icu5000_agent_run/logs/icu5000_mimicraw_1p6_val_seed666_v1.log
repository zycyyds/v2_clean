{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_1p6_val_seed666_v1/agent_workdir/work/scripts/selfcheck.py","content":"\"\"\"Self check: run the pipeline on a raw slice and compare with a reference package.\"\"\"\nimport os\nimport sys\nimport numpy as np\nimport pandas as pd\n\nsys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))\nimport icu5000_pipeline as P\n\nFILES = [\n    \"admissions.csv\", \"cohort.csv\", \"demographics.csv\", \"diagnoses.csv\",\n    \"procedures.csv\", \"medications.csv\", \"labs.csv\",\n    \"icu/icustays.csv\", \"icu/chartevents.csv\", \"icu/inputevents.csv\",\n    \"icu/outputevents.csv\",\n    \"multimodal/ecg_manifest.csv\", \"multimodal/ecg_measurements.csv\",\n]\n\n\ndef read(p):\n    return pd.read_csv(p, dtype=str, keep_default_na=False)\n\n\ndef norm(df):\n    df = df.copy()\n    for c in df.columns:\n        df[c] = df[c].str.strip()\n    return df\n\n\ndef compare(out_dir, ref_dir, verbose=True):\n    total_key = total_cell = 0\n    report = []\n    for f in FILES:\n        op = os.path.join(out_dir, f)\n        rp = os.path.join(ref_dir, f)\n        if not os.path.exists(op):\n            report.append((f, \"MISSING OUTPUT\", 0, 0))\n            continue\n        o = read(op)\n        r = read(rp)\n        if list(o.columns) != list(r.columns):\n            report.append((f, f\"SCHEMA {list(o.columns)} != {list(r.columns)}\", 0, 0))\n            continue\n        o = norm(o)\n        r = norm(r)\n        # key = all columns except the ones that are 'value' like\n        keycols = list(o.columns)\n        # composite key: try the full tuple first\n        okey = o.astype(str).agg(\"|\".join, axis=1)\n        rkey = r.astype(str).agg(\"|\".join, axis=1)\n        ok = set(okey)\n        rk = set(rkey)\n        inter = len(ok & rk)\n        # cell level: count matching cells on the intersection\n        om = o.set_index(okey)\n        rm = r.set_index(rkey)\n        common = [k for k in (ok & rk)]\n        cells = 0\n        celltot = 0\n        for k in common:\n            a = om.loc[k]\n            b = rm.loc[k]\n            if isinstance(a, pd.Series):\n                a = a.to_frame().T\n                b = b.to_frame().T\n            for c in o.columns:\n                celltot += 1\n                if str(a.iloc[0][c]) == str(b.iloc[0][c]):\n                    cells += 1\n        # rows in ref not found in out and vice versa\n        report.append((f, \"rows out=%d ref=%d keymatch=%d/%d cellacc=%.4f\"\n                       % (len(o), len(r), inter, len(rk),\n                          cells / celltot if celltot else 0.0),\n                       inter, len(rk)))\n        total_key += inter\n        total_cell += cells\n    if verbose:\n        for f, msg, a, b in report:\n            print(\"%-38s %s\" % (f, msg))\n        print(\"TOTAL key matches %d / %d\" % (total_key, sum(x[3] for x in report)))\n    return report\n\n\nif __name__ == \"__main__\":\n    out = sys.argv[1]\n    ref = sys.argv[2]\n    compare(out, ref)\n"}
