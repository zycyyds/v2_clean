\n\nrows = raw[raw._bad & (raw.gold_ct != \"\")].copy()\nprint(\"corrupted rows matched to a reference row:\", len(rows),\n      \" of which the reference charttime is recoverable by the neighbours\")\nrows = rows.sort_values([\"stay_id\"])\nprev_ct = {}\nnext_ct = {}\nstore_mode = {}\nfor (s, st), g in rows.groupby([\"subject_id\", \"stay_id\"]):\n    g = g.sort_index()\n    vals = g.charttime.tolist()\n    for i in range(len(vals)):\n        p = None\n        for j in range(i - 1, -1, -1):\n            if not rows._bad.iloc[j] if False else not raw._bad[g.index[j]]:\n                p = vals[j]\n                break\n        q = None\n        for j in range(i + 1, len(vals)):\n            if not raw._bad[g.index[j]]:\n                q = vals[j]\n                break\n        prev_ct[g.index[i]] = p\n        next_ct[g.index[i]] = q\nprint(\"rows with a previous/next neighbour:\", sum(1 for i in rows.index if prev_ct.get(i) or next_ct.get(i)))\n\nresults = Counter()\nfor i, r in rows.iterrows():\n    p, q, g = prev_ct.get(i), next_ct.get(i), r.gold_ct\n    if p is not None and q is not None and p == q:\n        cands = {\"p==q\": p}\n    elif p is not None and q is not None:\n        mid = (pd.Timestamp(p) + (pd.Timestamp(q) - pd.Timestamp(p)) / 2).strftime(\"%Y-%m-%d %H:%M:%S\")\n        cands = {\"prev\": p, \"next\": q, \"mid\": mid,\n                 \"prev_on_hour\": p if p[14:16] == \"00\" else q}\n    elif p is not None:\n        cands = {\"prev\": p}\n    elif q is not None:\n        cands = {\"next\": q}\n    else:\n        cands = {\"none\": \"\"}\n    for name, v in cands.items():\n        if v == g:\n            results[name] += 1\n    results[\"total\"] += 1\nprint(\"\\nrule hits:\")\nfor k, v in results.most_common():\n    print(\"  %-12s %d (%.4f)\" % (k, v, v / results[\"total\"]))\n"}
