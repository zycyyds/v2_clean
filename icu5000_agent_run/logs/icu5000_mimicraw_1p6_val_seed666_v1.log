   341	def _ce_windows(raw_path, resolver, valid_stays, chunk_rows=CE_CHUNK_ROWS):
   342	    """Yield the prepared chunks.  Every chunk carries CE_OVERLAP context rows of
   343	    the previous and of the next chunk (needed by the neighbour based charttime
   344	    repair and by the de-duplication)."""
   345	    prev_tail = None
   346	    gen = iter_ce_chunks(raw_path, chunk_rows)
   347	    cur = next(gen, None)
   348	    nxt = next(gen, None)
   349	    while cur is not None:
   350	        blocks = []
   351	        if prev_tail is not None:
   352	            blocks.append(ce_prepare(prev_tail, resolver, valid_stays))
   353	        lo = sum(b.shape[0] for b in blocks)
   354	        blocks.append(ce_prepare(cur, resolver, valid_stays))
   355	        hi = lo + blocks[-1].shape[0]
   356	        if nxt is not None:
   357	            blocks.append(ce_prepare(nxt.head(CE_OVERLAP), resolver, valid_stays))
   358	        ext = pd.concat(blocks, ignore_index=True)
   359	        ext["_pos"] = np.arange(len(ext))
   360	        yield ext, lo, hi
   361	        prev_tail = cur.tail(CE_OVERLAP)
   362	        cur = nxt
   363	        nxt = next(gen, None)
