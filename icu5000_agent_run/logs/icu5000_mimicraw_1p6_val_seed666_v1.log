   281	    for (s, st_), grp in tmp.groupby(["stay", "store"], sort=False):
   282	        vals = [v for v in grp["ct"].tolist() if v is not None and v != ""]
   283	        if vals:
   284	            grp_mode[(s, st_)] = Counter(vals).most_common(1)[0][0]
   285	    fixed = cts.copy()
