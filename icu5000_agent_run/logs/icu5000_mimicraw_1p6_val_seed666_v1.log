ue\"])[\"vote\"]}\n        mapped = []\n        for k in keys:\n            m = modes.get(k)\n            if m is None:\n                mapped.append(np.nan)\n                continue\n            if m == \"E\":\n                mapped.append(np.nan)\n                continue\n            v = float(m[1:])\n            vals = set()\n            for x in votes.get(k, ()):\n                if x.startswith(\"N\"):\n                    vals.add(float(x[1:]))\n            if v != 0 and (v / 100.0) in vals:\n                v = v / 100.0\n            mapped.append(v)\n        mapped = pd.Series(mapped, index=sub.index).fillna(vn.loc[txt_idx])\n        out.loc[txt_idx] = mapped\n    return out"}
