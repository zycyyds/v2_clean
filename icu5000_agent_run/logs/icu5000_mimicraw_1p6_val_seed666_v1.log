{"file_path": "/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_1p6_val_seed666_v1/agent_workdir/work/scripts/oe_rules2.py", "content": "\"\"\"Benchmark the chart time rules for the output events with an order independent\nmatching: the candidate chart time of a raw row is counted as correct when it is one\nof the reference chart times of the rows with the same (subject, stay, itemid, value)\nkey (the reference rows are sorted differently, so a positional match is not valid).\"\"\"\nimport pandas as pd, numpy as np\nfrom collections import defaultdict, Counter\n\nRAW = \"/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_16/train/raw\"\nREF = \"/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_16/train/reference\"\nraw = pd.read_csv(f\"{RAW}/icu/outputevents.csv\", dtype=str, keep_default_na=False)\nref = pd.read_csv(f\"{REF}/icu/outputevents.csv\", dtype=str, keep_default_na=False)\n\n\ndef nv(x):\n    try:\n        return repr(float(x))\n    except (TypeError, ValueError):\n        return x\n\n\ngold = defaultdict(list)\nfor _, x in ref.iterrows():\n    gold[(x.subject_id, x.stay_id, x.itemid, nv(x.value))].append(x.charttime)\n\nraw = raw.reset_index(drop=True)\nraw[\"key\"] = list(zip(raw.subject_id, raw.stay_id, raw.itemid, raw.value.map(nv)))\ngoldset = {k: set(v) for k, v in gold.items()}\nstore = pd.to_datetime(raw.storetime, errors=\"coerce\")\n\n# neighbours in the raw file order (the raw file is ordered by subject/stay/itemid/charttime)\nprev_ct = [None] * len(raw)\nnext_ct = [None] * len(raw)\nfor (s, st), g in raw.groupby([\"subject_id\", \"stay_id\"], sort=False):\n    idx = g.index.tolist()\n    vals = g.charttime.tolist()\n    n = len(idx)\n    for a in range(n):\n        p = q = None\n        for b in range(a - 1, -1, -1):\n            p = vals[b]\n            break\n        for b in range(a + 1, n):\n            q = vals[b]\n            break\n        prev_ct[idx[a]] = p\n        next_ct[idx[a]] = q\n\nhits = Counter()\nfor i, r in raw.iterrows():\n    ks = goldset.get(r[\"key\"])\n    if not ks:\n        continue\n    hits[\"total\"] += 1\n    st = store.iloc[i]\n    hits[\"floor_store\"] += (st.floor(\"h\").strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n    hits[\"floor_store_m15\"] += ((st - pd.Timedelta(minutes=15)).floor(\"h\").strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n    hits[\"floor_store_p15\"] += ((st + pd.Timedelta(minutes=15)).floor(\"h\").strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n    hits[\"round_store\"] += (st.round(\"h\").strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n    hits[\"as_is\"] += (st.strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n    p, q = prev_ct[i], next_ct[i]\n    if p is not None:\n        hits[\"prev\"] += (p in ks)\n    if q is not None:\n        hits[\"next\"] += (q in ks)\n    if p is not None and q is not None:\n        cur = p if (len(p) >= 16 and p[14:16] == \"00\") else q\n        hits[\"current\"] += (cur in ks)\n        hits[\"p_eq_q\"] += (p in ks and p == q)\n        mid = (pd.Timestamp(p) + (pd.Timestamp(q) - pd.Timestamp(p)) / 2).strftime(\"%Y-%m-%d %H:%M:%S\")\n        hits[\"mid\"] += (mid in ks)\n        # the hour boundaries inside the interval\n        lo, hi = pd.Timestamp(p), pd.Timestamp(q)\n        hs = []\n        h = lo.floor(\"h\")\n        while h <= hi:\n            hs.append(h)\n            h += pd.Timedelta(hours=1)\n        if hs:\n            hits[\"hour_first\"] += (hs[0].strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n            hits[\"hour_last\"] += (hs[-1].strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\n            for d in (0, 900, 1800, 2700):\n                tgt = st - pd.Timedelta(seconds=d)\n                best = min(hs, key=lambda x: abs((x - tgt).total_seconds()))\n                hits[\"hour_closest_d%d\" % d] += (best.strftime(\"%Y-%m-%d %H:%M:%S\") in ks)\nfor k, v in hits.most_common():\n    print(\"  %-18s %4d (%.4f)\" % (k, v, v / max(hits[\"total\"], 1)))\n"}
