{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_1p6_val_seed666_v1/agent_workdir/work/scripts/icu5000_pipeline.py","content":"\"\"\"\nICU5000 cleaning pipeline  (replayable)\n\nUsage:\n    python3 icu5000_pipeline.py --raw_root {raw_root} --output_dir {output_dir} [--workdir {workdir}]\n\nThe pipeline reads ONLY the raw MIMIC-IV slice (raw/hosp, raw/icu, raw/ecg, raw/note),\nrepairs the injected errors, and writes the 13-csv result package + submission.json.\n\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter\n\nimport numpy as np\nimport pandas as pd\n\n# ----------------------------------------------------------------------------\n# constants / rule configuration\n# ----------------------------------------------------------------------------\nALIAS_RE = re.compile(r\"^992[23]\\d{4}$\")          # CareVue/MetaVision itemid alias\nSTAY_ALIAS_RE = re.compile(r\"^9(\\d{8})$\")           # stay_id prefixed with '9'\nICD_ALIAS_PREFIX = \"ALIAS_\"                        # icd_code prefixed with 'ALIAS_'\n\n# physiologically impossible ranges (MIMIC native errors) -- itemid -> (lo, hi)\nIMPOSSIBLE_RANGES = {\n    220045: (20, 300), 220050: (40, 400), 220051: (20, 250), 220052: (20, 250),\n    220059: (0, 150), 220061: (0, 100), 220074: (-20, 80), 220179: (40, 400),\n    220180: (20, 250), 220181: (20, 250), 220210: (0, 100), 223762: (25, 45),\n    224688: (0, 100), 224689: (0, 100), 224690: (0, 100), 227466: (8, 200),\n    224167: (40, 400), 224643: (20, 250), 227242: (20, 250), 227243: (40, 400),\n}\n# MIMIC/CareVue \"value not taken\" placeholder codes\nSENTINEL_CODES = {-999, -998, -997, -990, 9999, 99999, 999999, 9999999,\n                   220000, 220045, -888, -1000}\n# sentinel codes used for injected chart values (chart rows)\nCHART_SENTINELS = {-999, -998, -997, -990, -888, -1000, 9999, 99999, 999999,\n                    9999999, 220000, 220045}\n# rows inserted by the label-leakage injector\nLEAK_ITEMID = \"999001\"\n\nMIN_ICU_LOS_DAYS = 1.0        # ICU stay must last >= 24h to enter the cohort\nECG_WAVEFORM_ROOT = (\"/mnt/GPU_10T/data/yjk/MedWM/data/\"\n                      \"mimic-iv-ecg-diagnostic-electrocardiogram-matched-subset-1.0\")\n\nOUTPUT_FILES = [\n    \"admissions.csv\", \"cohort.csv\", \"demographics.csv\", \"diagnoses.csv\",\n    \"procedures.csv\", \"medications.csv\", \"labs.csv\",\n    \"icu/icustays.csv\", \"icu/chartevents.csv\", \"icu/inputevents.csv\",\n    \"icu/outputevents.csv\",\n    \"multimodal/ecg_manifest.csv\", \"multimodal/ecg_measurements.csv\",\n]\n\n\n# ----------------------------------------------------------------------------\n# helpers\n# ----------------------------------------------------------------------------\ndef read_csv(path):\n    return pd.read_csv(path, dtype=str, keep_default_na=False)\n\n\ndef to_num(s):\n    \"\"\"Vectorised float parse (NaN when not numeric).\"\"\"\n    return pd.to_numeric(s, errors=\"coerce\")\n\n\ndef fmt_float(v):\n    \"\"\"Format a float the way pandas writes it (e.g. 19.0 / 148.5 / '' for NaN).\"\"\"\n    if v is None or (isinstance(v, float) and np.isnan(v)):\n        return \"\"\n    return repr(float(v))\n\n\ndef write_table(df, path, float_cols=()):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    out = df.copy()\n    for c in float_cols:\n        out[c] = out[c].map(fmt_float)\n    out.to_csv(path, index=False)\n\n\n# ----------------------------------------------------------------------------\n# itemid / id alias repair\n# ----------------------------------------------------------------------------\nclass ItemIdResolver:\n    \"\"\"Resolve injected itemid aliases of the form 992{2|3}XXXX back to the\n    original MIMIC itemid.\n\n    The injected alias keeps only the last four digits of the original id, so the\n    original is recovered by looking the 4-digit suffix up in the set of itemids\n    that are actually present (un-aliased) in the raw slice.\n    \"\"\"\n\n    def __init__(self, known_itemids):\n        self.known = set(str(k) for k in known_itemids if str(k) != LEAK_ITEMID)\n        self.by_suffix = {}\n        for k in self.known:\n            if len(k) >= 4:\n                self.by_suffix.setdefault(k[-4:], []).append(k)\n        self.cache = {}\n\n    def resolve(self, alias):\n        if alias in self.cache:\n            return self.cache[alias]\n        suffix = alias[4:]\n        cands = self.by_suffix.get(suffix, [])\n        out = alias\n        if len(cands) == 1:\n            out = cands[0]\n        elif cands:\n            # prefer the MetaVision style 6 digit id (\"22xxxx\"), then 5 digit CV ids\n            pref = [c for c in cands if c.startswith(\"22\")]\n            if len(pref) == 1:\n                out = pref[0]\n            else:\n                pref5 = [c for c in cands if len(c) == 5]\n                out = pref5[0] if len(pref5) == 1 else sorted(cands, key=len)[0]\n        else:\n            out = \"22\" + suffix\n        self.cache[alias] = out\n        return out\n\n    def map(self, series):\n        m = series.map(lambda s: self.resolve(s) if ALIAS_RE.match(str(s)) else s)\n        return m\n\n\ndef repair_stay_ids(df, valid_stays):\n    \"\"\"stay_id prefixed with '9' -> strip the prefix.\"\"\"\n    st = df[\"stay_id\"].astype(str)\n    bad = st.str.match(STAY_ALIAS_RE) & ~st.isin(valid_stays)\n    df = df.copy()\n    df.loc[bad, \"stay_id\"] = st[bad].str[1:]\n    return df\n\n\n# ----------------------------------------------------------------------------\n# main pipeline\n# ----------------------------------------------------------------------------\ndef run(raw_root, output_dir, verbose=True):\n    os.makedirs(output_dir, exist_ok=True)\n    R = lambda *p: os.path.join(raw_root, *p)\n\n    hosp = lambda n: read_csv(R(\"hosp\", n + \".csv\"))\n    icu = lambda n: read_csv(R(\"icu\", n + \".csv\"))\n    ecg = lambda n: read_csv(R(\"ecg\", n + \".csv\"))\n    notes = lambda n: read_csv(R(\"note\", n + \".csv\")) if os.path.exists(R(\"note\", n + \".csv\")) else None\n\n    log = {}\n\n    # ------------------------------------------------------------------\n    # 1. icustays : repair outtime (was shifted before intime) and recompute los\n    # ------------------------------------------------------------------\n    icu_stays = icu(\"icustays\")\n    intime = pd.to_datetime(icu_stays[\"intime\"], errors=\"coerce\")\n    los_raw = to_num(icu_stays[\"los\"])\n    outtime = intime + pd.to_timedelta((los_raw * 86400).round().astype(\"Int64\"), unit=\"s\")\n    icu_stays[\"intime\"] = intime.dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n    icu_stays[\"outtime\"] = outtime.dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n    dur_s = (outtime - intime).dt.total_seconds()\n    icu_stays[\"los\"] = (dur_s / 86400.0)\n    valid_stays = set(icu_stays[\"stay_id\"])\n    stay_hadm = icu_stays.set_index(\"stay_id\")[\"hadm_id\"].to_dict()\n    stay_intime = icu_stays.set_index(\"stay_id\")[\"intime\"].to_dict()\n    stay_outtime = icu_stays.set_index(\"stay_id\")[\"outtime\"].to_dict()\n    log[\"icustays\"] = len(icu_stays)\n\n    write_table(icu_stays[[\"subject_id\", \"hadm_id\", \"stay_id\", \"intime\", \"outtime\", \"los\"]],\n                os.path.join(output_dir, \"icu\", \"icustays.csv\"), float_cols=(\"los\",))\n\n    # ------------------------------------------------------------------\n    # 2. admissions : hospital_expire_flag was inverted, insurance blanked\n    # ------------------------------------------------------------------\n    adm = hosp(\"admissions\")\n    adm[\"hospital_expire_flag\"] = np.where(adm[\"deathtime\"].astype(str).str.strip() != \"\",\n                                            \"1\", \"0\")\n    if \"insurance\" in adm.columns:\n        adm[\"insurance\"] = adm[\"insurance\"].replace(\"\", np.nan)\n        adm[\"insurance\"] = adm[\"insurance\"].fillna(\"Medicare\")   # MIMIC dominant value\n    log[\"admissions_raw_rows\"] = len(adm)\n\n    # ------------------------------------------------------------------\n    # 3. cohort : ICU stays that have an admission record and lasted >= 24h\n    # ------------------------------------------------------------------\n    adm_keys = set(zip(adm[\"subject_id\"], adm[\"hadm_id\"]))\n    stays = icu_stays.copy()\n    stays[\"_dur_h\"] = dur_s / 3600.0\n    cohort_stays = stays[[(s, h) in adm_keys for s, h in zip(stays[\"subject_id\"], stays[\"hadm_id\"])]\n                          & (stays[\"_dur_h\"] >= MIN_ICU_LOS_DAYS * 24.0)]\n    cohort_hadm = set(cohort_stays[\"hadm_id\"])\n    cohort_subj = set(cohort_stays[\"subject_id\"])\n    log[\"cohort_stays\"] = len(cohort_stays)\n\n    adm_c = adm[adm[\"hadm_id\"].isin(cohort_hadm)].copy()\n    adm_c = adm_c.sort_values([\"subject_id\", \"hadm_id\"])\n    write_table(adm_c[[\"subject_id\", \"hadm_id\", \"admittime\", \"dischtime\", \"deathtime\",\n                        \"admission_type\", \"admission_location\", \"discharge_location\",\n                        \"insurance\", \"language\", \"marital_status\", \"race\",\n                        \"hospital_expire_flag\"]],\n                os.path.join(output_dir, \"admissions.csv\"))\n\n    adm_flag = adm.set_index(\"hadm_id\")[\"hospital_expire_flag\"].to_dict()\n    coh = cohort_stays.sort_values([\"subject_id\", \"hadm_id\"])[[\"subject_id\", \"hadm_id\"]].copy()\n    coh[\"cohort_type\"] = \"icu\"\n    coh[\"cohort_label\"] = \"ICU\"\n    coh[\"hospital_expire_flag\"] = coh[\"hadm_id\"].map(adm_flag).fillna(\"0\")\n    write_table(coh, os.path.join(output_dir, \"cohort.csv\"))\n\n    # ------------------------------------------------------------------\n    # 4. demographics : patients table (gender / anchor_age were blanked out)\n    # ------------------------------------------------------------------\n    pat = hosp(\"patients\")\n    pat[\"gender\"] = pat[\"gender\"].replace({\"UNKNOWN_GENDER_CODE\": \"\"})\n    gender_map = gender_from_notes(R)\n    pat[\"gender\"] = [gender_map.get(s, g) if g == \"\" else g\n                     for s, g in zip(pat[\"subject_id\"], pat[\"gender\"])]\n    pat[\"anchor_age\"] = to_num(pat[\"anchor_age\"])\n    valid_age = pat[\"anchor_age\"].where(pat[\"anchor_age\"].between(0, 120))\n    age_prior = valid_age.median()\n    age_prior = 60.0 if pd.isna(age_prior) else float(age_prior)\n    pat[\"anchor_age\"] = valid_age.fillna(age_prior)\n    pat = pat.set_index(\"subject_id\")\n    demo_rows = []\n    for s in sorted(cohort_subj):\n        if s in pat.index:\n            r = pat.loc[s]\n            demo_rows.append([s, r[\"gender\"] or \"M\", r[\"anchor_age\"], r[\"anchor_year\"],\n                              r[\"anchor_year_group\"], r[\"dod\"]])\n        else:\n            demo_rows.append([s, \"M\", age_prior, \"\", \"\", \"\"])\n    demo = pd.DataFrame(demo_rows, columns=[\"subject_id\", \"gender\", \"anchor_age\",\n                                            \"anchor_year\", \"anchor_year_group\", \"dod\"])\n    write_table(demo, os.path.join(output_dir, \"demographics.csv\"), float_cols=(\"anchor_age\",))\n\n    # ------------------------------------------------------------------\n    # 5. diagnoses / procedures : strip injected ALIAS_ prefix, keep cohort\n    # ------------------------------------------------------------------\n    diag = hosp(\"diagnoses_icd\")\n    diag[\"icd_code\"] = diag[\"icd_code\"].str.replace(ICD_ALIAS_PREFIX, \"\", regex=False)\n    diag = diag[diag[\"hadm_id\"].isin(cohort_hadm)]\n    write_table(diag[[\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\", \"icd_version\"]],\n                os.path.join(output_dir, \"diagnoses.csv\"))\n\n    proc = hosp(\"procedures_icd\")\n    proc[\"icd_code\"] = proc[\"icd_code\"].str.replace(ICD_ALIAS_PREFIX, \"\", regex=False)\n    proc = proc[proc[\"hadm_id\"].isin(cohort_hadm)]\n    write_table(proc[[\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\", \"icd_version\"]],\n                os.path.join(output_dir, \"procedures.csv\"))\n\n    # ------------------------------------------------------------------\n    # 6. medications : prescriptions for the cohort\n    # ------------------------------------------------------------------\n    rx = hosp(\"prescriptions\")\n    rx = rx[rx[\"hadm_id\"].isin(cohort_hadm)]\n    write_table(rx[[\"subject_id\", \"hadm_id\", \"starttime\", \"stoptime\", \"drug\",\n                    \"dose_val_rx\", \"dose_unit_rx\", \"route\"]],\n                os.path.join(output_dir, \"medications.csv\"))\n\n    # ------------------------------------------------------------------\n    # 7. labs : labevents for the cohort, 'N/A' units -> empty\n    # ------------------------------------------------------------------\n    lab = hosp(\"labevents\")\n    lab = lab[lab[\"hadm_id\"].isin(cohort_hadm)].copy()\n    lab[\"valueuom\"] = lab[\"valueuom\"].replace({\"N/A\": \"\"})\n    write_table(lab[[\"subject_id\", \"hadm_id\", \"itemid\", \"charttime\", \"valuenum\", \"valueuom\"]],\n                os.path.join(output_dir, \"labs.csv\"), float_cols=(\"valuenum\",))\n\n    # ------------------------------------------------------------------\n    # 8. chartevents\n    # ------------------------------------------------------------------\n    ce = icu(\"chartevents\")\n    n_raw_ce = len(ce)\n    ce = ce[ce[\"itemid\"] != LEAK_ITEMID].copy()          # label leakage rows\n    n_leak = n_raw_ce - len(ce)\n    ce = repair_stay_ids(ce, valid_stays)\n    resolver = ItemIdResolver(set(ce[\"itemid\"]) | set(icu(\"inputevents\")[\"itemid\"])\n                              | set(icu(\"outputevents\")[\"itemid\"]))\n    ce[\"itemid\"] = resolver.map(ce[\"itemid\"])\n    n_alias = int((ce[\"itemid\"] != ce[\"itemid\"]).sum())\n    ce = ce.sort_values([\"subject_id\", \"stay_id\", \"charttime\", \"itemid\"]).reset_index(drop=True)\n    # remove duplicated rows (keep first occurrence)\n    dup_cols = [\"subject_id\", \"hadm_id\", \"stay_id\", \"caregiver_id\", \"charttime\",\n                \"storetime\", \"itemid\", \"value\", \"valuenum\", \"valueuom\", \"warning\"]\n    ce = ce.drop_duplicates(subset=dup_cols, keep=\"first\").reset_index(drop=True)\n    n_dup = len(ce)\n    # repair charttime that was pushed outside the ICU stay window\n    ce = repair_chartevents_charttime(ce, stay_intime, stay_outtime)\n    # valuenum repair\n    ce[\"valuenum\"] = repair_chartevents_valuenum(ce)\n    # native MIMIC errors -> patient/item median (last step)\n    ce = fix_native_chartevents_errors(ce)\n    write_table(ce[[\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\",\n                     \"valuenum\", \"valueuom\"]],\n                os.path.join(output_dir, \"icu\", \"chartevents.csv\"), float_cols=(\"valuenum\",))\n    log[\"chartevents\"] = dict(raw=n_raw_ce, leak=n_leak, after_dedup=n_dup,\n                               out=len(ce))\n\n    # ------------------------------------------------------------------\n    # 9. inputevents\n    # ------------------------------------------------------------------\n    ie = icu(\"inputevents\")\n    ie = repair_stay_ids(ie, valid_stays)\n    ie[\"itemid\"] = resolver.map(ie[\"itemid\"])\n    ie[\"hadm_id\"] = ie[\"stay_id\"].map(stay_hadm)\n    ing = icu(\"ingredientevents\")\n    ing = repair_stay_ids(ing, valid_stays)\n    ing[\"itemid\"] = resolver.map(ing[\"itemid\"])\n    ing[\"k\"] = ing[\"subject_id\"] + \"|\" + ing[\"stay_id\"] + \"|\" + ing[\"starttime\"]\n    end_map = ing.groupby(\"k\")[\"endtime\"].agg(lambda s: Counter(s).most_common(1)[0][0]).to_dict()\n    ie[\"k\"] = ie[\"subject_id\"] + \"|\" + ie[\"stay_id\"] + \"|\" + ie[\"starttime\"]\n    recovered = ie[\"k\"].map(end_map)\n    st_t = pd.to_datetime(ie[\"starttime\"], errors=\"coerce\")\n    bad_end = pd.to_datetime(ie[\"endtime\"], errors=\"coerce\") < st_t\n    ie.loc[bad_end, \"endtime\"] = recovered[bad_end]\n    # amount: sentinel injection -> use rate * duration, else original amount\n    amount = to_num(ie[\"amount\"])\n    rate = to_num(ie[\"rate\"])\n    orate = to_num(ie[\"originalrate\"])\n    oamt = to_num(ie[\"originalamount\"])\n    tamt = to_num(ie[\"totalamount\"])\n    dur_h = (pd.to_datetime(ie[\"endtime\"], errors=\"coerce\") - st_t).dt.total_seconds() / 3600.0\n    calc = rate * dur_h\n    calc = calc.where(np.isfinite(calc))\n    fallback = oamt.where(oamt.notna(), tamt)\n    new_amount = calc.where(calc.notna(), fallback)\n    amount_fixed = amount.copy()\n    sentinel_amt = amount.isin([-999, -998, -997, -990, -888, -1000, 9999, 99999,\n                                999999, 9999999])\n    amount_fixed[sentinel_amt] = new_amount[sentinel_amt]\n    ie[\"amount\"] = amount_fixed\n    write_table(ie[[\"subject_id\", \"hadm_id\", \"stay_id\", \"starttime\", \"endtime\",\n                     \"itemid\", \"amount\"]],\n                os.path.join(output_dir, \"icu\", \"inputevents.csv\"), float_cols=(\"amount\",))\n\n    # ------------------------------------------------------------------\n    # 10. outputevents : charttime was zeroed to the epoch\n    # ------------------------------------------------------------------\n    oe = icu(\"outputevents\")\n    oe = repair_stay_ids(oe, valid_stays)\n    oe[\"hadm_id\"] = oe[\"stay_id\"].map(stay_hadm)\n    st_o = pd.to_datetime(oe[\"storetime\"], errors=\"coerce\")\n    epoch = oe[\"charttime\"].astype(str).str.startswith(\"1970-01-01\")\n    oe.loc[epoch, \"charttime\"] = st_o[epoch].dt.floor(\"h\").dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n    write_table(oe[[\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\", \"value\"]],\n                os.path.join(output_dir, \"icu\", \"outputevents.csv\"), float_cols=(\"value\",))\n\n    # ------------------------------------------------------------------\n    # 11. ECG manifest / measurements\n    # ------------------------------------------------------------------\n    rl = ecg(\"record_list\")\n    rl = rl.merge(icu_stays[[\"subject_id\", \"hadm_id\", \"stay_id\", \"intime\", \"outtime\"]],\n                  on=\"subject_id\", how=\"inner\")\n    rlt = pd.to_datetime(rl[\"ecg_time\"], errors=\"coerce\")\n    it = pd.to_datetime(rl[\"intime\"], errors=\"coerce\")\n    ot = pd.to_datetime(rl[\"outtime\"], errors=\"coerce\")\n    keep = (rlt >= it) & (rlt <= ot)\n    rl = rl[keep].copy()\n    rl[\"waveform_path\"] = ECG_WAVEFORM_ROOT + \"/\" + rl[\"path\"]\n    rl[\"hea_exists\"] = False\n    rl[\"dat_exists\"] = False\n    write_table(rl[[\"subject_id\", \"study_id\", \"file_name\", \"ecg_time\", \"path\", \"hadm_id\",\n                     \"stay_id\", \"intime\", \"outtime\", \"waveform_path\", \"hea_exists\",\n                     \"dat_exists\"]],\n                os.path.join(output_dir, \"multimodal\", \"ecg_manifest.csv\"))\n\n    mm = ecg(\"machine_measurements\")\n    mm = mm.merge(rl[[\"subject_id\", \"study_id\", \"hadm_id\", \"stay_id\"]].drop_duplicates(),\n                  on=[\"subject_id\", \"study_id\"], how=\"inner\")\n    mcols = list(rl.columns[:0]) or None\n    mm = mm[[c for c in mm.columns]]\n    write_table(mm, os.path.join(output_dir, \"multimodal\", \"ecg_measurements.csv\"))\n\n    if verbose:\n        for k, v in log.items():\n            print(\"[icu5000]\", k, v)\n    return log\n\n\n# ----------------------------------------------------------------------------\n# chartevents helpers\n# ----------------------------------------------------------------------------\ndef repair_chartevents_charttime(ce, stay_intime, stay_outtime):\n    \"\"\"Rows whose charttime was pushed to (outtime + 1 day) are put back using the\n    charttime of the neighbouring rows in the (charttime sorted) file order.\"\"\"\n    ct = pd.to_datetime(ce[\"charttime\"], errors=\"coerce\")\n    it = pd.to_datetime(ce[\"stay_id\"].map(stay_intime), errors=\"coerce\")\n    ot = pd.to_datetime(ce[\"stay_id\"].map(stay_outtime), errors=\"coerce\")\n    bad = (ct > ot) | (ct < it)\n    if not bad.any():\n        return ce\n    idx = np.where(bad.values)[0]\n    stay = ce[\"stay_id\"].values\n    cts = ce[\"charttime\"].values\n    n = len(ce)\n    prev_ct = np.empty(n, dtype=object)\n    next_ct = np.empty(n, dtype=object)\n    # nearest preceding / following non-corrupted row of the same stay\n    last = {}\n    for i in range(n):\n        if not bad.values[i]:\n            last[stay[i]] = cts[i]\n        prev_ct[i] = last.get(stay[i])\n    last = {}\n    for i in range(n - 1, -1, -1):\n        if not bad.values[i]:\n            last[stay[i]] = cts[i]\n        next_ct[i] = last.get(stay[i])\n    # mode of the charttime of rows sharing the same storetime (same stay)\n    grp_mode = {}\n    tmp = ce.copy()\n    tmp[\"charttime\"] = np.where(bad.values, None, tmp[\"charttime\"])\n    for (s, st_), grp in tmp.groupby([\"stay_id\", \"storetime\"], dropna=False):\n        vals = [v for v in grp[\"charttime\"].tolist() if v is not None and v != \"\"]\n        if vals:\n            grp_mode[(s, st_)] = Counter(vals).most_common(1)[0][0]\n    fixed = ce[\"charttime\"].copy()\n    for i in idx:\n        p, q = prev_ct[i], next_ct[i]\n        m = grp_mode.get((stay[i], ce[\"storetime\"].values[i]))\n        if p is not None and p == q:\n            cand = p\n        elif m is not None and m in (p, q):\n            cand = m\n        else:\n            cand = q if q is not None else (p if p is not None else m)\n        if cand is None:\n            cand = p if p is not None else q\n        fixed.iloc[i] = cand\n    ce[\"charttime\"] = fixed\n    return ce\n\n\ndef repair_chartevents_valuenum(ce):\n    \"\"\"valuenum repair:\n       * numeric `value` text  -> valuenum = float(value)   (kills x100 scale errors\n         and sentinel injections)\n       * textual `value`       -> valuenum = the enum code that is observed for the\n         same (itemid, value) elsewhere in the table.\n    \"\"\"\n    val = ce[\"value\"].astype(str)\n    vn = to_num(ce[\"valuenum\"])\n    num_val = to_num(val)\n    is_num = num_val.notna()\n    out = vn.copy()\n    out[is_num] = num_val[is_num]\n    # enum codes for textual rows: modal valuenum per (itemid, value)\n    txt = ce[~is_num]\n    if len(txt):\n        clean = txt[\"valuenum\"].map(lambda s: to_num(pd.Series([s])).iloc[0])\n        good = clean.where(~clean.isin(CHART_SENTINELS))\n        modes = good.groupby([txt[\"itemid\"], txt[\"value\"]]).agg(\n            lambda s: Counter([x for x in s.dropna()]).most_common(1)[0][0]\n            if len([x for x in s.dropna()]) else np.nan)\n        key = list(zip(txt[\"itemid\"], txt[\"value\"]))\n        mapped = pd.Series([modes.get(k, np.nan) for k in key], index=txt.index)\n        out.loc[txt.index] = mapped\n    return out\n\n\ndef fix_native_chartevents_errors(ce):\n    \"\"\"MIMIC native recording errors in chartevents.valuenum:\n         * value outside the physiological range for that item (and != 0), or\n         * value equal to one of the MIMIC placeholder codes, and\n         * value == the textual `value` column (=> no textual hint available), and\n         * deviation from the patient/item median >= 20%, and\n         * the patient/item has at least one usable reading.\n       They are replaced by the median of the usable readings of the same\n       (subject_id, itemid) in the cleaned table.\n    \"\"\"\n    vn = to_num(ce[\"valuenum\"]).astype(float)\n    val_num = to_num(ce[\"value\"].astype(str))\n    item = to_num(ce[\"itemid\"])\n    lo = item.map(lambda i: IMPOSSIBLE_RANGES.get(int(i), (np.nan, np.nan))[0] if pd.notna(i) else np.nan)\n    hi = item.map(lambda i: IMPOSSIBLE_RANGES.get(int(i), (np.nan, np.nan))[1] if pd.notna(i) else np.nan)\n    out_of_range = (vn.notna()) & (((vn < lo) | (vn > hi)) & (vn != 0) & lo.notna())\n    is_sentinel = vn.isin(SENTINEL_CODES)\n    candidate = out_of_range | is_sentinel\n    # require that the textual value column equals the (bad) valuenum -> no hint\n    no_hint = np.isclose(vn.fillna(-1e18), val_num.fillna(-1e18)) | val_num.isna()\n    cand = candidate & no_hint\n    if not cand.any():\n        return ce\n    subj = ce[\"subject_id\"]\n    med_all = vn.groupby([subj, item]).transform(\"median\")\n    # usable readings for the median pool\n    usable = vn.copy()\n    ok_in_range = (vn >= lo) & (vn <= hi) & (vn != 0) & lo.notna()\n    ok_not_sentinel = (~vn.isin(SENTINEL_CODES)) & (vn != 0)\n    usable_pool = pd.Series(np.where(ok_in_range, vn, np.where(ok_not_sentinel, vn, np.nan)),\n                             index=ce.index)\n    med_pool = usable_pool.groupby([subj, item]).transform(\"median\")\n    has_pool = usable_pool.groupby([subj, item]).transform(\"count\") > 0\n    med_pool_all = vn.groupby([subj, item]).transform(\"median\")\n    dev = (vn - med_pool).abs() / med_pool.replace(0, np.nan)\n    big_dev = (dev >= 0.20) | med_pool.isna()\n    fixable = cand & has_pool & big_dev\n    out = vn.copy()\n    out[fixable] = med_pool[fixable]\n    ce = ce.copy()\n    ce[\"valuenum\"] = out\n    return ce\n\n\n# ----------------------------------------------------------------------------\n# gender recovery from the (clean) note text\n# ----------------------------------------------------------------------------\ndef gender_from_notes(raw_root):\n    \"\"\"discharge summaries contain a structured 'Sex: M|F' field.\"\"\"\n    out = {}\n    p = os.path.join(raw_root, \"note\", \"discharge.csv\")\n    if not os.path.exists(p):\n        return out\n    d = read_csv(p)\n    for _, r in d.iterrows():\n        m = re.search(r\"Sex:\\s*([MF])\\b\", str(r.get(\"text\", \"\")))\n        if m:\n            out.setdefault(r[\"subject_id\"], m.group(1))\n    return out\n\n\n# ----------------------------------------------------------------------------\ndef main(argv=None):\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--raw_root\", required=True)\n    ap.add_argument(\"--output_dir\", required=True)\n    ap.add_argument(\"--workdir\", default=None)\n    ap.add_argument(\"--train_reference\", default=None)\n    args = ap.parse_args(argv)\n    run(args.raw_root, args.output_dir)\n    return 0\n\n\nif __name__ == \"__main__\":\n    sys.exit(main())\n"}
