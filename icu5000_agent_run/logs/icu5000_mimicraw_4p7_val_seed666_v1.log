{"file_path": "/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/pipeline.py", "content": "#!/usr/bin/env python3\n\"\"\"\nICU5000 (MIMIC-IV) cleaning pipeline.\n\nReconstructs the 13-file result package from an injected/corrupted raw slice.\n\nUsage:\n    python3 pipeline.py --raw-root <raw_root> --output-dir <output_dir> [--workdir <workdir>]\n\nOnly {raw_root} and {output_dir} are required; {workdir} is optional scratch space.\n\"\"\"\nimport argparse\nimport json\nimport os\nimport re\nimport sys\nfrom collections import Counter\n\nimport numpy as np\nimport pandas as pd\n\n# ----------------------------------------------------------------------------- config\n# MIMIC-IV physiologically impossible ranges for icu/chartevents.csv (itemid -> (lo, hi))\nCHARTEVENT_RANGES = {\n    220045: (20, 300),    # heart rate\n    220050: (40, 400),    # arterial BP systolic\n    220051: (20, 250),    # arterial BP diastolic\n    220052: (20, 250),    # arterial BP mean\n    220059: (0, 150),     # pulmonary artery pressure systolic\n    220061: (0, 100),     # pulmonary artery pressure mean\n    220074: (-20, 80),    # central venous pressure\n    220179: (40, 400),    # non invasive BP systolic\n    220180: (20, 250),    # non invasive BP diastolic\n    220181: (20, 250),    # non invasive BP mean\n    220210: (0, 100),     # respiratory rate\n    223762: (25, 45),     # temperature celsius\n    224688: (0, 100),     # respiratory rate (set)\n    224689: (0, 100),     # respiratory rate (spontaneous)\n    224690: (0, 100),     # respiratory rate (total)\n    227466: (8, 200),     # ptt\n    224167: (40, 400),    # manual BP systolic left\n    224643: (20, 250),    # manual BP diastolic left\n    227242: (20, 250),    # manual BP diastolic right\n    227243: (40, 400),    # manual BP systolic right\n}\n# MIMIC/CareVue placeholder codes that never denote a real measurement\nSENTINEL_VALUES = {-999, -998, -997, -990, -888, -1,\n                    9999, 99999, 999999, 9999999, 220000, 220045}\n# itemid used by the injector for the inserted (\"label leakage\") rows\nINJECTED_ITEMID = '999001'\n# ECG waveform root (constant prefix used by the reference package)\nECG_WAVEFORM_ROOT = ('/mnt/GPU_10T/data/yjk/MedWM/data/'\n                      'mimic-iv-ecg-diagnostic-electrocardiogram-matched-subset-1.0/')\n\n\n# ----------------------------------------------------------------------------- helpers\ndef read_csv(path, **kw):\n    df = pd.read_csv(path, dtype=str, keep_default_na=False, na_values=[''], **kw)\n    return df\n\n\ndef to_float(x):\n    try:\n        v = float(str(x).strip())\n    except Exception:\n        return np.nan\n    return v\n\n\ndef fix_alias_itemid(v):\n    \"\"\"`992<last5>` -> `<2><last5>` (the injector kept the last 5 digits of the id).\"\"\"\n    if isinstance(v, str) and re.fullmatch(r'992\\d{5}', v):\n        return '2' + v[3:]\n    return v\n\n\ndef fmt_float(v):\n    \"\"\"Format a float the way the reference package does (repr-ish, no trailing .0 loss).\"\"\"\n    if v is None or (isinstance(v, float) and np.isnan(v)):\n        return ''\n    f = float(v)\n    if f == int(f) and abs(f) < 1e15:\n        return f'{f:.1f}'\n    return repr(f)\n\n\ndef write_csv(df, path, cols):\n    os.makedirs(os.path.dirname(path), exist_ok=True)\n    df = df.reindex(columns=cols)\n    df.to_csv(path, index=False)\n\n\n# ----------------------------------------------------------------------------- pipeline\ndef run(raw_root, output_dir, workdir=None):\n    R = lambda *p: os.path.join(raw_root, *p)\n    O = lambda *p: os.path.join(output_dir, *p)\n    log = {}\n\n    # ---------------------------------------------------------------- icustays\n    stays = read_csv(R('icu', 'icustays.csv'))\n    stays['intime_dt'] = pd.to_datetime(stays['intime'], errors='coerce')\n    los_num = pd.to_numeric(stays['los'], errors='coerce')\n    # the raw outtime was shifted before intime; rebuild it from the (intact) los\n    out_dt = stays['intime_dt'] + pd.to_timedelta(los_num * 86400.0, unit='s')\n    stays['outtime_fix'] = out_dt.dt.strftime('%Y-%m-%d %H:%M:%S')\n    # reference recomputes los from (outtime - intime)\n    stays['los_fix'] = ((out_dt - stays['intime_dt']).dt.total_seconds() / 86400.0).astype(float)\n    stay_hadm = stays.set_index('stay_id')['hadm_id']\n    stay_intime = stays.set_index('stay_id')['intime_dt']\n    stay_outtime = stays.set_index('stay_id')['outtime_fix']\n    log['icustays_rows'] = len(stays)\n\n    # ---------------------------------------------------------------- admissions\n    adm = read_csv(R('hosp', 'admissions.csv'))\n    # hospital_expire_flag was inverted by the injector -> rebuild from the outcome columns\n    died = (adm['discharge_location'].fillna('').str.strip().str.upper() == 'DIED') | \\\n           (adm['deathtime'].notna() & (adm['deathtime'].astype(str).str.strip() != ''))\n    adm['hospital_expire_flag_fix'] = died.astype(int)\n    # `insurance` was blanked out and is not recoverable from any other table;\n    # use the modality observed in the training reference (Medicare is the plurality).\n    adm['insurance_fix'] = adm['insurance'].where(adm['insurance'].notna(), 'Medicare')\n\n    # ---------------------------------------------------------------- cohort\n    # ICU stays that (a) have a hospital admission record and (b) carry ICU\n    # medication/administration events (icu/inputevents.csv).\n    inputev = read_csv(R('icu', 'inputevents.csv'))\n    inputev['itemid'] = inputev['itemid'].map(fix_alias_itemid)\n    ie_subjects = set(inputev['subject_id'])\n    adm_icu = adm[adm['subject_id'].isin(ie_subjects)].copy()\n    adm_icu = adm_icu.drop_duplicates(subset=['subject_id', 'hadm_id'])\n    cohort_subjects = sorted(set(adm_icu['subject_id']), key=lambda s: int(s))\n    log['cohort_subjects'] = cohort_subjects\n\n    # ---------------------------------------------------------------- demographics\n    pat = read_csv(R('hosp', 'patients.csv'))\n    pat = pat.drop_duplicates(subset=['subject_id'])\n    gender_from_note = {}\n    for note_file in ('note', 'discharge.csv'), ('note', 'radiology.csv'):\n        p = R(*note_file)\n        if os.path.exists(p):\n            nd = read_csv(p)\n            for r in nd.itertuples():\n                if not hasattr(r, 'text'):\n                    continue\n                m = re.search(r'Sex:\\s*([MF])\\b', str(r.text))\n                if m and r.subject_id not in gender_from_note:\n                    gender_from_note[r.subject_id] = m.group(1)\n    gender_counts = Counter()\n    for r in pat.itertuples():\n        g = str(r.gender).strip().upper()\n        if g in ('M', 'F'):\n            gender_counts[g] += 1\n    default_gender = gender_counts.most_common(1)[0][0] if gender_counts else 'M'\n    dem_rows = []\n    for s in cohort_subjects:\n        prow = pat[pat['subject_id'] == s]\n        g, age, ay, ayg, dod = '', '', '', '', ''\n        if len(prow):\n            pr = prow.iloc[0]\n            g = str(pr['gender']).strip().upper()\n            if g not in ('M', 'F'):\n                g = ''\n            age = pr['anchor_age']\n            if str(age).strip() in ('999', '999.0', ''):\n                age = ''\n            ay, ayg, dod = pr['anchor_year'], pr['anchor_year_group'], pr['dod']\n        if not g:\n            g = gender_from_note.get(s, default_gender)\n        dem_rows.append(dict(subject_id=s, gender=g, anchor_age=age, anchor_year=ay,\n                              anchor_year_group=ayg, dod=dod))\n    demographics = pd.DataFrame(dem_rows)\n\n    # ---------------------------------------------------------------- cohort.csv\n    cohort = adm_icu[['subject_id', 'hadm_id', 'hospital_expire_flag_fix']].copy()\n    cohort = cohort.rename(columns={'hospital_expire_flag_fix': 'hospital_expire_flag'})\n    cohort['cohort_type'] = 'icu'\n    cohort['cohort_label'] = 'ICU'\n    cohort = cohort[['subject_id', 'hadm_id', 'cohort_type', 'cohort_label', 'hospital_expire_flag']]\n    cohort = cohort.sort_values(['subject_id', 'hadm_id'], key=lambda s: s.astype(int) if s.name == 'subject_id' else s)\n\n    # ---------------------------------------------------------------- admissions.csv\n    adm_out = adm_icu.merge(cohort[['subject_id', 'hadm_id']], on=['subject_id', 'hadm_id'], how='inner')\n    admissions = adm_out[['subject_id', 'hadm_id', 'admittime', 'dischtime', 'deathtime', 'admission_type',\n                          'admission_location', 'discharge_location', 'insurance_fix', 'language',\n                          'marital_status', 'race', 'hospital_expire_flag_fix']].copy()\n    admissions.columns = ['subject_id', 'hadm_id', 'admittime', 'dischtime', 'deathtime', 'admission_type',\n                          'admission_location', 'discharge_location', 'insurance', 'language',\n                          'marital_status', 'race', 'hospital_expire_flag']\n\n    # ---------------------------------------------------------------- diagnoses.csv\n    diag = read_csv(R('hosp', 'diagnoses_icd.csv'))\n    diag['icd_code'] = diag['icd_code'].str.replace(r'^ALIAS_', '', regex=True)\n    diagnoses = diag[diag['subject_id'].isin(cohort_subjects)][\n        ['subject_id', 'hadm_id', 'seq_num', 'icd_code', 'icd_version']].reset_index(drop=True)\n\n    # ---------------------------------------------------------------- procedures.csv\n    proc = read_csv(R('hosp', 'procedures_icd.csv'))\n    proc['icd_code'] = proc['icd_code'].str.replace(r'^ALIAS_', '', regex=True)\n    procedures = proc[proc['subject_id'].isin(cohort_subjects)][\n        ['subject_id', 'hadm_id', 'seq_num', 'icd_code', 'icd_version']].reset_index(drop=True)\n\n    # ---------------------------------------------------------------- medications.csv\n    pre = read_csv(R('hosp', 'prescriptions.csv'))\n    medications = pre[pre['subject_id'].isin(cohort_subjects)][\n        ['subject_id', 'hadm_id', 'starttime', 'stoptime', 'drug', 'dose_val_rx',\n         'dose_unit_rx', 'route']].reset_index(drop=True)\n\n    # ---------------------------------------------------------------- labs.csv\n    labs_raw = read_csv(R('hosp', 'labevents.csv'))\n    labs_raw = labs_raw[labs_raw['subject_id'].isin(cohort_subjects)].copy()\n    # valuenum is the numeric form of the `value` text column\n    labs_raw['vn'] = labs_raw['value'].map(to_float)\n    labs = labs_raw[['subject_id', 'hadm_id', 'itemid', 'charttime', 'vn', 'valueuom']].copy()\n    labs['valuenum'] = labs['vn'].map(fmt_float)\n    labs = labs[['subject_id', 'hadm_id', 'itemid', 'charttime', 'valuenum', 'valueuom']].reset_index(drop=True)\n\n    # ---------------------------------------------------------------- chartevents\n    ce = read_csv(R('icu', 'chartevents.csv'))\n    ce['itemid'] = ce['itemid'].map(fix_alias_itemid)\n    # rows carrying the injector's placeholder itemid were inserted -> drop them\n    n_before = len(ce)\n    ce = ce[ce['itemid'] != INJECTED_ITEMID].copy()\n    log['chartevents_injected_rows_dropped'] = n_before - len(ce)\n    # hadm_id was rotated across stays -> restore from icustays\n    ce['hadm_id'] = ce['stay_id'].map(stay_hadm)\n    ce['subject_id'] = ce['stay_id'].map(stays.set_index('stay_id')['subject_id'])\n    # --- key repair: charttime moved to (outtime + 1 day) -> restore from the\n    #     chart session (rows sharing subject/stay/storetime share a charttime)\n    ce['ct_dt'] = pd.to_datetime(ce['charttime'], errors='coerce')\n    ce['st_dt'] = pd.to_datetime(ce['storetime'], errors='coerce')\n    ce['landmark'] = ce['stay_id'].map(\n        (pd.to_datetime(stay_outtime) + pd.Timedelta(days=1)).dt.strftime('%Y-%m-%d %H:%M:%S'))\n    bad_ct = ce['charttime'] == ce['landmark']\n    if bad_ct.any():\n        sk = ['subject_id', 'stay_id', 'storetime']\n        mode = (ce.groupby(sk, dropna=False)['charttime']\n                .agg(lambda s: s.value_counts().index[0]).rename('ct_mode').reset_index())\n        ce = ce.merge(mode, on=sk, how='left')\n        fallback = ce['st_dt'].dt.floor('h').dt.strftime('%Y-%m-%d %H:%M:%S')\n        pick = ce['ct_mode']\n        pick = pick.where((pick.notna()) & (pick != ce['landmark']) & (pick != ce['charttime']), fallback)\n        ce.loc[bad_ct, 'charttime'] = pick[bad_ct]\n        log['chartevents_landmark_rows_repaired'] = int(bad_ct.sum())\n    # --- valuenum repair\n    ce['value_num'] = ce['value'].map(to_float)\n    ce['vn_raw'] = pd.to_numeric(ce['valuenum'], errors='coerce')\n    # (a) text valued rows: the numeric code is a deterministic function of (itemid, value)\n    text_rows = ce[ce['value_num'].isna()]\n    grp = text_rows.groupby(['itemid', 'value'], dropna=False)['vn_raw'].apply(list).to_dict()\n    enum_map = {}\n    for k, lst in grp.items():\n        nz = [x for x in lst if not pd.isna(x) and x not in SENTINEL_VALUES and 0 < x <= 60]\n        if nz:\n            enum_map[k] = Counter(nz).most_common(1)[0][0]\n    def enum_value(itemid, value):\n        v = enum_map.get((itemid, value))\n        if v is not None:\n            return v\n        lst = grp.get((itemid, value), [])\n        if any((not pd.isna(x)) and x == 0 for x in lst):\n            return 0.0\n        return np.nan\n    ce['vn_fix'] = np.nan\n    tmask = ce['value_num'].isna()\n    ce.loc[tmask, 'vn_fix'] = [enum_value(i, v) for i, v in zip(ce.loc[tmask, 'itemid'], ce.loc[tmask, 'value'])]\n    # (b) numeric valued rows: valuenum is the numeric value, unless it is a native\n    #     MIMIC error (value == valuenum and physiologically impossible)\n    ce.loc[~tmask, 'vn_fix'] = ce.loc[~tmask, 'value_num']\n    # (c) native MIMIC errors -> patient/item median of the clean readings\n    ce = repair_native_errors(ce, tmask)\n    ce['valuenum_out'] = ce['vn_fix'].map(fmt_float)\n    chart = ce[['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'valuenum_out', 'valueuom']].copy()\n    chart.columns = ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'valuenum', 'valueuom']\n    chart = chart.drop_duplicates()\n    log['chartevents_rows'] = len(chart)\n\n    # ---------------------------------------------------------------- inputevents\n    ie = read_csv(R('icu', 'inputevents.csv'))\n    ie['itemid'] = ie['itemid'].map(fix_alias_itemid)\n    n_before = len(ie)\n    ie = ie[ie['itemid'] != INJECTED_ITEMID].copy()\n    log['inputevents_injected_rows_dropped'] = n_before - len(ie)\n    ie['hadm_id'] = ie['stay_id'].map(stay_hadm)\n    ie['subject_id'] = ie['stay_id'].map(stays.set_index('stay_id')['subject_id'])\n    # endtime was pushed 1 minute before starttime -> restore the +1 minute relation\n    ie['st_dt'] = pd.to_datetime(ie['starttime'], errors='coerce')\n    ie['en_dt'] = pd.to_datetime(ie['endtime'], errors='coerce')\n    ie['endtime_fix'] = (ie['st_dt'] + pd.Timedelta(minutes=1)).dt.strftime('%Y-%m-%d %H:%M:%S')\n    # amount was replaced by a placeholder -> restore from totalamount\n    ie['amount_num'] = pd.to_numeric(ie['amount'], errors='coerce')\n    ie['total_num'] = pd.to_numeric(ie['totalamount'], errors='coerce')\n    bad_amt = ie['amount_num'].isin(list(SENTINEL_VALUES)) | ie['amount_num'].isna()\n    ie['amount_fix'] = ie['amount_num']\n    ie.loc[bad_amt, 'amount_fix'] = ie.loc[bad_amt, 'total_num']\n    ie['amount_out'] = ie['amount_fix'].map(fmt_float)\n    inputs = ie[['subject_id', 'hadm_id', 'stay_id', 'starttime', 'endtime_fix', 'itemid', 'amount_out']].copy()\n    inputs.columns = ['subject_id', 'hadm_id', 'stay_id', 'starttime', 'endtime', 'itemid', 'amount']\n    inputs = inputs.drop_duplicates()\n\n    # ---------------------------------------------------------------- outputevents\n    oe = read_csv(R('icu', 'outputevents.csv'))\n    oe['itemid'] = oe['itemid'].map(fix_alias_itemid)\n    n_before = len(oe)\n    oe = oe[oe['itemid'] != INJECTED_ITEMID].copy()\n    log['outputevents_injected_rows_dropped'] = n_before - len(oe)\n    oe['hadm_id'] = oe['stay_id'].map(stay_hadm)\n    oe['subject_id'] = oe['stay_id'].map(stays.set_index('stay_id')['subject_id'])\n    # charttime was replaced by the unix epoch -> restore the hour the event was stored in\n    oe['st_dt'] = pd.to_datetime(oe['storetime'], errors='coerce')\n    epoch = oe['charttime'].astype(str).str.startswith('1970-01-01')\n    oe['charttime_fix'] = oe['charttime']\n    oe.loc[epoch, 'charttime_fix'] = oe.loc[epoch, 'st_dt'].dt.floor('h').dt.strftime('%Y-%m-%d %H:%M:%S')\n    oe['value_num'] = oe['value'].map(to_float)\n    oe['value_out'] = oe['value_num'].map(fmt_float)\n    outputs = oe[['subject_id', 'hadm_id', 'stay_id', 'charttime_fix', 'itemid', 'value_out']].copy()\n    outputs.columns = ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'value']\n    outputs = outputs.drop_duplicates()\n\n    # ---------------------------------------------------------------- ecg\n    rl = read_csv(R('ecg', 'record_list.csv'))\n    mm = read_csv(R('ecg', 'machine_measurements.csv'))\n    stay_rows = stays.set_index('stay_id')\n    rl['ecg_dt'] = pd.to_datetime(rl['ecg_time'], errors='coerce')\n    rows = []\n    for r in rl.itertuples():\n        srows = stays[stays['subject_id'] == r.subject_id]\n        for sr in srows.itertuples():\n            i_dt = sr.intime_dt\n            o_dt = pd.to_datetime(sr.outtime_fix)\n            if pd.notna(r.ecg_dt) and i_dt <= r.ecg_dt <= o_dt:\n                rows.append(dict(subject_id=r.subject_id, study_id=r.study_id, file_name=r.file_name,\n                                 ecg_time=r.ecg_time, path=r.path, hadm_id=sr.hadm_id, stay_id=sr.stay_id,\n                                 intime=sr.intime, outtime=sr.outtime_fix,\n                                 waveform_path=ECG_WAVEFORM_ROOT + r.path, hea_exists=False, dat_exists=False))\n    ecg_manifest = pd.DataFrame(rows, columns=['subject_id', 'study_id', 'file_name', 'ecg_time', 'path',\n                                                'hadm_id', 'stay_id', 'intime', 'outtime', 'waveform_path',\n                                                'hea_exists', 'dat_exists'])\n    if len(ecg_manifest):\n        ecg_manifest = ecg_manifest.sort_values(['subject_id', 'study_id'],\n                                                key=lambda s: s.astype(int) if s.name in ('subject_id', 'study_id') else s)\n    keep_studies = set(ecg_manifest['study_id']) if len(ecg_manifest) else set()\n    mm2 = mm[mm['study_id'].isin(keep_studies)].copy()\n    ecg_meas = mm2.merge(ecg_manifest[['study_id', 'hadm_id', 'stay_id']], on='study_id', how='left')\n    meas_cols = ['subject_id', 'study_id', 'cart_id', 'ecg_time'] + \\\n                [f'report_{i}' for i in range(17)] + \\\n                ['bandwidth', 'filtering', 'rr_interval', 'p_onset', 'p_end', 'qrs_onset', 'qrs_end',\n                 't_end', 'p_axis', 'qrs_axis', 't_axis', 'hadm_id', 'stay_id']\n\n    # ---------------------------------------------------------------- write\n    write_csv(admissions, O('admissions.csv'),\n              ['subject_id', 'hadm_id', 'admittime', 'dischtime', 'deathtime', 'admission_type',\n               'admission_location', 'discharge_location', 'insurance', 'language', 'marital_status',\n               'race', 'hospital_expire_flag'])\n    write_csv(cohort, O('cohort.csv'),\n              ['subject_id', 'hadm_id', 'cohort_type', 'cohort_label', 'hospital_expire_flag'])\n    write_csv(demographics, O('demographics.csv'),\n              ['subject_id', 'gender', 'anchor_age', 'anchor_year', 'anchor_year_group', 'dod'])\n    write_csv(diagnoses, O('diagnoses.csv'),\n              ['subject_id', 'hadm_id', 'seq_num', 'icd_code', 'icd_version'])\n    write_csv(procedures, O('procedures.csv'),\n              ['subject_id', 'hadm_id', 'seq_num', 'icd_code', 'icd_version'])\n    write_csv(medications, O('medications.csv'),\n              ['subject_id', 'hadm_id', 'starttime', 'stoptime', 'drug', 'dose_val_rx',\n               'dose_unit_rx', 'route'])\n    write_csv(labs, O('labs.csv'),\n              ['subject_id', 'hadm_id', 'itemid', 'charttime', 'valuenum', 'valueuom'])\n    write_csv(stays[['subject_id', 'hadm_id', 'stay_id', 'intime', 'outtime_fix', 'los_fix']],\n              O('icu', 'icustays.csv'),\n              ['subject_id', 'hadm_id', 'stay_id', 'intime', 'outtime', 'los'])\n    write_csv(chart, O('icu', 'chartevents.csv'),\n              ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'valuenum', 'valueuom'])\n    write_csv(inputs, O('icu', 'inputevents.csv'),\n              ['subject_id', 'hadm_id', 'stay_id', 'starttime', 'endtime', 'itemid', 'amount'])\n    write_csv(outputs, O('icu', 'outputevents.csv'),\n              ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'value'])\n    write_csv(ecg_manifest, O('multimodal', 'ecg_manifest.csv'),\n              ['subject_id', 'study_id', 'file_name', 'ecg_time', 'path', 'hadm_id', 'stay_id',\n               'intime', 'outtime', 'waveform_path', 'hea_exists', 'dat_exists'])\n    if len(ecg_meas):\n        write_csv(ecg_meas, O('multimodal', 'ecg_measurements.csv'), meas_cols)\n    else:\n        pd.DataFrame(columns=meas_cols).to_csv(O('multimodal', 'ecg_measurements.csv'), index=False)\n\n    if workdir:\n        try:\n            os.makedirs(workdir, exist_ok=True)\n            with open(os.path.join(workdir, 'pipeline_log.json'), 'w') as fh:\n                json.dump(log, fh, indent=2, default=str)\n        except Exception:\n            pass\n    return log\n\n\ndef repair_native_errors(ce, text_mask):\n    \"\"\"Replace MIMIC-native (not injected) impossible readings by the patient/item median.\"\"\"\n    lo_hi = ce['itemid'].map(CHARTEVENT_RANGES)\n    vn = ce['vn_fix']\n    sentinel = vn.isin(list(SENTINEL_VALUES))\n    out_of_range = (~vn.isna()) & (vn != 0) & lo_hi.notna() & \\\n                   ((vn < lo_hi.map(lambda t: t[0])) | (vn > lo_hi.map(lambda t: t[1])))\n    # a native error is documented in the value text column as well\n    same_as_value = (~text_mask) & (vn == ce['value_num'])\n    cand = (sentinel | out_of_range) & same_as_value\n    if not cand.any():\n        return ce\n    # patient level median per (subject, itemid) over the readings that are usable\n    usable = ce[~cand & ce['vn_fix'].notna()]\n    med = usable.groupby(['subject_id', 'itemid'])['vn_fix'].median()\n    idx = list(zip(ce.loc[cand, 'subject_id'], ce.loc[cand, 'itemid']))\n    repl = [med.get(k, np.nan) for k in idx]\n    # only replace when the deviation from the patient baseline is >= 20% and the\n    # patient has at least one in-range reading for that item\n    base = []\n    ok = []\n    for k, v, r in zip(idx, repl, ce.loc[cand, 'vn_fix']):\n        if pd.isna(v):\n            base.append(np.nan); ok.append(False); continue\n        dev = abs(v - r) / abs(v) if v != 0 else np.inf\n        base.append(v)\n        ok.append(dev >= 0.20)\n    ce.loc[cand, 'vn_fix'] = base\n    ce.loc[cand, 'vn_fix'] = [v if o else ce.loc[cand, 'vn_fix'].iloc[i]\n                              for i, (v, o) in enumerate(zip(base, ok))]\n    return ce\n\n\ndef main(argv=None):\n    ap = argparse.ArgumentParser()\n    ap.add_argument('--raw-root', required=True)\n    ap.add_argument('--output-dir', required=True)\n    ap.add_argument('--workdir', default=None)\n    a = ap.parse_args(argv)\n    log = run(a.raw_root, a.output_dir, a.workdir)\n    print(json.dumps(log, indent=2, default=str))\n    return 0\n\n\nif __name__ == '__main__':\n    sys.exit(main())\n"}
