{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/ie_amount_formula.py","content":"\"\"\"Which amount formula reproduces the reference strings best (using the pipeline's own duration estimate)?\"\"\"\nimport pandas as pd, numpy as np, re\n\nB = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\nraw = pd.read_csv(B + '/train/raw/icu/inputevents.csv', dtype=str, keep_default_na=False, na_values=[''])\nref = pd.read_csv(B + '/train/reference/icu/inputevents.csv', dtype=str, keep_default_na=False)\nstays = pd.read_csv(B + '/train/raw/icu/icustays.csv', dtype=str, keep_default_na=False)\nvalid = set(stays['stay_id'])\nraw['itemid'] = raw['itemid'].map(lambda s: '2' + s[3:] if isinstance(s, str) and re.fullmatch(r'992\\d{5}', s) else s)\nraw['stay_id'] = raw['stay_id'].map(lambda v: v[1:] if (isinstance(v, str) and v.startswith('9') and v[1:] in valid) else v)\nraw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\nfor c in ['starttime', 'endtime']:\n    raw[c] = pd.to_datetime(raw[c], errors='coerce')\nref['starttime'] = pd.to_datetime(ref['starttime'], errors='coerce')\nref['endtime'] = pd.to_datetime(ref['endtime'], errors='coerce')\nfor d in (raw, ref):\n    d['subject_id'] = d['subject_id'].astype(str); d['stay_id'] = d['stay_id'].astype(str)\n    d['itemid'] = d['itemid'].astype(str)\nfor c in ['amount', 'originalamount', 'totalamount', 'rate']:\n    raw[c + '_n'] = pd.to_numeric(raw[c], errors='coerce')\nraw['has_rate'] = raw['rate_n'] > 0\nraw['finished'] = raw['statusdescription'].fillna('') == 'FinishedRunning'\n\n# reuse the pipeline's duration estimate\nimport importlib.util\nspec = importlib.util.spec_from_file_location('pl', 'scripts/pipeline.py')\npl = importlib.util.module_from_spec(spec); spec.loader.exec_module(pl)\n\n# rebuild the delivery structure exactly like the pipeline\nie = raw.copy()\nmainrows = (ie[ie['has_rate']].sort_values(['linkorderid', 'starttime'])\n            .drop_duplicates(subset=['linkorderid', 'starttime'], keep='first'))\nmainrows = mainrows[['linkorderid', 'starttime', 'rate_n', 'originalamount_n', 'finished']]\ndl = (ie.groupby(['linkorderid', 'starttime'], sort=True)\n      .agg(any_rate=('has_rate', 'any')).reset_index()\n      .merge(mainrows, on=['linkorderid', 'starttime'], how='left'))\ndl = dl.sort_values(['linkorderid', 'starttime'])\ndl['next_start'] = dl.groupby('linkorderid')['starttime'].shift(-1)\ndl['chain_min'] = (dl['next_start'] - dl['starttime']).dt.total_seconds() / 60\nrate_dur = (dl['originalamount_n'] / dl['rate_n'].replace(0, np.nan) * 60).round()\ncomplete = dl['finished'].fillna(False) & dl['rate_n'].notna() & (dl['rate_n'] > 0)\ndl['dur_main'] = np.where(complete, rate_dur, np.where(dl['chain_min'].notna(), dl['chain_min'],\n                                                       np.where(~dl['any_rate'], 1.0, rate_dur)))\ndl['amt_main'] = np.where(complete, dl['originalamount_n'],\n                           np.where(dl['chain_min'].notna(), dl['rate_n'] * dl['chain_min'] / 60.0,\n                                    np.where(~dl['any_rate'], dl['originalamount_n'], np.nan)))\ndl = dl.set_index(['linkorderid', 'starttime'])\nkey = pd.MultiIndex.from_arrays([ie['linkorderid'], ie['starttime']])\nie['dur_deliv'] = dl['dur_main'].reindex(key).values\nie['amt_main'] = dl['amt_main'].reindex(key).values\nie['main_orig'] = dl['originalamount_n'].reindex(key).values\nie['chain_min'] = dl['chain_min'].reindex(key).values\nie['deliv_any_rate'] = dl['any_rate'].reindex(key).values\nrow_rate_dur = (ie['originalamount_n'] / ie['rate_n'].replace(0, np.nan) * 60).round()\ndur = pd.Series(np.nan, index=ie.index)\ndur = dur.mask(ie['has_rate'] & ie['finished'], row_rate_dur)\ndur = dur.mask(ie['has_rate'] & ~ie['finished'] & ie['chain_min'].notna(), ie['chain_min'])\ndur = dur.mask(ie['has_rate'] & ~ie['finished'] & ie['chain_min'].isna(), row_rate_dur)\ndur = dur.mask(~ie['has_rate'] & ie['deliv_any_rate'].fillna(False), ie['dur_deliv'])\ndur = dur.mask(~ie['has_rate'] & ~ie['deliv_any_rate'].fillna(False), 1.0)\nie['dur'] = dur\n\npairs = []\nfor k, sub in ie.groupby(['subject_id', 'stay_id', 'itemid', 'starttime']):\n    r = ref[(ref.subject_id == k[0]) & (ref.stay_id == k[1]) & (ref.itemid == k[2]) & (ref.starttime == k[3])]\n    if len(r) != len(sub):\n        continue\n    for i in range(len(sub)):\n        pairs.append({**sub.iloc[i].to_dict(), 'ref_amount': r.iloc[i]['amount'], 'ref_end': r.iloc[i]['endtime']})\np = pd.DataFrame(pairs)\np['ref_amount_n'] = pd.to_numeric(p['ref_amount'], errors='coerce')\n\nfmt = pl.fmt_float\ncands = {}\ncands['A originalamount'] = p['originalamount_n']\ncands['B rate*dur/60 (f64)'] = p['rate_n'] * p['dur'].fillna(1.0) / 60.0\ncands['C float32(rate*dur/60)'] = np.float32(p['rate_n'] * p['dur'].fillna(1.0) / 60.0).astype(np.float64)\ncands['D f32(rate)*f32(dur/60)'] = (np.float32(p['rate_n'].values) * np.float32((p['dur'].fillna(1.0) / 60.0).values)).astype(np.float64)\ncands['E f32(orig) for finished'] = np.where(p['has_rate'] & p['finished'], np.float32(p['originalamount_n'].values).astype(np.float64),\n                                             np.float32(p['rate_n'] * p['dur'].fillna(1.0) / 60.0).values)\nfor name, v in cands.items():\n    s = pd.Series(v, index=p.index).map(lambda x: fmt(x) if pd.notna(x) else '')\n    num = pd.to_numeric(s, errors='coerce').round(6)\n    print('%-24s string=%0.4f  numeric=%0.4f' % (name, float((s == p['ref_amount']).mean()),\n                                                 float((num == p['ref_amount_n'].round(6)).mean())))\nprint()\nprint('per subset (C float32):')\nsC = pd.Series(cands['C float32(rate*dur/60)'], index=p.index).map(lambda x: fmt(x) if pd.notna(x) else '')\nfor name, m in (('no rate', ~p['has_rate']), ('rate+finished', p['has_rate'] & p['finished']),\n                ('rate+other', p['has_rate'] & ~p['finished'])):\n    print('   %-16s n=%5d str=%.4f' % (name, int(m.sum()), float((sC[m] == p['ref_amount'][m]).mean())))\nprint()\nprint('with the oracle duration:')\np['dur_oracle'] = (pd.to_datetime(p['ref_end']) - pd.to_datetime(p['starttime'])).dt.total_seconds() / 60\nsO = pd.Series(np.float32(p['rate_n'] * p['dur_oracle'] / 60.0).values, index=p.index).map(lambda x: fmt(x) if pd.notna(x) else '')\nprint('   float32(rate*dur_oracle/60) string=%.4f' % float((sO == p['ref_amount']).mean()))\n"}
