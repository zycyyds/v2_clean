oretime vs sorted ref charttime\n    for item in r['itemid'].unique()[:3]:\n        rr = r[r['itemid'] == item].sort_values('charttime')['charttime'].tolist()\n        ww = w[w['itemid'] == item].sort_values('storetime')['storetime'].tolist()\n        print(f'   item {item} n={len(rr)}')\n        for a, b in list(zip(rr, ww))[:6]:\n            print(f'      ref_ct={a}  store={b}  delta={(a-b).total_seconds():8.0f}s')\nprint()\nprint('--- value swap check: identical (stay,itemid,storetime) groups ---')\nprint(raw.groupby(['stay_id', 'itemid']).size().value_counts().head().to_string())\n"}
