{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/ie_status.py","content":"\"\"\"Evaluate the statusdescription-aware inputevents repair rules (train).\"\"\"\nimport pandas as pd, numpy as np, re\n\nB = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\nraw = pd.read_csv(B + '/train/raw/icu/inputevents.csv', dtype=str, keep_default_na=False, na_values=[''])\nref = pd.read_csv(B + '/train/reference/icu/inputevents.csv', dtype=str, keep_default_na=False)\nstays = pd.read_csv(B + '/train/raw/icu/icustays.csv', dtype=str, keep_default_na=False)\nvalid = set(stays['stay_id'])\nraw['itemid'] = raw['itemid'].map(lambda s: '2' + s[3:] if isinstance(s, str) and re.fullmatch(r'992\\d{5}', s) else s)\nraw['stay_id'] = raw['stay_id'].map(lambda v: v[1:] if (isinstance(v, str) and v.startswith('9') and v[1:] in valid) else v)\nraw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\nfor c in ['starttime', 'endtime', 'storetime']:\n    raw[c] = pd.to_datetime(raw[c], errors='coerce')\nref['starttime'] = pd.to_datetime(ref['starttime'], errors='coerce')\nref['endtime'] = pd.to_datetime(ref['endtime'], errors='coerce')\nfor d in (raw, ref):\n    d['subject_id'] = d['subject_id'].astype(str); d['stay_id'] = d['stay_id'].astype(str)\n    d['itemid'] = d['itemid'].astype(str)\n\npairs = []\nfor key, sub in raw.groupby(['subject_id', 'stay_id', 'itemid', 'starttime']):\n    r = ref[(ref.subject_id == key[0]) & (ref.stay_id == key[1]) & (ref.itemid == key[2]) &\n             (ref.starttime == key[3])]\n    if len(r) != len(sub):\n        continue\n    for i in range(len(sub)):\n        pairs.append({**sub.iloc[i].to_dict(), 'ref_amount': r.iloc[i]['amount'],\n                      'ref_end': r.iloc[i]['endtime']})\np = pd.DataFrame(pairs)\nfor c in ['amount', 'originalamount', 'totalamount', 'rate']:\n    p[c + '_n'] = pd.to_numeric(p[c], errors='coerce')\np['ref_amount_n'] = pd.to_numeric(p['ref_amount'], errors='coerce')\np['dur_ref_min'] = (p['ref_end'] - p['starttime']).dt.total_seconds() / 60\np['has_rate'] = p['rate_n'] > 0\np['finished'] = p['statusdescription'].fillna('') == 'FinishedRunning'\n\nprint('rows:', len(p))\nprint('status counts:', p['statusdescription'].value_counts().to_dict())\nprint('reference durations are whole minutes:', float((p['dur_ref_min'] % 1 == 0).mean()))\nprint()\n\n# --- endtime rules -------------------------------------------------------\ndef acc_end(pred_min):\n    \"\"\"pred_min: series of durations in minutes\"\"\"\n    return float((pred_min.round() == p['dur_ref_min']).mean())\n\nd_rate = p.originalamount_n / p.rate_n.replace(0, np.nan) * 60      # ordered amount / rate\nend = pd.Series(np.nan, index=p.index)\n# 1) no rate -> bolus 1 minute\nend = end.mask(~p.has_rate, 1.0)\n# 2) finished + rate -> ordered amount / rate\nend = end.mask(p.has_rate & p.finished, d_rate)\n# 3) other rate rows -> next delivery start in the linkorderid chain\nchain = pd.Series(pd.NaT, index=p.index)\nfor lo, sub in p.groupby('linkorderid'):\n    sub = sub.sort_values('starttime')\n    idx = list(sub.index)\n    for a, b in zip(idx, idx[1:]):\n        chain[a] = p.loc[b, 'starttime']\nchain_min = (chain - p['starttime']).dt.total_seconds() / 60\nend = end.mask(p.has_rate & ~p.finished & chain_min.notna(), chain_min)\nend = end.mask(end.isna(), 1.0)\nprint('endtime rule (status aware):', round(acc_end(end), 4))\nprint('endtime rule (current)      :', round(acc_end(pd.Series(np.where(p.has_rate, d_rate, 1.0))), 4))\nprint('   breakdown:')\nfor name, m in (('no rate (bolus)', ~p.has_rate), ('rate+finished', p.has_rate & p.finished),\n                ('rate+other, chain used', p.has_rate & ~p.finished & chain_min.notna()),\n                ('rate+other, no chain', p.has_rate & ~p.finished & chain_min.isna())):\n    if m.sum():\n        print(f'     {name:24s} n={int(m.sum()):5d} exact={float((end[m].round() == p[\"dur_ref_min\"][m]).mean()):.4f}')\nprint()\n# rounding of the rate-row duration to whole minutes\nprint('rate+finished: exact minutes   :', round(float((d_rate[p.has_rate & p.finished].round() == p['dur_ref_min'][p.has_rate & p.finished]).mean()), 4))\nprint('rate+finished: within 1 min    :', round(float((d_rate[p.has_rate & p.finished] - p['dur_ref_min'][p.has_rate & p.finished]).abs().le(1).mean()), 4))\nprint('rate+finished: within 5 min    :', round(float((d_rate[p.has_rate & p.finished] - p['dur_ref_min'][p.has_rate & p.finished]).abs().le(5).mean()), 4))\nprint('rate+finished: relative error of the raw rate vs the implied rate:')\nimp = p.originalamount_n / (p['dur_ref_min'] / 60)\nsel = p.has_rate & p.finished & (p['dur_ref_min'] > 0)\nrel = (p.loc[sel, 'rate_n'] / imp[sel]).round(6)\nprint('   ', rel.value_counts().head(8).to_dict())\nprint()\n# --- amount rules --------------------------------------------------------\namt = pd.Series(p['originalamount_n'].values, index=p.index)\n# chain-derived duration for the non finished rate rows -> amount = rate * duration\namt2 = amt.copy()\namt2 = amt2.mask(p.has_rate & ~p.finished & chain_min.notna(), p.rate_n * chain_min / 60)\nprint('amount rule (originalamount everywhere):', round(float((amt.round(4) == p['ref_amount_n'].round(4)).mean()), 4))\nprint('amount rule (chain for non-finished)   :', round(float((amt2.round(4) == p['ref_amount_n'].round(4)).mean()), 4))\nprint('   breakdown of the originalamount rule:')\nfor name, m in (('no rate (bolus)', ~p.has_rate), ('rate+finished', p.has_rate & p.finished),\n                ('rate+other', p.has_rate & ~p.finished)):\n    print(f'     {name:24s} n={int(m.sum()):5d} exact={float((amt[m].round(4) == p[\"ref_amount_n\"][m].round(4)).mean()):.4f}')\n"}
