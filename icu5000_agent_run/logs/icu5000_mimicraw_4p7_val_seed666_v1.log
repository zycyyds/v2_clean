#!/usr/bin/env python3
"""Compare a produced result package against a reference package (cell level)."""
import sys, os, json
import pandas as pd, numpy as np

FILES = ["admissions.csv", "cohort.csv", "demographics.csv", "diagnoses.csv",
         "procedures.csv", "medications.csv", "labs.csv",
         "icu/icustays.csv", "icu/chartevents.csv", "icu/inputevents.csv",
         "icu/outputevents.csv", "multimodal/ecg_manifest.csv",
         "multimodal/ecg_measurements.csv"]


def norm(v):
    if v is None:
        return ""
    s = str(v).strip()
    if s == "" or s.lower() == "nan":
        return ""
    try:
        f = float(s)
        return f"{f:.10g}"
    except ValueError:
        return s


def compare(out_dir, ref_dir, verbose=True, keycols=None):
    total = {"files": {}, "cell_acc": 0, "cell_tot": 0, "row_acc": 0, "row_tot": 0}
    for rel in FILES:
        op = os.path.join(out_dir, rel)
        rp = os.path.join(ref_dir, rel)
        if not os.path.exists(op) or not os.path.exists(rp):
            total["files"][rel] = {"missing": True}
            continue
        o = pd.read_csv(op, dtype=str, keep_default_na=False)
        r = pd.read_csv(rp, dtype=str, keep_default_na=False)
        cols = [c for c in r.columns if c in o.columns]
        missing_cols = [c for c in r.columns if c not in o.columns]
        extra_cols = [c for c in o.columns if c not in r.columns]
        okc = okr = 0
        totc = totr = 0
        # align on all shared columns as key
        kc = keycols.get(rel) if keycols else None
        if kc is None:
            kc = [c for c in cols if c in ("subject_id", "hadm_id", "stay_id", "charttime",
                                           "itemid", "seq_num", "study_id", "ecg_time",
                                           "starttime", "cart_id", "drug", "file_name")]
            kc = [c for c in kc if c in cols]
        on = [c for c in kc if c in cols]
        o2 = o.copy(); r2 = r.copy()
        for c in on:
            o2[c] = o2[c].map(norm); r2[c] = r2[c].map(norm)
        # occurrence counter so that duplicated keys are aligned 1:1
        o2["_occ"] = o2.groupby(on, dropna=False).cumcount() if on else 0
        r2["_occ"] = r2.groupby(on, dropna=False).cumcount() if on else 0
        on2 = on + ["_occ"]
        if on:
            m = r2.merge(o2, on=on2, how="outer", indicator=True, suffixes=("_r", "_o"))
            matched = m[m._merge == "both"]
            n_extra = int((m._merge == "right_only").sum())
            n_missing = int((m._merge == "left_only").sum())

