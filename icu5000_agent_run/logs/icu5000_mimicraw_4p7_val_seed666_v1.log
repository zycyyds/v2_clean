ion value counts:', nr['dur_ref_min'].value_counts().head(6).to_dict())\nprint('   duration == 1 min share:', round(float((nr.dur_ref_min == 1).mean()), 4))\nprint('   duration == 3 min share:', round(float((nr.dur_ref_min == 3).mean()), 4))\nprint('   duration == 0 min share:', round(float((nr.dur_ref_min == 0).mean()), 4))\nprint('   orig amount present:', round(float(nr.originalamount_n.notna().mean()), 4),\n      ' ref amount present:', round(float(nr.ref_amount_n.notna().mean()), 4))\nprint('   orig==ref (non-rate):', round(float((nr.originalamount_n == nr.ref_amount_n).mean()), 4))\nprint()\nprint('=== bolus detection: rate present but duration == 1 min ===')\nb = p[has_rate & (p.dur_ref_min == 1)]\nprint('n =', len(b), ' of which orig/rate == 1min:', round(float(np.isclose((b.originalamount_n / b.rate_n * 60).round(), 1, atol=0.5).mean()), 4))\nprint()\nprint('=== does endtime = starttime + 60s hold for the ref? ===')\nprint('overall 1min share:', round(float((p.dur_ref_min == 1).mean()), 4))\nprint('for rows with no rate:', round(float((nr.dur_ref_min == 1).mean()), 4))\nprint('for rows with rate   :', round(float((p[has_rate].dur_ref_min == 1).mean()), 4))\n"}
