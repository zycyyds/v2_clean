{"file_path": "/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/selfcheck.py", "content": "#!/usr/bin/env python3\n\"\"\"Self-check: compare a produced result package against a reference package.\"\"\"\nimport argparse\nimport json\nimport os\nimport sys\n\nimport numpy as np\nimport pandas as pd\n\nKEYS = {\n    'admissions.csv': ['subject_id', 'hadm_id'],\n    'cohort.csv': ['subject_id', 'hadm_id'],\n    'demographics.csv': ['subject_id'],\n    'diagnoses.csv': ['subject_id', 'hadm_id', 'seq_num'],\n    'procedures.csv': ['subject_id', 'hadm_id', 'seq_num'],\n    'medications.csv': ['subject_id', 'hadm_id', 'starttime', 'drug'],\n    'labs.csv': ['subject_id', 'hadm_id', 'itemid', 'charttime'],\n    'icu/icustays.csv': ['stay_id'],\n    'icu/chartevents.csv': ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid'],\n    'icu/inputevents.csv': ['subject_id', 'hadm_id', 'stay_id', 'starttime', 'itemid'],\n    'icu/outputevents.csv': ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid'],\n    'multimodal/ecg_manifest.csv': ['subject_id', 'study_id'],\n    'multimodal/ecg_measurements.csv': ['subject_id', 'study_id'],\n}\nORDER = list(KEYS.keys())\n\n\ndef norm(df):\n    df = df.copy()\n    for c in df.columns:\n        df[c] = df[c].fillna('').astype(str)\n    return df\n\n\ndef compare(name, got, ref):\n    got = norm(got); ref = norm(ref)\n    keys = [k for k in KEYS[name] if k in got.columns and k in ref.columns]\n    cols = [c for c in ref.columns if c in got.columns]\n    g = got.reindex(columns=cols)\n    r = ref.reindex(columns=cols)\n    for df in (g, r):\n        df['__occ'] = df.groupby(keys, dropna=False).cumcount() if keys else 0\n    m = g.merge(r, on=keys + ['__occ'], how='outer', indicator=True, suffixes=('_g', '_r'))\n    both = m[m['_merge'] == 'both']\n    only_g = m[m['_merge'] == 'left_only']\n    only_r = m[m['_merge'] == 'right_only']\n    n_g, n_r = len(g), len(r)\n    matched = len(both)\n    # cell accuracy over matched rows\n    cell_ok = cell_tot = 0\n    per_col = {}\n    for c in cols:\n        if c in keys:\n            continue\n        a = both[c + '_g'].values\n        b = both[c + '_r'].values\n        ok = (a == b)\n        num = ~pd.to_numeric(pd.Series(a).fillna(''), errors='coerce').isna()\n        both_num = num & ~pd.to_numeric(pd.Series(b).fillna(''), errors='coerce').isna()\n        if both_num.sum():\n            av = pd.to_numeric(pd.Series(a[both_num.values]), errors='coerce').values\n            bv = pd.to_numeric(pd.Series(b[both_num.values]), errors='coerce').values\n            ok = ok | np.isclose(av, bv, rtol=1e-9, atol=1e-9)\n        cell_ok += int(ok.sum()); cell_tot += len(a)\n        per_col[c] = round(float(ok.mean()), 4) if len(a) else None\n    # multiset-per-key comparison (order insensitive)\n    def multiset(df):\n        if not keys:\n            return {}\n        d = df.sort_values(keys)\n        return d.groupby(keys, dropna=False)[cols].apply(\n            lambda s: tuple(sorted(tuple(str(x) for x in row) for row in s.values))).to_dict()\n    mg, mr = multiset(g), multiset(r)\n    common = set(mg) & set(mr)\n    ms_ok = sum(1 for k in common if mg[k] == mr[k])\n    res = dict(\n        file=name, rows_got=n_g, rows_ref=n_r, matched=matched,\n        extra_rows=len(only_g), missing_rows=len(only_r),\n        row_precision=round(matched / n_g, 4) if n_g else 0.0,\n        row_recall=round(matched / n_r, 4) if n_r else 0.0,\n        cell_acc=round(cell_ok / cell_tot, 4) if cell_tot else None,\n        multiset_key_acc=round(ms_ok / len(mr), 4) if mr else None,\n        per_col=per_col)\n    return res\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument('--out-dir', required=True)\n    ap.add_argument('--ref-dir', required=True)\n    ap.add_argument('--json-out', default=None)\n    a = ap.parse_args()\n    results = []\n    for name in ORDER:\n        op = os.path.join(a.out_dir, name)\n        rp = os.path.join(a.ref_dir, name)\n        if not os.path.exists(op):\n            results.append(dict(file=name, error='missing output'))\n            continue\n        if not os.path.exists(rp):\n            results.append(dict(file=name, error='missing reference'))\n            continue\n        got = pd.read_csv(op, dtype=str, keep_default_na=False)\n        ref = pd.read_csv(rp, dtype=str, keep_default_na=False)\n        r = compare(name, got, ref)\n        results.append(r)\n        print(f\"{r['file']:34s} rows {r['rows_got']:6d}/{r['rows_ref']:6d}  matched {r['matched']:6d} \"\n              f\" extra {r['extra_rows']:5d} miss {r['missing_rows']:5d} \"\n              f\" P {r['row_precision']:.3f} R {r['row_recall']:.3f} cell {r['cell_acc']} \"\n              f\" mset {r['multiset_key_acc']}\")\n    ok = [r for r in results if 'row_precision' in r]\n    print('\\nmean row precision', round(float(np.mean([r['row_precision'] for r in ok])), 4))\n    print('mean row recall   ', round(float(np.mean([r['row_recall'] for r in ok])), 4))\n    print('mean cell acc     ', round(float(np.mean([r['cell_acc'] for r in ok if r['cell_acc'] is not None])), 4))\n    if a.json_out:\n        with open(a.json_out, 'w') as fh:\n            json.dump(results, fh, indent=2)\n\n\nif __name__ == '__main__':\n    main()\n"}
