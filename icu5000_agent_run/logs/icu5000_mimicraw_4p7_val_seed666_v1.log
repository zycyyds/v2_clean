#!/usr/bin/env python3
"""Write submission.json for the ICU5000 result package."""
import argparse
import json
import os


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--output_dir", default=".")
    ap.add_argument("--result_root", default="result")
    ap.add_argument("--script", default="scripts/replay.py")
    args = ap.parse_args()

    sub = {
        "schema_version": 1,
        "result_root": args.result_root,
        "replay": {
            "argv": ["python3", args.script, "--raw_root", "{raw_root}",
                     "--output_dir", "{output_dir}", "--train_reference",
                     "{train_reference}", "--workdir", "{workdir}"],
        },
        "files": [
            "admissions.csv", "cohort.csv", "demographics.csv", "diagnoses.csv",
            "procedures.csv", "medications.csv", "labs.csv",
            "icu/icustays.csv", "icu/chartevents.csv", "icu/inputevents.csv",
            "icu/outputevents.csv", "multimodal/ecg_manifest.csv",
            "multimodal/ecg_measurements.csv",
        ],
    }
    path = os.path.join(args.output_dir, "submission.json")
    with open(path, "w") as fh:
        json.dump(sub, fh, indent=2)
    print("wrote", path)
    print(json.dumps(sub, indent=2))


if __name__ == "__main__":
    main()
