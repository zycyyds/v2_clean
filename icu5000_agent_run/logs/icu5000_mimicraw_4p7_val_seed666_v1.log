      b = both[c + '_m'] if c + '_m' in both.columns else both[c]\n        acc[c] = float((a == b).mean()) if len(both) else 0.0\n    # alignment WITH the full key (uncertain columns part of the key)\n    for d in (ref, mine):\n        d['__occ2'] = d.groupby(K, dropna=False).cumcount()\n    m2 = ref.merge(mine, on=K + ['__occ2'], how='outer', indicator=True, suffixes=('_r', '_m'))\n    both2 = m2[m2['_merge'] == 'both']\n    acc2 = {}\n    for c in cols:\n        a = both2[c + '_r'] if c + '_r' in both2.columns else both2[c]\n        b = both2[c + '_m'] if c + '_m' in both2.columns else both2[c]\n        acc2[c] = float((a == b).mean()) if len(both2) else 0.0\n    fullrow = 0\n    for _, rr in both.iterrows():\n        if all((rr[c + '_r'] if c + '_r' in rr.index else rr[c]) ==\n               (rr[c + '_m'] if c + '_m' in rr.index else rr[c]) for c in cols):\n            fullrow += 1\n    stats[f] = dict(n_gold=len(ref), n_mine=len(mine), matched_w=len(both), matched_k=len(both2),\n                    acc=acc, acc2=acc2, cols=len(cols),\n                    fullrow=fullrow / len(ref),\n                    fullrow_k=sum(1 for _, rr in both2.iterrows()\n                                  if all((rr[c + '_r'] if c + '_r' in rr.index else rr[c]) ==\n                                         (rr[c + '_m'] if c + '_m' in rr.index else rr[c]) for c in cols))\n                    / max(len(ref), 1),\n                    C=len(cols))\n\n\ndef formulas(f):\n    s = stats[f]\n    acc, acc2, C, ng = s['acc'], s['acc2'], s['cols'], s['n_gold']\n    out = {}\n    out['M1 mean per-col acc (wide key)'] = sum(acc.values()) / C\n    out['M2 mean per-col acc (full key)'] = sum(acc2.values()) / C\n    out['M3 cell acc wide  (sum acc / n_gold*C)'] = sum(acc.values()) / (ng * C)\n    out['M4 cell acc full (sum acc2 / n_gold*C)'] = sum(acc2.values()) / (ng * C)\n    out['M5 full-row rate wide'] = s['fullrow']\n    out['M6 full-row rate full'] = s['fullrow_k']\n    out['M7 matched rows (full key)/n_gold'] = s['matched_k'] / ng\n    out['M8 mean of acc over perfect cols only'] = np.mean([acc[c] for c in acc if acc[c] == 1.0]) if any(\n        acc[c] == 1.0 for c in acc) else 0\n    return out\n\n\nnames = None\nprint(f'{\"metric\":42s} ' + ' '.join(f'{f.split(\"/\")[-1][:12]:>13s}' for f in FILES))\nprint(f'{\"HOST\":42s} ' + ' '.join(f'{HOST[f]:13.4f}' for f in FILES))\nres = {}\nfor f in FILES:\n    res[f] = formulas(f)\nfor mname in res[list(FILES)[0]]:\n    row = ' '.join(f'{res[f][mname]:13.4f}' for f in FILES)\n    err = np.mean([abs(res[f][mname] - HOST[f]) for f in FILES])\n    print(f'{mname:42s} {row}   MAE={err:.4f}')\nprint()\nfor f in FILES:\n    s = stats[f]\n    print(f'{f}: gold_rows={s[\"n_gold\"]} mine={s[\"n_mine\"]} matched_wide={s[\"matched_w\"]} '\n          f'matched_full={s[\"matched_k\"]} cols={s[\"cols\"]}')\n    print('   acc (wide):', {k: round(v, 3) for k, v in s['acc'].items()})\n"}
