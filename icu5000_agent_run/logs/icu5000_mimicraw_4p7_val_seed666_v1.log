\",\n      \"primary_key\": \"hadm_id\",\n      \"time_anchor\": \"admittime / dischtime / deathtime\",\n      \"filters\": \"hadm_id in cohort (the cohort admission set)\",\n      \"field_transformations\": \"keep subject_id, hadm_id, admittime, dischtime, deathtime, admission_type, admission_location, discharge_location, insurance, language, marital_status, race, hospital_expire_flag; hospital_expire_flag recomputed from deathtime; drop admit_provider_id, edregtime, edouttime.\",\n      \"aggregation\": \"none (row per hospital admission)\",\n      \"known_unrecoverable\": \"insurance is empty in every raw row (train and validation) while the reference has Medicare/Private - the value does not exist anywhere in the raw slice.\"\n    },\n    \"cohort.csv\": {\n      \"raw_input\": \"icu/icustays.csv + hosp/admissions.csv + icu/inputevents.csv\",\n      \"primary_key\": \"(subject_id, hadm_id)\",\n      \"time_anchor\": \"icustay intime\",\n      \"filters\": \"see cohort_semantics.rule\",\n      \"field_transformations\": \"cohort_type='icu', cohort_label='ICU', hospital_expire_flag recomputed from deathtime\",\n      \"aggregation\": \"distinct (subject_id, hadm_id)\"\n    },\n    \"demographics.csv\": {\n      \"raw_input\": \"hosp/patients.csv (+ note/discharge.csv for the sex of the patient)\",\n      \"primary_key\": \"subject_id\",\n      \"time_anchor\": \"anchor_year / dod\",\n      \"filters\": \"subject_id in cohort\",\n      \"field_transformations\": \"gender: 'UNKNOWN_GENDER_CODE' -> the sex written in the discharge summary header ('Sex: M/F'); anchor_age: the 999 sentinel is dropped (the true age is not present anywhere in the raw slice).\",\n      \"aggregation\": \"none\"\n    },\n    \"diagnoses.csv\": {\n      \"raw_input\": \"hosp/diagnoses_icd.csv\",\n      \"primary_key\": \"(subject_id, hadm_id, seq_num)\",\n      \"time_anchor\": \"none\",\n      \"filters\": \"hadm_id in cohort\",\n      \"field_transformations\": \"icd_code: strip the injec