) share the\n        start time of a segment, so the next *distinct* start time is used.\n\n        The segment is looked up through the hash of (stay, link, start time),\n        so that no string column has to be materialised (the raw slice of the\n        final test set has tens of millions of inputevents rows).\n        \"\"\"\n        if \"linkorderid\" not in i.columns:\n            return pd.Series(np.nan, index=i.index)\n        t = pd.to_datetime(i.starttime, errors=\"coerce\")\n        key = pd.DataFrame({\"stay\": i.stay_id, \"link\": i.linkorderid, \"t\": t})\n        h = pd.util.hash_pandas_object(key, index=False)\n        order = pd.DataFrame({\"h\": h.to_numpy(), \"stay\": key[\"stay\"],\n                              \"link\": key[\"link\"], \"t\": key[\"t\"]}, index=i.index)\n        order = order.sort_values([\"stay\", \"link\", \"t\"])\n        first = ~order.duplicated([\"stay\", \"link\", \"t\"], keep=\"first\")\n        uniq = order[first]\n        nxt = uniq.groupby([\"stay\", \"link\"], observed=True)[\"t\"].shift(-1)\n        seg = (nxt - uniq[\"t\"]).dt.total_seconds() / 60.0\n        lookup = pd.Series(seg.to_numpy(), index=uniq[\"h\"].to_numpy())\n        return pd.Series(h.map(lookup).to_numpy(), index=i.index)"}
