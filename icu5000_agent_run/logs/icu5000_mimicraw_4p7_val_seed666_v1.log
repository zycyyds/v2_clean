{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/oe_pair.py","content":"\"\"\"Pair outputevents rows by value within (stay,itemid) and measure the charttime rule.\"\"\"\nimport pandas as pd, numpy as np\nfrom collections import Counter\nBASE = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\nraw = pd.read_csv(BASE + '/train/raw/icu/outputevents.csv', dtype=str, keep_default_na=False, na_values=[''])\nref = pd.read_csv(BASE + '/train/reference/icu/outputevents.csv', dtype=str, keep_default_na=False)\nstays = pd.read_csv(BASE + '/train/raw/icu/icustays.csv', dtype=str, keep_default_na=False)\nvalid = set(stays['stay_id'])\nraw['stay_id'] = raw['stay_id'].map(lambda v: v[1:] if (isinstance(v, str) and v.startswith('9') and v[1:] in valid) else v)\nraw['hadm_id'] = raw['stay_id'].map(stays.set_index('stay_id')['hadm_id'])\nraw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\nraw['storetime'] = pd.to_datetime(raw['storetime'], errors='coerce')\nref['charttime'] = pd.to_datetime(ref['charttime'], errors='coerce')\nfor d in (raw, ref):\n    d['subject_id'] = d['subject_id'].astype(str); d['stay_id'] = d['stay_id'].astype(str)\n    d['itemid'] = d['itemid'].astype(str)\n\npairs = []\nfor key, sub in raw.groupby(['subject_id', 'stay_id', 'itemid']):\n    r = ref[(ref['subject_id'] == key[0]) & (ref['stay_id'] == key[1]) & (ref['itemid'] == key[2])].copy()\n    r['ord'] = r['charttime'].rank(method='first')\n    r = r.sort_values(['value', 'ord'])\n    s2 = sub.copy()\n    s2['ord'] = range(len(s2))\n    s2 = s2.sort_values(['value', 'ord'])\n    if len(r) != len(s2):\n        continue\n    for i in range(len(s2)):\n        pairs.append({'store': s2.iloc[i]['storetime'], 'ref_ct': r.iloc[i]['charttime'],\n                      'value': s2.iloc[i]['value'], 'ref_value': r.iloc[i]['value'],\n                      'itemid': key[2], 'stay': key[1]})\np = pd.DataFrame(pairs)\nprint('paired', len(p), 'of', len(raw))\np['d'] = (p['ref_ct'] - p['store']).dt.total_seconds()\nprint('delta seconds (ref_ct - storetime) top 20:')\nprint(p['d'].value_counts().head(20).to_string())\nprint()\nprint('value identical in pair:', (p['value'] == p['ref_value']).mean().round(4))\nprint('ref_ct == storetime      :', float((p['ref_ct'] == p['store']).mean()).round(4))\nprint('ref_ct == floor(store,h) :', float((p['ref_ct'] == p['store'].dt.floor('h')).mean()).round(4))\nprint('ref_ct <= storetime      :', float((p['d'] <= 0).mean()).round(4))\nprint('|d| <= 60s               :', float((p['d'].abs() <= 60).mean()).round(4))\nprint('|d| <= 1h                :', float((p['d'].abs() <= 3600).mean()).round(4))\nprint('|d| <= 5min              :', float((p['d'].abs() <= 300).mean()).round(4))\nprint()\n# candidate: floor to the hour grid of the stay? test floor(store,'h') vs the hour grid\nprint('ref_ct minute==0 share:', float((p['ref_ct'].dt.minute == 0).mean()).round(4),\n      ' second==0:', float((p['ref_ct'].dt.second == 0).mean()).round(4))\nprint('store minute==0 share:', float((p['store'].dt.minute == 0).mean()).round(4))\nprint()\n# how many rows share (stay,itemid,storetime)?\ng = raw.groupby(['stay_id', 'itemid', 'storetime']).size()\nprint('group sizes (stay,itemid,store):', g.value_counts().to_dict())\nprint('rows in multi-row groups:', int(g[g > 1].sum()), 'of', len(raw))\n"}
