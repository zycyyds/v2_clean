{"file_path": "/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/cohort_sep.py", "content": "import pandas as pd, numpy as np\nBASE = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\n\ndef feats(split, excl):\n    R = lambda t: pd.read_csv(f'{BASE}/{split}/raw/{t}', dtype=str, keep_default_na=False, na_values=[''])\n    st = R('icu/icustays.csv'); adm = R('hosp/admissions.csv')\n    st['intime_dt'] = pd.to_datetime(st.intime)\n    st['outtime_dt'] = st.intime_dt + pd.to_timedelta(st.los.astype(float) * 86400, unit='s')\n    st['icu_days'] = st.los.astype(float)\n    st = st.merge(adm[['subject_id', 'hadm_id', 'admittime', 'dischtime']], on=['subject_id', 'hadm_id'], how='left')\n    st['adm_days'] = (pd.to_datetime(st.dischtime) - pd.to_datetime(st.admittime)).dt.total_seconds() / 86400.0\n    rows = {}\n    for t in ['hosp/labevents.csv', 'hosp/emar.csv', 'hosp/prescriptions.csv', 'hosp/pharmacy.csv',\n              'hosp/poe.csv', 'hosp/diagnoses_icd.csv', 'hosp/procedures_icd.csv', 'hosp/transfers.csv',\n              'hosp/microbiologyevents.csv', 'hosp/services.csv', 'hosp/drgcodes.csv',\n              'icu/chartevents.csv', 'icu/inputevents.csv', 'icu/ingredientevents.csv',\n              'icu/procedureevents.csv', 'icu/outputevents.csv', 'icu/datetimeevents.csv']:\n        df = R(t)\n        rows[t] = df.groupby('subject_id').size()\n    H = pd.DataFrame(rows).fillna(0)\n    H.columns = [c.split('/')[-1].replace('.csv', '') for c in H.columns]\n    hosp = [c for c in H.columns if c in ('labevents', 'emar', 'prescriptions', 'pharmacy', 'poe',\n                                          'diagnoses_icd', 'procedures_icd', 'transfers',\n                                          'microbiologyevents', 'services', 'drgcodes')]\n    H['hosp_rows'] = H[hosp].sum(axis=1)\n    H['icu_rows'] = H[[c for c in H.columns if c.startswith(('chartevents', 'inputevents', 'ingredientevents',\n                                                           'procedureevents', 'outputevents', 'datetimeevents'))]].sum(axis=1)\n    H['icu_chart'] = H['chartevents']\n    lab = R('hosp/labevents.csv'); lab['ct'] = pd.to_datetime(lab.charttime, errors='coerce')\n    sp = lab.groupby('subject_id')['ct'].agg(['min', 'max'])\n    H = H.join(sp.rename(columns={'min': 'lab_min', 'max': 'lab_max'}))\n    H['lab_span'] = (H.lab_max - H.lab_min).dt.total_seconds() / 86400.0\n    H = H.join(st.set_index('subject_id')[['icu_days', 'adm_days', 'stay_id', 'hadm_id']])\n    H['hosp_per_icu'] = H.hosp_rows / H.icu_rows.replace(0, np.nan)\n    H['hosp_per_chart'] = H.hosp_rows / H.icu_chart.replace(0, np.nan)\n    H['hosp_per_icuday'] = H.hosp_rows / H.icu_days.replace(0, np.nan)\n    H['chart_per_icuday'] = H.icu_chart / H.icu_days.replace(0, np.nan)\n    H['labspan_per_icuday'] = H.lab_span / H.icu_days.replace(0, np.nan)\n    H['labs_per_admday'] = H.labevents / H.adm_days.replace(0, np.nan)\n    H['icu_per_admday'] = H.icu_rows / H.adm_days.replace(0, np.nan)\n    H['excl'] = H.index == excl\n    return H\n\nfor split, excl in [('train', '17025507'), ('validation', '16965015')]:\n    H = feats(split, excl)\n    adm = set(pd.read_csv(f'{BASE}/{split}/raw/hosp/admissions.csv', dtype=str).subject_id)\n    H = H[H.index.isin(adm)]\n    print('===', split, 'excluded', excl, 'n_adm', len(H))\n    for c in ['hosp_rows', 'icu_rows', 'icu_chart', 'hosp_per_icu', 'hosp_per_chart', 'hosp_per_icuday',\n              'chart_per_icuday', 'labspan_per_icuday', 'labs_per_admday', 'icu_per_admday',\n              'lab_span', 'icu_days', 'adm_days']:\n        v = H[c].astype(float)\n        e = float(v[H.excl].iloc[0]) if H.excl.any() else None\n        o = v[~H.excl].sort_values()\n        if e is None:\n            continue\n        below = (o < e).sum(); above = (o > e).sum()\n        sep = 'MAX' if below == len(o) else ('MIN' if above == len(o) else f'mixed({below} below/{above} above)')\n        print(f'  {c:20s} excl={e:12.4f}  {sep}   incl range [{o.min():.4f},{o.max():.4f}]')\n    print()\n"}
