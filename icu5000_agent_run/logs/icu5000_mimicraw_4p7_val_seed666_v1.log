{"file_path": "/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/metric_models2.py", "content": "\"\"\"Find the scorer model: compare candidates on the train package (host validation scores in brackets).\"\"\"\nimport pandas as pd, numpy as np\nfrom collections import Counter\n\nBASE = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\nREF = BASE + '/train/reference'\nOUT = 'work/t_final'\nCASES = [\n    ('icu/inputevents.csv', ['subject_id', 'hadm_id', 'stay_id', 'starttime', 'itemid'],\n     ['subject_id', 'hadm_id', 'stay_id', 'itemid'], 0.526852),\n    ('icu/outputevents.csv', ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid'],\n     ['subject_id', 'hadm_id', 'stay_id', 'itemid'], 0.607692),\n    ('demographics.csv', ['subject_id'], ['subject_id'], 0.595833),\n    ('admissions.csv', ['subject_id', 'hadm_id'], ['subject_id', 'hadm_id'], 0.875962),\n]\n\n\ndef score(name, key_full, key_loose):\n    out = pd.read_csv(f'{OUT}/{name}', dtype=str, keep_default_na=False)\n    ref = pd.read_csv(f'{REF}/{name}', dtype=str, keep_default_na=False)\n    n_gold, n_out = len(ref), len(out)\n    cells = n_gold * len(ref.columns)\n    res = {}\n    for tag, key in (('fullkey', key_full), ('loosekey', key_loose)):\n        o = out.copy(); r = ref.copy()\n        o['__occ'] = o.groupby(key, dropna=False).cumcount()\n        r['__occ'] = r.groupby(key, dropna=False).cumcount()\n        m = o.merge(r, on=key + ['__occ'], how='outer', indicator=True, suffixes=('_o', '_r'))\n        both = m[m['_merge'] == 'both']\n        # exact cell accuracy over the gold cells (key columns count only for matched rows)\n        ok = 0\n        for c in ref.columns:\n            if c == '__occ':\n                continue\n            a = both[c + '_o'] if c + '_o' in both.columns else both[c]\n            b = both[c + '_r'] if c + '_r' in both.columns else both[c]\n            ok += int((a == b).sum())\n        res[tag + '_cellacc'] = round(ok / cells, 4)\n        # fraction of gold rows reproduced exactly (all cells)\n        exact = 0\n        for c in ref.columns:\n            if c == '__occ':\n                continue\n            a = both[c + '_o'] if c + '_o' in both.columns else both[c]\n            b = both[c + '_r'] if c + '_r' in both.columns else both[c]\n            exact = exact & (a == b)\n        res[tag + '_exactrows'] = round(int(exact.sum()) / n_gold, 4)\n        res[tag + '_matched'] = len(both)\n    # multiset F1 per column (order insensitive)\n    f1 = []\n    for c in ref.columns:\n        ca, cb = Counter(out[c]), Counter(ref[c])\n        inter = sum((ca & cb).values())\n        f1.append(2 * inter / (len(out[c]) + len(ref[c])) if len(out[c]) + len(ref[c]) else 1.0)\n    res['mean_col_multiset_F1'] = round(float(np.mean(f1)), 4)\n    res['host_validation_score'] = CASES[[c[0] for c in CASES].index(name)][4]\n    print(f'--- {name} (host validation {res[\"host_validation_score\"]})')\n    for k, v in res.items():\n        if k != 'host_validation_score':\n            print(f'      {k:28s} {v}')\n\n\nfor name, kf, kl, _ in CASES:\n    score(name, kf, kl)\n"}
