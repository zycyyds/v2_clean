{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/selfcheck.py","content":"#!/usr/bin/env python3\n\"\"\"Compare a produced result package against a reference package (cell level).\"\"\"\nimport sys, os, json\nimport pandas as pd, numpy as np\n\nFILES = [\"admissions.csv\", \"cohort.csv\", \"demographics.csv\", \"diagnoses.csv\",\n         \"procedures.csv\", \"medications.csv\", \"labs.csv\",\n         \"icu/icustays.csv\", \"icu/chartevents.csv\", \"icu/inputevents.csv\",\n         \"icu/outputevents.csv\", \"multimodal/ecg_manifest.csv\",\n         \"multimodal/ecg_measurements.csv\"]\n\n\ndef norm(v):\n    if v is None:\n        return \"\"\n    s = str(v).strip()\n    if s == \"\" or s.lower() == \"nan\":\n        return \"\"\n    try:\n        f = float(s)\n        return f\"{f:.10g}\"\n    except ValueError:\n        return s\n\n\ndef compare(out_dir, ref_dir, verbose=True, keycols=None):\n    total = {\"files\": {}, \"cell_acc\": 0, \"cell_tot\": 0, \"row_acc\": 0, \"row_tot\": 0}\n    for rel in FILES:\n        op = os.path.join(out_dir, rel)\n        rp = os.path.join(ref_dir, rel)\n        if not os.path.exists(op) or not os.path.exists(rp):\n            total[\"files\"][rel] = {\"missing\": True}\n            continue\n        o = pd.read_csv(op, dtype=str, keep_default_na=False)\n        r = pd.read_csv(rp, dtype=str, keep_default_na=False)\n        cols = [c for c in r.columns if c in o.columns]\n        missing_cols = [c for c in r.columns if c not in o.columns]\n        extra_cols = [c for c in o.columns if c not in r.columns]\n        okc = okr = 0\n        totc = totr = 0\n        # align on all shared columns as key\n        kc = keycols.get(rel) if keycols else None\n        if kc is None:\n            kc = [c for c in cols if c in (\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\",\n                                           \"itemid\", \"seq_num\", \"study_id\", \"ecg_time\",\n                                           \"starttime\", \"cart_id\", \"drug\", \"file_name\")]\n            kc = [c for c in kc if c in cols]\n        on = [c for c in kc if c in cols]\n        o2 = o.copy(); r2 = r.copy()\n        for c in on:\n            o2[c] = o2[c].map(norm); r2[c] = r2[c].map(norm)\n        oi = o2.set_index(on) if on else o2\n        ri = r2.set_index(on) if on else r2\n        idx_r = ri.index\n        idx_o = oi.index\n        matched = idx_r.intersection(idx_o)\n        for c in cols:\n            if c in on:\n                continue\n            totc += len(idx_o)\n            totr += len(idx_r)\n            if len(matched):\n                a = oi.loc[matched, c].map(norm) if len(matched) else pd.Series(dtype=str)\n                b = ri.loc[matched, c].map(norm) if len(matched) else pd.Series(dtype=str)\n                okc += int((a.values == b.values).sum())\n                okr += int((a.values == b.values).sum())\n        totc += len(idx_o); totr += len(idx_r)\n        okc += len(matched); okr += len(matched)\n        f = {\"out_rows\": len(o), \"ref_rows\": len(r), \"matched_keys\": len(matched),\n             \"missing_keys\": len(idx_r) - len(matched),\n             \"extra_keys\": len(idx_o) - len(matched),\n             \"cell_prec\": round(okc / totc, 4) if totc else None,\n             \"cell_rec\": round(okr / totr, 4) if totr else None,\n             \"missing_cols\": missing_cols, \"extra_cols\": extra_cols}\n        total[\"files\"][rel] = f\n        total[\"cell_acc\"] += okc; total[\"cell_tot\"] += totc\n        total[\"row_acc\"] += len(matched); total[\"row_tot\"] += len(idx_r)\n        if verbose:\n            print(f\"{rel:38s} out={len(o):7d} ref={len(r):7d} matched={len(matched):7d} \"\n                  f\"missing={f['missing_keys']:6d} extra={f['extra_keys']:6d} \"\n                  f\"cellP={f['cell_prec']} cellR={f['cell_rec']}\")\n    print(f\"\\nTOTAL cell precision {total['cell_acc']}/{total['cell_tot']} = \"\n          f\"{total['cell_acc']/max(total['cell_tot'],1):.4f}   \"\n          f\"row recall {total['row_acc']}/{total['row_tot']} = \"\n          f\"{total['row_acc']/max(total['row_tot'],1):.4f}\")\n    return total\n\n\nif __name__ == \"__main__\":\n    out = sys.argv[1]\n    ref = sys.argv[2]\n    compare(out, ref)\n"}
