{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/oe_offsets.py","content":"\"\"\"Pick the best outputevents charttime estimator on train.\"\"\"\nimport pandas as pd, numpy as np\nBASE = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\nraw = pd.read_csv(BASE + '/train/raw/icu/outputevents.csv', dtype=str, keep_default_na=False, na_values=[''])\nref = pd.read_csv(BASE + '/train/reference/icu/outputevents.csv', dtype=str, keep_default_na=False)\nstays = pd.read_csv(BASE + '/train/raw/icu/icustays.csv', dtype=str, keep_default_na=False)\nvalid = set(stays['stay_id'])\nraw['stay_id'] = raw['stay_id'].map(lambda v: v[1:] if (isinstance(v, str) and v.startswith('9') and v[1:] in valid) else v)\nraw['hadm_id'] = raw['stay_id'].map(stays.set_index('stay_id')['hadm_id'])\nraw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\nraw['storetime'] = pd.to_datetime(raw['storetime'], errors='coerce')\nref['charttime'] = pd.to_datetime(ref['charttime'], errors='coerce')\nfor d in (raw, ref):\n    d['subject_id'] = d['subject_id'].astype(str); d['stay_id'] = d['stay_id'].astype(str)\n    d['itemid'] = d['itemid'].astype(str)\n\npairs = []\nfor key, sub in raw.groupby(['subject_id', 'stay_id', 'itemid']):\n    r = ref[(ref['subject_id'] == key[0]) & (ref['stay_id'] == key[1]) & (ref['itemid'] == key[2])].copy()\n    r['ord'] = r['charttime'].rank(method='first')\n    r = r.sort_values(['value', 'ord'])\n    s2 = sub.copy(); s2['ord'] = range(len(s2)); s2 = s2.sort_values(['value', 'ord'])\n    if len(r) != len(s2):\n        continue\n    for i in range(len(s2)):\n        pairs.append({'store': s2.iloc[i]['storetime'], 'ref_ct': r.iloc[i]['charttime'],\n                      'grp': key[1] + '|' + key[2], 'itemid': key[2]})\np = pd.DataFrame(pairs)\n# multi-row groups (same stay,itemid,storetime) -> backfill candidates\nsz = raw.groupby(['stay_id', 'itemid', 'storetime']).size().rename('grp_n').reset_index()\np = p.merge(sz, left_on=['grp', 'store'], right_on=['stay_id', 'itemid', 'storetime'], how='left')\nprint('rows', len(p), ' in multi-row groups:', int((p['grp_n'] > 1).sum()))\n\n\ndef acc(fn, mask=None):\n    m = pd.Series(True, index=p.index) if mask is None else mask\n    pred = p['store'].map(fn)\n    return round(float((pred[m] == p['ref_ct'][m]).mean()), 4), int(m.sum())\n\n\nprint('\\nestimators (all rows):')\nfor off in [0, 5, 10, 15, 20, 25, 30, 35, 40, 45, 60]:\n    a, n = acc(lambda s, o=off: (s - pd.Timedelta(minutes=o)).dt.floor('h'))\n    print(f'  floor(store - {off:3d} min, h): {a:.4f}')\nprint('  store exact              :', acc(lambda s: s)[0])\nprint('  floor(store,15min)       :', acc(lambda s: s.dt.floor('15min'))[0])\nprint('  floor(store,30min)       :', acc(lambda s: s.dt.floor('30min'))[0])\n\nprint('\\nestimators (single-row groups only):')\nm1 = p['grp_n'] == 1\nfor off in [0, 15, 30, 45]:\n    a, n = acc(lambda s, o=off: (s - pd.Timedelta(minutes=o)).dt.floor('h'), m1)\n    print(f'  floor(store - {off:3d} min, h): {a:.4f}  (n={n})')\nprint('\\nestimators (multi-row groups only):')\nm2 = p['grp_n'] > 1\nfor off in [0, 15, 30, 45]:\n    a, n = acc(lambda s, o=off: (s - pd.Timedelta(minutes=o)).dt.floor('h'), m2)\n    print(f'  floor(store - {off:3d} min, h): {a:.4f}  (n={n})')\n\n# backfill rule: within a (stay,itemid,storetime) group, rows are charted hourly ending at the storetime\nprint('\\nbackfill rule on multi-row groups:')\nfor m in (m2,):\n    sub = p[m].copy()\n    hits = 0\n    for (g, s), gg in sub.groupby(['grp', 'store']):\n        n = len(gg)\n        base = s.floor('h')\n        cand = [base - pd.Timedelta(hours=k) for k in range(n)]\n        # the reference charttimes of that group (sorted) - how many of the candidates match?\n        refs = sorted(gg['ref_ct'].tolist())\n        hits += len(set(refs) & set(cand))\n    print(f'  candidate set covers the true charttimes for {hits}/{len(sub)} rows')\n"}
