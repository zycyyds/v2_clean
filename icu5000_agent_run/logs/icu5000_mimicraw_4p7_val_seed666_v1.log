def remap_category(series, func):
    """apply func to the categories of a categorical column and rebuild it"""
    if not isinstance(series.dtype, pd.CategoricalDtype):
        return series.map(func)
    cats = list(series.cat.categories)
    new = [func(c) for c in cats]
    # unique new categories
    uniq = list(dict.fromkeys(new))
    index = {v: i for i, v in enumerate(uniq)}
    codes = np.array([index[v] for v in new], dtype=np.int32)
    newcodes = codes[series.cat.codes.to_numpy()]
    newcodes[newcodes < 0] = -1
    return pd.Categorical.from_codes(newcodes, categories=uniq)
```
