{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/ie_link.py","content":"\"\"\"Do successive deliveries of one linkorderid chain end->start in the reference?\"\"\"\nimport pandas as pd, numpy as np, re\n\nB = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\nraw = pd.read_csv(B + '/train/raw/icu/inputevents.csv', dtype=str, keep_default_na=False, na_values=[''])\nref = pd.read_csv(B + '/train/reference/icu/inputevents.csv', dtype=str, keep_default_na=False)\nstays = pd.read_csv(B + '/train/raw/icu/icustays.csv', dtype=str, keep_default_na=False)\nvalid = set(stays['stay_id'])\nraw['itemid'] = raw['itemid'].map(lambda s: '2' + s[3:] if isinstance(s, str) and re.fullmatch(r'992\\d{5}', s) else s)\nraw['stay_id'] = raw['stay_id'].map(lambda v: v[1:] if (isinstance(v, str) and v.startswith('9') and v[1:] in valid) else v)\nraw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\nfor c in ['starttime', 'endtime', 'storetime']:\n    raw[c] = pd.to_datetime(raw[c], errors='coerce')\nref['starttime'] = pd.to_datetime(ref['starttime'], errors='coerce')\nref['endtime'] = pd.to_datetime(ref['endtime'], errors='coerce')\nfor d in (raw, ref):\n    d['subject_id'] = d['subject_id'].astype(str); d['stay_id'] = d['stay_id'].astype(str)\n    d['itemid'] = d['itemid'].astype(str)\n\nprint('linkorderid distinct:', raw['linkorderid'].nunique(), 'orderid distinct:', raw['orderid'].nunique())\nprint('rows per linkorderid:', raw.groupby('linkorderid').size().value_counts().to_dict())\nprint('rows per orderid   :', raw.groupby('orderid').size().value_counts().to_dict())\nprint()\n\n# reference endtime for each raw row (match by subject,stay,itemid,starttime)\npairs = []\nfor key, sub in raw.groupby(['subject_id', 'stay_id', 'itemid', 'starttime']):\n    r = ref[(ref.subject_id == key[0]) & (ref.stay_id == key[1]) & (ref.itemid == key[2]) &\n             (ref.starttime == key[3])]\n    if len(r) != len(sub):\n        continue\n    for i in range(len(sub)):\n        pairs.append({**sub.iloc[i].to_dict(), 'ref_amount': r.iloc[i]['amount'],\n                      'ref_end': r.iloc[i]['endtime']})\np = pd.DataFrame(pairs)\nfor c in ['amount', 'originalamount', 'rate']:\n    p[c + '_n'] = pd.to_numeric(p[c], errors='coerce')\np['ref_amount_n'] = pd.to_numeric(p['ref_amount'], errors='coerce')\np['dur_min'] = (p['ref_end'] - p['starttime']).dt.total_seconds() / 60\n\n# within a linkorderid, does ref_end[i] == starttime[i+1]?\nhits = tot = 0\ndeltas = []\nfor lo, sub in p.groupby('linkorderid'):\n    sub = sub.sort_values('starttime')\n    if len(sub) < 2:\n        continue\n    rows = sub.to_dict('records')\n    for a, b in zip(rows, rows[1:]):\n        tot += 1\n        d = (b['starttime'] - a['ref_end']).total_seconds() / 60\n        deltas.append(d)\n        hits += int(abs(d) <= 1)\nprint(f'consecutive deliveries in a linkorderid: {tot}; |next start - prev ref_end| <= 1 min: {hits} ({hits/max(tot,1):.3f})')\nif deltas:\n    s = pd.Series(deltas)\n    print('delta (min) value counts (top 10):'); print(s.round(0).value_counts().head(10).to_string())\n    print('delta <= 1 min share :', round(float((s.abs() <= 1).mean()), 4))\n    print('delta <= 5 min share :', round(float((s.abs() <= 5).mean()), 4))\n    print('delta <= 60 min share:', round(float((s.abs() <= 60).mean()), 4))\n    print('delta == 0 share     :', round(float((s == 0).mean()), 4))\nprint()\n# does the same hold for orderid groups?\nhits = tot = 0\nfor oid, sub in p.groupby('orderid'):\n    sub = sub.sort_values('starttime')\n    if len(sub) < 2:\n        continue\n    rows = sub.to_dict('records')\n    for a, b in zip(rows, rows[1:]):\n        tot += 1\n        hits += int(abs((b['starttime'] - a['ref_end']).total_seconds()) <= 60)\nprint(f'orderid groups: consecutive pairs {tot}, |delta| <= 1h: {hits}')\nprint()\nprint('statusdescription values:', p['statusdescription'].value_counts().head(8).to_dict())\nprint('rate rows by status:')\npr = p[p.rate_n > 0].copy()\npr['ratio'] = pr.ref_amount_n / pr.originalamount_n.replace(0, np.nan)\nfor st, g in pr.groupby('statusdescription'):\n    print(f'   {str(st)[:28]:30s} n={len(g):5d}  ratio==1: {float((g.ratio.round(3) == 1.0).mean()):.3f}  '\n          f'dur==orig/rate: {float(np.isclose((g.originalamount_n/g.rate_n*60).round(), g.dur_min, atol=0.5).mean()):.3f}')\n"}
