pe=object)\n        st = pd.to_datetime(ce[\"storetime\"], errors=\"coerce\")\n        fallback = st.dt.floor(\"h\").dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n        fallback = fallback.fillna(ce[\"charttime\"])\n        guess = pd.Series(sess.to_numpy(), index=ce.index).astype(object)\n        guess = guess.where(guess.notna() & (guess != \"\"), fallback)\n        return guess\n\n    def _fix_valuenum(self, ce, raw_vn, vn_num):\n        \"\"\"repair the injected valuenum errors\n\n        * value text numeric and different from valuenum -> the value text is the\n          true measurement (unit scale x100, sentinel codes, -1 style codes)\n        * value text not numeric (descriptive chart row) -> a sentinel code or a\n          zero in valuenum is injected garbage, the original value was empty\n        \"\"\"\n        vt = self._value_numbers(ce)\n        numeric_text = vt.notna()\n        same = (vn_num == vt) | (vn_num.isna() & vt.isna())\n        use_vt = numeric_text & ~same\n        if use_vt.any():\n            ce.loc[use_vt, \"valuenum\"] = vt[use_vt].map(fmt_float)\n        # text rows: sentinels and zeros are injected garbage -> empty\n        vn2 = to_num(ce[\"valuenum\"])\n        text = ~numeric_text.to_numpy()\n        garbage = text & (vn2.isin(SENTINEL_VALUES).to_numpy() | (vn2 == 0).to_numpy())\n        if garbage.any():\n            ce.loc[garbage, \"valuenum\"] = \"\"\n        return ce\n\n    @staticmethod\n    def _value_numbers(ce):\n        \"\"\"numeric value of the chart 'value' text column (NaN when it is text)\"\"\"\n        val = ce[\"value\"]\n        if isinstance(val.dtype, pd.CategoricalDtype):\n            parsed = [parse_float(c) for c in val.cat.categories]\n            has = {i: p for i, p in enumerate(parsed) if p is not None}\n            codes = val.cat.codes.to_numpy()\n            out = np.full(len(codes), np.nan)\n            if has:\n                idx = np.array([has.get(i, -1) for i in range(len(parsed))], dtype=np.int64)\n                vals = np.array([p if p is not None else np.nan for p in parsed], dtype=float)\n                pos = np.clip(idx, 0, None)\n                out = vals[pos]\n                out[idx < 0] = np.nan\n            return pd.Series(out, index=ce.index)\n        return val.map(parse_float)\n\n    def _usable_mask(self, ce):\n        \"\"\"readings that may enter the median pool of a (subject, itemid):\n        not a sentinel code, not zero and - for the items with a physiological\n        range - inside that range\"\"\"\n        vals = to_num(ce[\"valuenum\"])\n        ok = vals.notna() & ~vals.isin(SENTINEL_VALUES) & (vals != 0)\n        lo = ce[\"itemid\"].map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[0])\n        hi = ce[\"itemid\"].map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[1])\n        ranged = lo.notna()\n        inside = (vals >= lo) & (vals <= hi)\n        ok = ok & (~ranged.to_numpy() | inside.to_numpy())\n        return ok, vals\n\n    def _fix_native(self, ce):\n        \"\"\"native MIMIC errors: value == valuenum but outside the physiological range\n        (or a sentinel code) -> replace by the patient's median for that item.\"\"\"\n        vals = to_num(ce[\"valuenum\"])\n        vt = self._value_numbers(ce)\n        lo = ce[\"itemid\"].map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[0])\n        hi = ce[\"itemid\"].map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[1])\n        oor = vals.notna() & lo.notna() & ((vals < lo) | (vals > hi)) & (vals != 0)\n        sent = vals.isin(SENTINEL_VALUES)\n        native = vt.notna() & vals.notna() & (vt == vals) & (oor | sent)\n        if native.any():\n            ok, _ = self._usable_mask(ce)\n            work = ce.copy()\n            work[\"_v\"] = vals.where(ok)\n            med = work.groupby([\"subject_id\", \"itemid\"], observed=True)[\"_v\"].median()\n            repl = work.groupby([\"subject_id\", \"itemid\"], observed=True)[\"_v\"].transform(\"median\")\n            with np.errstate(divide=\"ignore\", invalid=\"ignore\"):\n                dev = (vals - repl).abs() / repl.abs()\n            dev = dev.where(repl != 0, np.inf)\n            use = native & repl.notna() & (dev >= 0.20)\n            if use.any():\n                ce.loc[use, \"valuenum\"] = repl[use].map(fmt_float)\n        return ce\n\n'''\ns = s[:start] + new + s[end:]\nopen(p,'w').write(s)\nprint(\"patched\")\nPY\npython3 scripts/replay.py --raw_root /Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47/train/raw --output_dir artifacts/train_out --train_reference /Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47/train/reference 2>&1 | tail -20","description":"Rewrite chartevents processing with memory-efficient ops"}
