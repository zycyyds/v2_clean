atus description rule\nprint(\"\\nstatusdescription vs the gold duration (rate rows):\")\nfor sd, g in mm[hr].groupby(\"statusdescription\"):\n    print(\"  \", sd, \"n=\", len(g), \"dur_g top:\", g.dur_g.value_counts().head(3).to_dict(),\n          \" current ok:\", int(((g.index.map(dur_cur) == g.dur_g).sum())))\n"}
