    @staticmethod
    def _recover_charttime(ce, bad):
        """the true charttime of a corrupted row is not recoverable; use the
        charttime of the charting session (same patient/stay/storetime/caregiver)
        when it is unique, otherwise the hour of the storetime."""
        key = ce[["subject_id", "stay_id", "storetime", "caregiver_id"]]
        h = pd.util.hash_pandas_object(key, index=False).to_numpy()
        ct = ce["charttime"].to_numpy()
        keep = ~bad.to_numpy()
        sub = pd.DataFrame({"h": h[keep], "ct": ct[keep]})
        if len(sub):
            grp = sub.groupby("h")["ct"]
            first = grp.first()
            nuni = grp.nunique()
            uniq = first[nuni == 1]
            sess = pd.Series(h).map(uniq).to_numpy()
        else:
            sess = np.full(len(h), np.datetime64("NaT"), dtype="datetime64[ns]")
        st = pd.to_datetime(ce["storetime"], errors="coerce").dt.floor("h").to_numpy()
        guess = np.where(np.isnat(sess), st, sess)
        out = ce["charttime"].copy()
        mask = bad.to_numpy()
        out[mask] = guess[mask]
        return out

    def _fix_valuenum(self, ce, vn_num):
        """repair the injected valuenum errors

        * value text numeric and different from valuenum -> the value text is the
          true measurement (unit scale x100, sentinel codes, -1 style codes)
        * value text not numeric (descriptive chart row) -> a sentinel code or a
          zero in valuenum is injected garbage, the original value was empty
        """
        vt = self._value_numbers(ce)
        numeric_text = vt.notna()
        same = (vn_num == vt) | (vn_num.isna() & vt.isna())
        use_vt = numeric_text & ~same

