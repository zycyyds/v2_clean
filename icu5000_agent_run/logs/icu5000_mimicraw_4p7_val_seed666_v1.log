    # ------------------------------------------------------------- icu tables
    def build_inputevents(self):
        i = self.r["inputevents"].copy()
        i["itemid"] = map_categorical(i["itemid"], unalias_itemid)
        i["hadm_id"] = map_categorical(i["stay_id"], lambda s: self.stay2hadm.get(s, s))
        # `amount` was destroyed (sentinel code, or the total amount was copied
        # over it) -> originalamount / totalamount still carry the true value
        amt = self._input_amount(i)
        # `endtime` was shifted one minute into the past (endtime < starttime):
        # a bolus ends one minute after it starts, an infusion ends after the
        # duration implied by amount / rate.
        i["endtime"] = self._input_endtime(i, amt)
        i["amount"] = amt
        cols = ["subject_id", "hadm_id", "stay_id", "starttime", "endtime", "itemid", "amount"]
        i = i[cols].reset_index(drop=True)
        self.r["inputevents_out"] = i
        return i

    def _input_amount(self, i):
        amt = to_num(i.amount)
        rate = to_num(i.rate)
        tot = to_num(i.totalamount)
        orig = to_num(i.originalamount)
        dur_h = (pd.to_datetime(i.endtime, errors="coerce") -
                 pd.to_datetime(i.starttime, errors="coerce")).dt.total_seconds() / 3600.0
        f, w = self._rate_factors(i)
        calc = rate * dur_h * f * w
        use_calc = rate.notna() & (dur_h > 0) & calc.notna()
        out = orig.where(orig.notna(), tot)
        out = out.where(out.notna(), calc.where(use_calc, amt))
        return as_float_col(out.map(fmt_float))

    @staticmethod
    def _rate_factors(i):
        per_kg = category_flags(i.rateuom, lambda u: "/kg" in str(u).lower())
        per_min = category_flags(i.rateuom, lambda u: "/min" in str(u).lower())
        mcg2mg = (category_flags(i.rateuom, lambda u: str(u).lower().startswith("mcg")) &
                  category_flags(i.amountuom, lambda u: str(u).lower().startswith("mg")))
        f = pd.Series(1.0, index=i.index)
        f = f * np.where(per_min, 60.0, 1.0)
        f = f / np.where(mcg2mg, 1000.0, 1.0)
        w = to_num(i.patientweight).where(pd.Series(per_kg, index=i.index), 1.0)
        return f, w

    def _input_endtime(self, i, amt):
        st = pd.to_datetime(i.starttime, errors="coerce")
        rate = to_num(i.rate)
        f, w = self._rate_factors(i)
        dur = amt / (rate * f * w)
        has = rate.notna() & dur.notna() & (dur > 0) & (dur < 24 * 60)
        end = st + pd.to_timedelta(dur * 3600.0, unit="s")
        end = end.where(has, st + pd.Timedelta(seconds=60))
        out = end.dt.strftime("%Y-%m-%d %H:%M:%S")
        return out.fillna(i.endtime)

    def build_outputevents(self):
        o = self.r["outputevents"].copy()
        o["itemid"] = map_categorical(o["itemid"], unalias_itemid)

