{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/icu5000_pipeline.py","content":"#!/usr/bin/env python3\n\"\"\"\nICU5000 cleaning pipeline (replayable).\n\n    python3 icu5000_pipeline.py --raw_root {raw_root} --output_dir {output_dir}\n\nReads a raw MIMIC-IV slice (hosp/, icu/, ecg/, note/) and writes the 13 file\nICU5000 result package.  Every rule below was derived by diffing the train\nraw slice against the train reference package (see train_analysis.json).\n\"\"\"\nimport os\nimport re\nimport sys\nimport json\nimport argparse\nfrom collections import Counter, defaultdict\n\nimport numpy as np\nimport pandas as pd\n\n# --------------------------------------------------------------------------\n# rule tables (all derived from the train raw <-> reference comparison)\n# --------------------------------------------------------------------------\n\n# physiologically impossible ranges for icu/chartevents valuenum (native MIMIC errors)\nIMPOSSIBLE_RANGE = {\n    \"220045\": (20, 300), \"220050\": (40, 400), \"220051\": (20, 250), \"220052\": (20, 250),\n    \"220059\": (0, 150), \"220061\": (0, 100), \"220074\": (-20, 80), \"220179\": (40, 400),\n    \"220180\": (20, 250), \"220181\": (20, 250), \"220210\": (0, 100), \"223762\": (25, 45),\n    \"224688\": (0, 100), \"224689\": (0, 100), \"224690\": (0, 100), \"227466\": (8, 200),\n    \"224167\": (40, 400), \"224643\": (20, 250), \"227242\": (20, 250), \"227243\": (40, 400),\n}\n\n# MIMIC / CareVue placeholder codes that are never real measurements\nSENTINEL_VALUES = {-999, -998, -997, -990, 9999, 99999, 999999, 9999999,\n                    220000, 220045}\n\nEPOCH = \"1970-01-01 00:00:00\"\nALIAS_RE = re.compile(r\"^99[23]\\d{5}$\")\n\n\n# --------------------------------------------------------------------------\n# helpers\n# --------------------------------------------------------------------------\ndef read_csv(path):\n    return pd.read_csv(path, dtype=str, keep_default_na=False)\n\n\ndef to_num(s):\n    if isinstance(s, pd.Series):\n        return pd.to_numeric(s.replace(\"\", np.nan), errors=\"coerce\")\n    return pd.to_numeric(pd.Series([s]).replace(\"\", np.nan), errors=\"coerce\").iloc[0]\n\n\ndef parse_float(v):\n    \"\"\"numeric value of a chart 'value' text cell (None when it is not numeric)\"\"\"\n    if v is None:\n        return None\n    s = str(v).strip()\n    if s == \"\" or s.lower() in (\"none\", \"nan\", \"null\"):\n        return None\n    try:\n        return float(s)\n    except ValueError:\n        return None\n\n\ndef ts(s):\n    if not s:\n        return None\n    try:\n        return pd.Timestamp(s)\n    except Exception:\n        return None\n\n\ndef fmt(t):\n    return t.strftime(\"%Y-%m-%d %H:%M:%S\")\n\n\ndef unalias_itemid(v):\n    \"\"\"CareVue alias injection: 992{2|3}XXXX -> 2{2|3}XXXX (train: 99220045->220045)\"\"\"\n    if isinstance(v, str) and ALIAS_RE.match(v):\n        return \"2\" + v[3] + v[-4:]\n    return v\n\n\ndef unalias_series(s):\n    return s.map(unalias_itemid)\n\n\ndef as_float_col(s):\n    \"\"\"numeric output column: float64 with NaN for empty (reference formatting)\"\"\"\n    return pd.to_numeric(s.replace(\"\", np.nan), errors=\"coerce\")\n\n\ndef fmt_float(x):\n    if x is None or (isinstance(x, float) and np.isnan(x)):\n        return \"\"\n    return repr(float(x))\n\n\n# --------------------------------------------------------------------------\nclass Pipeline:\n    def __init__(self, raw_root, out_root):\n        self.raw = raw_root\n        self.out = out_root\n        self.r = {}\n        self.report = {}\n\n    # ---------------------------------------------------------------- load\n    def load(self):\n        j = lambda *p: os.path.join(self.raw, *p)\n        self.r[\"admissions\"] = read_csv(j(\"hosp\", \"admissions.csv\"))\n        self.r[\"patients\"] = read_csv(j(\"hosp\", \"patients.csv\"))\n        self.r[\"diagnoses_icd\"] = read_csv(j(\"hosp\", \"diagnoses_icd.csv\"))\n        self.r[\"procedures_icd\"] = read_csv(j(\"hosp\", \"procedures_icd.csv\"))\n        self.r[\"prescriptions\"] = read_csv(j(\"hosp\", \"prescriptions.csv\"))\n        self.r[\"labevents\"] = read_csv(j(\"hosp\", \"labevents.csv\"))\n        self.r[\"icustays\"] = read_csv(j(\"icu\", \"icustays.csv\"))\n        self.r[\"chartevents\"] = read_csv(j(\"icu\", \"chartevents.csv\"))\n        self.r[\"inputevents\"] = read_csv(j(\"icu\", \"inputevents.csv\"))\n        self.r[\"outputevents\"] = read_csv(j(\"icu\", \"outputevents.csv\"))\n        self.r[\"ecg_list\"] = read_csv(j(\"ecg\", \"record_list.csv\"))\n        self.r[\"ecg_meas\"] = read_csv(j(\"ecg\", \"machine_measurements.csv\"))\n        self.r[\"note_discharge\"] = read_csv(j(\"note\", \"discharge.csv\"))\n\n    # ------------------------------------------------------- icu/icustays\n    def fix_icustays(self):\n        \"\"\"outtime was pushed one hour before intime (time order reversal).\n        `los` survived the injection -> recompute outtime = intime + los.\"\"\"\n        ic = self.r[\"icustays\"].copy()\n        outs, loss = [], []\n        for row in ic.itertuples():\n            intime = ts(row.intime)\n            los = float(row.los) if row.los not in (\"\", None) else None\n            out = None\n            if intime is not None and los is not None and los > 0:\n                out = intime + pd.Timedelta(seconds=round(los * 86400))\n            if out is None:\n                out = ts(row.outtime)\n            outs.append(fmt(out))\n            loss.append((out - intime).total_seconds() / 86400.0)\n        ic[\"outtime\"] = outs\n        ic[\"los\"] = loss\n        self.r[\"icustays\"] = ic\n        self.stay2hadm = dict(zip(ic.stay_id, ic.hadm_id))\n        self.stay_out = dict(zip(ic.stay_id, ic.outtime))\n        self.known_stays = set(ic.stay_id)\n        return ic\n\n    # ------------------------------------------------------------- cohort\n    def build_cohort(self):\n        \"\"\"ICU stays that have a hospital admission and ICU input events.\"\"\"\n        ic = self.r[\"icustays\"]\n        adm = self.r[\"admissions\"]\n        adm_keys = set(zip(adm.subject_id, adm.hadm_id))\n        inp = self.r[\"inputevents\"]\n        has_input = set(inp.stay_id) if len(inp) else set()\n        rows = []\n        for row in ic.itertuples():\n            if (row.subject_id, row.hadm_id) not in adm_keys:\n                continue\n            if has_input and row.stay_id not in has_input:\n                continue\n            rows.append((row.subject_id, row.hadm_id, row.stay_id))\n        coh = pd.DataFrame(rows, columns=[\"subject_id\", \"hadm_id\", \"stay_id\"])\n        coh = coh.drop_duplicates(subset=[\"subject_id\", \"hadm_id\"]).reset_index(drop=True)\n        self.cohort = coh\n        self.cohort_subj = set(coh.subject_id)\n        self.cohort_hadm = set(coh.hadm_id)\n        return coh\n\n    # ----------------------------------------------------------- admissions\n    def build_admissions(self):\n        adm = self.r[\"admissions\"].copy()\n        adm = adm[adm.hadm_id.isin(self.cohort_hadm)].copy()\n        # hospital_expire_flag was flipped (label leakage) -> recompute from deathtime\n        adm[\"hospital_expire_flag\"] = np.where(adm.deathtime.astype(str).str.strip() != \"\", 1, 0)\n        cols = [\"subject_id\", \"hadm_id\", \"admittime\", \"dischtime\", \"deathtime\",\n                \"admission_type\", \"admission_location\", \"discharge_location\",\n                \"insurance\", \"language\", \"marital_status\", \"race\",\n                \"hospital_expire_flag\"]\n        adm = adm[cols].reset_index(drop=True)\n        self.r[\"admissions_out\"] = adm\n        return adm\n\n    # --------------------------------------------------------- demographics\n    def build_demographics(self):\n        pa = self.r[\"patients\"].copy()\n        pa = pa[pa.subject_id.isin(self.cohort_subj)].copy()\n        sex = self._sex_from_notes()\n        pa[\"gender\"] = [sex.get(s, g) for s, g in zip(pa.subject_id, pa.gender)]\n        pa[\"gender\"] = pa.gender.replace({\"UNKNOWN_GENDER_CODE\": \"\", \"UNKNOWN\": \"\"})\n        pa[\"anchor_age\"] = pa.anchor_age.replace({\"999\": \"\"})\n        cols = [\"subject_id\", \"gender\", \"anchor_age\", \"anchor_year\",\n                \"anchor_year_group\", \"dod\"]\n        pa = pa[cols].reset_index(drop=True)\n        self.r[\"demographics_out\"] = pa\n        return pa\n\n    def _sex_from_notes(self):\n        out = {}\n        for row in self.r[\"note_discharge\"].itertuples():\n            m = re.search(r\"Sex:\\s*([MF])\\b\", row.text or \"\")\n            if m:\n                out.setdefault(row.subject_id, m.group(1))\n        return out\n\n    # ------------------------------------------------------------ diagnoses\n    def build_diagnoses(self):\n        d = self.r[\"diagnoses_icd\"].copy()\n        d = d[d.hadm_id.isin(self.cohort_hadm)].copy()\n        d[\"icd_code\"] = d.icd_code.str.replace(r\"^ALIAS_\", \"\", regex=True)\n        cols = [\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\", \"icd_version\"]\n        d = d[cols].reset_index(drop=True)\n        self.r[\"diagnoses_out\"] = d\n        return d\n\n    # ----------------------------------------------------------- procedures\n    def build_procedures(self):\n        d = self.r[\"procedures_icd\"].copy()\n        d = d[d.hadm_id.isin(self.cohort_hadm)].copy()\n        d[\"icd_code\"] = d.icd_code.str.replace(r\"^ALIAS_\", \"\", regex=True)\n        cols = [\"subject_id\", \"hadm_id\", \"seq_num\", \"icd_code\", \"icd_version\"]\n        d = d[cols].reset_index(drop=True)\n        self.r[\"procedures_out\"] = d\n        return d\n\n    # ---------------------------------------------------------- medications\n    def build_medications(self):\n        p = self.r[\"prescriptions\"].copy()\n        p = p[p.hadm_id.isin(self.cohort_hadm)].copy()\n        cols = [\"subject_id\", \"hadm_id\", \"starttime\", \"stoptime\", \"drug\",\n                \"dose_val_rx\", \"dose_unit_rx\", \"route\"]\n        p = p[cols].reset_index(drop=True)\n        self.r[\"medications_out\"] = p\n        return p\n\n    # ---------------------------------------------------------------- labs\n    def build_labs(self):\n        l = self.r[\"labevents\"].copy()\n        l = l[l.hadm_id.isin(self.cohort_hadm)].copy()\n        l[\"itemid\"] = unalias_series(l.itemid)\n        vn = to_num(l.valuenum)\n        vt = l.value.map(parse_float)\n        # injected unit-scale / sentinel values -> the value text column is the clue\n        fix = vn.notna() & vt.notna() & (vn != vt)\n        if fix.any():\n            l.loc[fix, \"valuenum\"] = vt[fix].map(fmt_float)\n        l[\"valuenum\"] = as_float_col(l.valuenum)\n        cols = [\"subject_id\", \"hadm_id\", \"itemid\", \"charttime\", \"valuenum\", \"valueuom\"]\n        l = l[cols].reset_index(drop=True)\n        self.r[\"labs_out\"] = l\n        return l\n\n    # ------------------------------------------------------------- icu tables\n    def build_inputevents(self):\n        i = self.r[\"inputevents\"].copy()\n        i[\"itemid\"] = unalias_series(i.itemid)\n        i[\"hadm_id\"] = i.stay_id.map(self.stay2hadm).fillna(i.hadm_id)\n        # endtime was shifted one minute into the past (endtime < starttime)\n        st = pd.to_datetime(i.starttime, errors=\"coerce\")\n        et = pd.to_datetime(i.endtime, errors=\"coerce\")\n        bad = (et < st) & st.notna() & et.notna()\n        i.loc[bad, \"endtime\"] = (st[bad] + pd.Timedelta(seconds=60)).dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n        # amount: sentinel / totalamount substitution -> rate x duration x unit factor\n        amount = self._input_amount(i)\n        i[\"amount\"] = amount\n        cols = [\"subject_id\", \"hadm_id\", \"stay_id\", \"starttime\", \"endtime\", \"itemid\", \"amount\"]\n        i = i[cols].reset_index(drop=True)\n        self.r[\"inputevents_out\"] = i\n        return i\n\n    @staticmethod\n    def _unit_factor(rateuom, amountuom):\n        \"\"\"rate unit -> amount unit factor (MIMIC stores rates per kg / per min / mcg).\"\"\"\n        ru = (rateuom or \"\").strip().lower()\n        au = (amountuom or \"\").strip().lower()\n        f = 1.0\n        if \"/kg\" in ru:\n            f *= None      # handled by the caller (patient weight)\n        if \"/min\" in ru:\n            f *= 60.0\n        if ru.startswith(\"mcg\") and au.startswith(\"mg\"):\n            f /= 1000.0\n        elif ru.startswith(\"mg\") and au.startswith(\"mcg\"):\n            f *= 1000.0\n        return f\n\n    def _input_amount(self, i):\n        amt = to_num(i.amount)\n        rate = to_num(i.rate)\n        weight = to_num(i.patientweight)\n        tot = to_num(i.totalamount)\n        orig = to_num(i.originalamount)\n        dur_h = (pd.to_datetime(i.endtime, errors=\"coerce\") -\n                 pd.to_datetime(i.starttime, errors=\"coerce\")).dt.total_seconds() / 3600.0\n        f = pd.Series(1.0, index=i.index)\n        per_kg = i.rateuom.fillna(\"\").str.lower().str.contains(\"/kg\")\n        f = f.where(~per_kg, f)\n        mins = i.rateuom.fillna(\"\").str.lower().str.contains(\"/min\")\n        f = f * np.where(mins, 60.0, 1.0)\n        mcg2mg = (i.rateuom.fillna(\"\").str.lower().str.startswith(\"mcg\") &\n                  i.amountuom.fillna(\"\").str.lower().str.startswith(\"mg\"))\n        f = f / np.where(mcg2mg, 1000.0, 1.0)\n        w = weight.where(per_kg, 1.0)\n        calc = rate * dur_h * f * w\n        use_calc = rate.notna() & (dur_h > 0) & calc.notna()\n        out = amt.copy()\n        # rows whose amount is a sentinel or that were replaced by the total amount\n        suspect = amt.isin([-888, -999, -1, -1000, 1000]) | amt.isna()\n        repl = calc.where(use_calc, tot.where(tot.notna(), orig))\n        out[suspect] = repl[suspect]\n        # rows where the amount equals the total but a rate exists -> recompute\n        eq_tot = (amt == tot) & tot.notna() & use_calc\n        out[eq_tot] = calc[eq_tot]\n        return as_float_col(out.map(fmt_float))\n\n    def build_outputevents(self):\n        o = self.r[\"outputevents\"].copy()\n        o[\"itemid\"] = unalias_series(o.itemid)\n        o[\"hadm_id\"] = o.stay_id.map(self.stay2hadm).fillna(o.hadm_id)\n        # charttime was set to the unix epoch -> recover from storetime (hour granularity)\n        st = pd.to_datetime(o.storetime, errors=\"coerce\")\n        o.loc[o.charttime == EPOCH, \"charttime\"] = st.dt.floor(\"h\").dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n        o[\"value\"] = as_float_col(o.value)\n        cols = [\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\", \"value\"]\n        o = o[cols].reset_index(drop=True)\n        self.r[\"outputevents_out\"] = o\n        return o\n\n    # ----------------------------------------------------------- chartevents\n    def build_chartevents(self):\n        ce = self.r[\"chartevents\"].copy()\n        n0 = len(ce)\n        # 1. label-leakage inserted rows: valuenum carries the '(insert)' marker\n        leak = ce.valuenum.map(lambda v: (str(v).strip() != \"\") and (parse_float(v) is None))\n        ce = ce[~leak].copy()\n        n_leak = n0 - len(ce)\n        # 2. itemid alias injection (key column)\n        ce[\"itemid\"] = unalias_series(ce.itemid)\n        # 3. stay_id corruption: a spurious leading digit (cross table id misalignment)\n        def fix_stay(s):\n            if s in self.known_stays:\n                return s\n            for k in range(1, 4):\n                if s[k:] in self.known_stays:\n                    return s[k:]\n            return s\n        ce[\"stay_id\"] = ce.stay_id.map(fix_stay)\n        n_stayfix = int((ce.stay_id != self.r[\"chartevents\"].stay_id.reindex(ce.index)).sum())\n        # 4. hadm_id must agree with the icustay of the stay\n        ce[\"hadm_id\"] = ce.stay_id.map(self.stay2hadm).fillna(ce.hadm_id)\n        # 5. charttime corruption: charttime pushed to outtime + 1 day (outside the stay)\n        out1 = {s: fmt(ts(o) + pd.Timedelta(days=1)) for s, o in self.stay_out.items() if ts(o) is not None}\n        bad = ce.apply(lambda r: out1.get(r.stay_id) is not None and r.charttime == out1[r.stay_id], axis=1)\n        n_ct = int(bad.sum())\n        if n_ct:\n            st = pd.to_datetime(ce.storetime, errors=\"coerce\")\n            guess = st.dt.floor(\"h\").dt.strftime(\"%Y-%m-%d %H:%M:%S\")\n            guess = guess.where(guess != \"\", ce.charttime)\n            ce.loc[bad, \"charttime\"] = guess[bad]\n        # 6. valuenum repairs (unit scale / sentinel injections / native MIMIC errors)\n        ce = self._fix_valuenum(ce)\n        # 7. dedup *after* all key/value repairs\n        before = len(ce)\n        ce = ce.drop_duplicates(keep=\"first\")\n        n_dup = before - len(ce)\n        # 8. native MIMIC errors are repaired on the final clean table\n        ce = self._fix_native(ce)\n        ce[\"valuenum\"] = as_float_col(ce.valuenum)\n        cols = [\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\", \"valuenum\", \"valueuom\"]\n        ce = ce[cols].reset_index(drop=True)\n        self.report[\"chartevents\"] = dict(raw=n0, leak_removed=n_leak,\n                                          stay_fixed=n_stayfix, charttime_fixed=n_ct,\n                                          dup_removed=n_dup, out=len(ce))\n        self.r[\"chartevents_out\"] = ce\n        return ce\n\n    def _fix_valuenum(self, ce):\n        \"\"\"repair the injected valuenum errors\n\n        * value text numeric and different from valuenum -> the value text is the\n          true measurement (unit scale x100, sentinel codes, -1 style codes)\n        * value text not numeric (descriptive chart row) -> a sentinel code or a\n          zero in valuenum is injected garbage, the original value was empty\n        \"\"\"\n        vn = to_num(ce.valuenum)\n        vt = ce.value.map(parse_float)\n        numeric_text = vt.notna()\n        same = np.isclose(vn, vt, rtol=0, atol=0) | (vn.isna() & vt.isna())\n        use_vt = numeric_text & ~same\n        if use_vt.any():\n            ce.loc[use_vt, \"valuenum\"] = vt[use_vt].map(fmt_float)\n        # text rows: sentinels and zeros are injected garbage -> empty\n        vn = to_num(ce.valuenum)\n        text = ~numeric_text\n        garbage = text & (vn.isin(SENTINEL_VALUES) | (vn == 0))\n        if garbage.any():\n            ce.loc[garbage, \"valuenum\"] = \"\"\n        return ce\n\n    def _subject_item_median(self, ce):\n        vals = to_num(ce.valuenum)\n        ok = vals.notna() & ~vals.isin(SENTINEL_VALUES) & (vals != 0)\n        sub = ce[ok].copy()\n        sub[\"v\"] = vals[ok]\n        g = sub.groupby([\"subject_id\", \"itemid\"])[\"v\"].median()\n        return {(a, b): c for (a, b), c in g.items()}\n\n    def _fix_native(self, ce):\n        \"\"\"native MIMIC errors: value == valuenum but outside the physiological range\n        (or a sentinel code) -> replace by the patient's median for that item.\"\"\"\n        vals = to_num(ce.valuenum)\n        lo = ce.itemid.map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[0])\n        hi = ce.itemid.map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[1])\n        oor = vals.notna() & lo.notna() & ((vals < lo) | (vals > hi)) & (vals != 0)\n        sent = vals.isin(SENTINEL_VALUES)\n        vt = ce.value.map(parse_float)\n        native = vt.notna() & vals.notna() & (vt == vals) & (oor | sent)\n        if native.any():\n            med = self._subject_item_median(ce)\n            repl = ce.apply(lambda r: med.get((r.subject_id, r.itemid), np.nan), axis=1)\n            use = native & repl.notna()\n            if use.any():\n                ce.loc[use, \"valuenum\"] = repl[use].map(fmt_float)\n        return ce\n\n    # ------------------------------------------------------------------ ecg\n    def build_ecg(self):\n        rl = self.r[\"ecg_list\"].copy()\n        mm = self.r[\"ecg_meas\"].copy()\n        ic = self.r[\"icustays\"]\n        stays = ic[[\"stay_id\", \"subject_id\", \"hadm_id\", \"intime\", \"outtime\"]].copy()\n        m = rl.merge(stays, on=\"subject_id\", how=\"inner\")\n        t = pd.to_datetime(m.ecg_time, errors=\"coerce\")\n        lo = pd.to_datetime(m.intime, errors=\"coerce\")\n        hi = pd.to_datetime(m.outtime, errors=\"coerce\")\n        m = m[(t >= lo) & (t <= hi)].copy()\n        m = m.sort_values([\"subject_id\", \"ecg_time\"]).reset_index(drop=True)\n        manifest = pd.DataFrame({\n            \"subject_id\": m.subject_id, \"study_id\": m.study_id, \"file_name\": m.file_name,\n            \"ecg_time\": m.ecg_time, \"path\": m.path, \"hadm_id\": m.hadm_id,\n            \"stay_id\": m.stay_id, \"intime\": m.intime, \"outtime\": m.outtime,\n        })\n        manifest[\"waveform_path\"] = manifest.path.map(\n            lambda p: \"/mnt/GPU_10T/data/yjk/MedWM/data/mimic-iv-ecg-diagnostic-electrocardiogram-matched-subset-1.0/\" + p)\n        manifest[\"hea_exists\"] = False\n        manifest[\"dat_exists\"] = False\n        cols = [\"subject_id\", \"study_id\", \"file_name\", \"ecg_time\", \"path\", \"hadm_id\",\n                \"stay_id\", \"intime\", \"outtime\", \"waveform_path\", \"hea_exists\", \"dat_exists\"]\n        manifest = manifest[cols].reset_index(drop=True)\n\n        meas = mm.merge(manifest[[\"study_id\", \"hadm_id\", \"stay_id\"]], on=\"study_id\", how=\"inner\")\n        mcols = [\"subject_id\", \"study_id\", \"cart_id\", \"ecg_time\"] + \\\n                [f\"report_{i}\" for i in range(17)] + \\\n                [\"bandwidth\", \"filtering\", \"rr_interval\", \"p_onset\", \"p_end\",\n                 \"qrs_onset\", \"qrs_end\", \"t_end\", \"p_axis\", \"qrs_axis\", \"t_axis\",\n                 \"hadm_id\", \"stay_id\"]\n        for c in mcols:\n            if c not in meas.columns:\n                meas[c] = \"\"\n        meas = meas[mcols].reset_index(drop=True)\n        self.r[\"ecg_manifest_out\"] = manifest\n        self.r[\"ecg_measurements_out\"] = meas\n        return manifest, meas\n\n    # ---------------------------------------------------------------- write\n    def _cohort_frame(self):\n        adm = self.r[\"admissions\"].set_index(\"hadm_id\")\n        rows = []\n        for row in self.cohort.itertuples():\n            flag = 0\n            if row.hadm_id in adm.index:\n                flag = 1 if str(adm.loc[row.hadm_id, \"deathtime\"]).strip() != \"\" else 0\n            rows.append((row.subject_id, row.hadm_id, \"icu\", \"ICU\", flag))\n        return pd.DataFrame(rows, columns=[\"subject_id\", \"hadm_id\", \"cohort_type\",\n                                           \"cohort_label\", \"hospital_expire_flag\"])\n\n    def write(self):\n        os.makedirs(self.out, exist_ok=True)\n        os.makedirs(os.path.join(self.out, \"icu\"), exist_ok=True)\n        os.makedirs(os.path.join(self.out, \"multimodal\"), exist_ok=True)\n        files = {\n            \"admissions.csv\": self.r[\"admissions_out\"],\n            \"cohort.csv\": self._cohort_frame(),\n            \"demographics.csv\": self.r[\"demographics_out\"],\n            \"diagnoses.csv\": self.r[\"diagnoses_out\"],\n            \"procedures.csv\": self.r[\"procedures_out\"],\n            \"medications.csv\": self.r[\"medications_out\"],\n            \"labs.csv\": self.r[\"labs_out\"],\n            \"icu/icustays.csv\": self.r[\"icustays\"][[\"subject_id\", \"hadm_id\", \"stay_id\", \"intime\", \"outtime\", \"los\"]],\n            \"icu/chartevents.csv\": self.r[\"chartevents_out\"],\n            \"icu/inputevents.csv\": self.r[\"inputevents_out\"],\n            \"icu/outputevents.csv\": self.r[\"outputevents_out\"],\n            \"multimodal/ecg_manifest.csv\": self.r[\"ecg_manifest_out\"],\n            \"multimodal/ecg_measurements.csv\": self.r[\"ecg_measurements_out\"],\n        }\n        for rel, df in files.items():\n            df.to_csv(os.path.join(self.out, rel), index=False)\n        return files\n\n\ndef main():\n    ap = argparse.ArgumentParser()\n    ap.add_argument(\"--raw_root\", required=True)\n    ap.add_argument(\"--output_dir\", required=True)\n    args = ap.parse_args()\n    p = Pipeline(args.raw_root, args.output_dir)\n    p.load()\n    p.fix_icustays()\n    p.build_cohort()\n    p.build_admissions()\n    p.build_demographics()\n    p.build_diagnoses()\n    p.build_procedures()\n    p.build_medications()\n    p.build_labs()\n    p.build_inputevents()\n    p.build_outputevents()\n    p.build_chartevents()\n    p.build_ecg()\n    files = p.write()\n    print(json.dumps({\"report\": p.report,\n                      \"rows\": {k: len(v) for k, v in files.items()}}, indent=2))\n\n\nif __name__ == \"__main__\":\n    main()\n"}
