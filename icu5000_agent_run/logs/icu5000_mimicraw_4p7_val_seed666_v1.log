{"file_path":"/Users/mac/PycharmProjects/v2_clean/.claude/worktrees/k29-mimicraw/icu5000_agent_run/experiments/icu5000_mimicraw_4p7_val_seed666_v1/agent_workdir/scripts/ie_delivery.py","content":"\"\"\"Evaluate the delivery-aware inputevents rules: exact string match of amount/endtime vs the reference.\"\"\"\nimport pandas as pd, numpy as np, re\n\nB = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'\n\n\ndef load(split):\n    raw = pd.read_csv(f'{B}/{split}/raw/icu/inputevents.csv', dtype=str, keep_default_na=False, na_values=[''])\n    ref = pd.read_csv(f'{split}/reference/icu/inputevents.csv', dtype=str, keep_default_na=False)\n    stays = pd.read_csv(f'{B}/{split}/raw/icu/icustays.csv', dtype=str, keep_default_na=False)\n    valid = set(stays['stay_id'])\n    raw['itemid'] = raw['itemid'].map(lambda s: '2' + s[3:] if isinstance(s, str) and re.fullmatch(r'992\\d{5}', s) else s)\n    raw['stay_id'] = raw['stay_id'].map(lambda v: v[1:] if (isinstance(v, str) and v.startswith('9') and v[1:] in valid) else v)\n    raw['hadm_id'] = raw['stay_id'].map(stays.set_index('stay_id')['hadm_id'])\n    raw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\n    for c in ['starttime', 'endtime', 'storetime']:\n        raw[c] = pd.to_datetime(raw[c], errors='coerce')\n    ref['starttime'] = pd.to_datetime(ref['starttime'], errors='coerce')\n    ref['endtime'] = pd.to_datetime(ref['endtime'], errors='coerce')\n    for d in (raw, ref):\n        d['subject_id'] = d['subject_id'].astype(str); d['stay_id'] = d['stay_id'].astype(str)\n        d['itemid'] = d['itemid'].astype(str)\n    return raw, ref\n\n\ndef fmt(v):\n    \"\"\"the reference formats floats as python repr with a forced .0 for integers\"\"\"\n    if v is None or (isinstance(v, float) and np.isnan(v)):\n        return ''\n    f = float(v)\n    if f == int(f) and abs(f) < 1e15:\n        return f'{f:.1f}'\n    return repr(f)\n\n\nraw, ref = load('train')\nfor c in ['amount', 'originalamount', 'totalamount', 'rate']:\n    raw[c + '_n'] = pd.to_numeric(raw[c], errors='coerce')\nraw['has_rate'] = raw['rate_n'] > 0\nraw['finished'] = raw['statusdescription'].fillna('') == 'FinishedRunning'\n\n# --- build the delivery chain: one delivery = (linkorderid, starttime) ---\ndeliv = raw.groupby(['linkorderid', 'starttime'], as_index=False).agg(\n    n=('itemid', 'size'),\n    main_rate=('rate_n', 'max'),\n    main_orig=('originalamount_n', 'max'),\n    any_finished=('finished', 'any'),\n    has_rate=('has_rate', 'any'),\n)\ndeliv = deliv.sort_values(['linkorderid', 'starttime'])\ndeliv['next_start'] = deliv.groupby('linkorderid')['starttime'].shift(-1)\ndeliv['chain_min'] = (deliv['next_start'] - deliv['starttime']).dt.total_seconds() / 60\n# duration per delivery\ndur = pd.Series(np.nan, index=deliv.index)\nrate_dur = deliv['main_orig'] / deliv['main_rate'].replace(0, np.nan) * 60\nuse_rate = deliv['has_rate'] & deliv['any_finished'] & deliv['main_rate'].notna()\ndur = dur.mask(use_rate, rate_dur.round())\ndur = dur.mask(dur.isna() & deliv['chain_min'].notna(), deliv['chain_min'])\ndur = dur.mask(dur.isna() & ~deliv['has_rate'], 1.0)\ndur = dur.mask(dur.isna(), rate_dur.round())\ndeliv['dur'] = dur\nkey = pd.MultiIndex.from_arrays([raw['linkorderid'], raw['starttime']])\nraw['dur'] = deliv.set_index(['linkorderid', 'starttime'])['dur'].reindex(key).values\nraw['chain_min'] = deliv.set_index(['linkorderid', 'starttime'])['chain_min'].reindex(key).values\n\n# --- amounts ---\nraw['amt_pred'] = raw['originalamount_n']\n# rows in a delivery that has a rate: amount = rate * duration/60 ; components scale with the main\ndeliv_main = deliv.set_index(['linkorderid', 'starttime'])\nmain_amt = (deliv_main['main_rate'] * deliv_main['dur'] / 60).rename('main_amt')\nmain_orig = deliv_main['main_orig'].rename('main_orig')\nraw['main_amt'] = main_amt.reindex(key).values\nraw['main_orig'] = main_orig.reindex(key).values\nhas_rate_deliv = deliv_main['has_rate'].reindex(key).values\nraw['frac'] = np.where(raw['main_orig'].notna() & (raw['main_orig'] != 0),\n                       raw['originalamount_n'] / raw['main_orig'], np.nan)\n# main row of a delivery with a rate -> amount = rate*duration/60 (or the original amount when finished)\nmainrow = raw['has_rate'] & has_rate_deliv\nraw['amt_pred'] = raw['originalamount_n']\nraw.loc[mainrow & raw['finished'], 'amt_pred'] = raw.loc[mainrow & raw['finished'], 'originalamount_n']\nraw.loc[mainrow & ~raw['finished'], 'amt_pred'] = raw.loc[mainrow & ~raw['finished'], 'main_amt']\n# component rows of a delivery with a rate -> main amount * fraction\ncomp = (~raw['has_rate']) & has_rate_deliv & raw['frac'].notna()\nraw.loc[comp, 'amt_pred'] = raw.loc[comp, 'main_amt'] * raw.loc[comp, 'frac']\n\n# --- pair with the reference ---\npairs = []\nfor k, sub in raw.groupby(['subject_id', 'stay_id', 'itemid', 'starttime']):\n    r = ref[(ref.subject_id == k[0]) & (ref.stay_id == k[1]) & (ref.itemid == k[2]) & (ref.starttime == k[3])]\n    if len(r) != len(sub):\n        continue\n    for i in range(len(sub)):\n        pairs.append({**sub.iloc[i].to_dict(), 'ref_amount': r.iloc[i]['amount'], 'ref_end': r.iloc[i]['endtime']})\np = pd.DataFrame(pairs)\np['end_pred'] = p['starttime'] + pd.to_timedelta(p['dur'].fillna(1.0) * 60, unit='s')\np['amt_str'] = p['amt_pred'].map(fmt)\np['end_str'] = p['end_pred'].dt.strftime('%Y-%m-%d %H:%M:%S')\nprint('paired rows:', len(p))\nprint()\nprint('ENDTIME  exact string match:', round(float((p['end_str'] == p['ref_end']).mean()), 4))\nprint('  current rule (rate->orig/rate else +60s):')\ncur = p['starttime'] + pd.to_timedelta(np.where(p['has_rate'], (p['originalamount_n'] / p['rate_n'].replace(0, np.nan) * 60).round(), 1.0) * 60, unit='s')\nprint('   ', round(float((cur.dt.strftime('%Y-%m-%d %H:%M:%S') == p['ref_end']).mean()), 4))\nprint()\nprint('AMOUNT   exact string match:', round(float((p['amt_str'] == p['ref_amount']).mean()), 4))\nprint('  current rule (originalamount):', round(float((p['originalamount_n'].map(fmt) == p['ref_amount']).mean()), 4))\nprint('  numeric agreement (6dp)      :', round(float((p['amt_pred'].round(6) == pd.to_numeric(p['ref_amount'], errors='coerce').round(6)).mean()), 4))\nprint()\nfor name, m in (('no rate', ~p['has_rate']), ('rate+finished', p['has_rate'] & p['finished']),\n                ('rate+other', p['has_rate'] & ~p['finished'])):\n    print(f'  {name:16s} n={int(m.sum()):5d} end={float((p[\"end_str\"][m] == p[\"ref_end\"][m]).mean()):.4f} '\n          f'amt_str={float((p[\"amt_str\"][m] == p[\"ref_amount\"][m]).mean()):.4f} '\n          f'amt_num={float((p[\"amt_pred\"][m].round(6) == pd.to_numeric(p[\"ref_amount\"][m], errors=\"coerce\").round(6)).mean()):.4f}')\n"}
