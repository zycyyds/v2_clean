    # ---------------------------------------------------------------- chartevents
    ce = read_csv(R('icu', 'chartevents.csv'),
                  usecols=['subject_id', 'hadm_id', 'stay_id', 'charttime', 'storetime',
                           'itemid', 'value', 'valuenum', 'valueuom'],
                  dtypes={'subject_id': 'int64', 'hadm_id': 'int64'})
    ce['stay_id'] = ce['stay_id'].map(lambda v: fix_alias_stay(v, valid_stay_ids))
    ce['stay_id'] = pd.to_numeric(ce['stay_id'], errors='coerce')
    ce['charttime'] = pd.to_datetime(ce['charttime'], errors='coerce')
    ce['storetime'] = pd.to_datetime(ce['storetime'], errors='coerce')
    ce['itemid'] = ce['itemid'].map(fix_alias_itemid)
    # rows carrying the injector's placeholder itemid were inserted -> drop them
    n_before = len(ce)
    ce = ce[ce['itemid'] != INJECTED_ITEMID].copy()
    log['chartevents_injected_rows_dropped'] = n_before - len(ce)
    # hadm_id was rotated across stays -> restore from icustays
    ce['hadm_id'] = ce['stay_id'].map(stay_hadm)
    ce['subject_id'] = ce['stay_id'].map(stay_subject)
    # --- key repair: charttime moved to (outtime + 1 day) -> restore from the
    #     chart session (rows sharing subject/stay/storetime share a charttime)
    ce['st_dt'] = ce['storetime']
    ce['landmark'] = ce['stay_id'].map(
        pd.to_datetime(stay_outtime) + pd.Timedelta(days=1))
    bad_ct = ce['charttime'] == ce['landmark']
    if bad_ct.any():
        sk = ['subject_id', 'stay_id', 'storetime']
        mode = (ce.groupby(sk, dropna=False)['charttime']
                .agg(lambda s: s.value_counts().index[0]).rename('ct_mode').reset_index())
        ce = ce.reset_index(drop=False).rename(columns={'index': '_rid'})
        ce = ce.merge(mode, on=sk, how='left').sort_values('_rid').set_index('_rid')
        ce.index.name = None
        fallback = ce['st_dt'].dt.floor('h')
        pick = ce['ct_mode']
        pick = pick.where((pick.notna()) & (pick != ce['landmark']) & (pick != ce['charttime']), fallback)
        ce.loc[bad_ct, 'charttime'] = pick[bad_ct]
        log['chartevents_landmark_rows_repaired'] = int(bad_ct.sum())
    if dedup_mode == 'rawpre':
        # de-duplicate the raw rows before the value repair (keeps genuine MIMIC
        # duplicates that only differ in a corrupted cell)
        ce = ce.drop_duplicates(subset=[c for c in ce.columns
                                       if c not in ('value_num', 'vn_raw', 'vn_fix', 'valuenum_out',
                                                    'st_dt', 'landmark')])
    # --- valuenum repair
    ce['value_num'] = ce['value'].map(to_float)
    ce['vn_raw'] = pd.to_numeric(ce['valuenum'], errors='coerce')
    # (a) text valued rows: the numeric code is a deterministic function of (itemid, value)
    tmask = ce['value_num'].isna()
    lut = np.zeros(0)
    pair = np.zeros(0, dtype='int64')
    if tmask.any():
        txt = ce.loc[tmask, ['itemid', 'value', 'vn_raw']]
        icodes, iuni = pd.factorize(txt['itemid'], use_na_sentinel=False)
        vcodes, vuni = pd.factorize(txt['value'], use_na_sentinel=False)
        n_v = max(len(vuni), 1)
        pair = icodes.astype('int64') * n_v + vcodes
        lut = np.full(len(iuni) * n_v, np.nan)
        cnt = (pd.DataFrame({'pair': pair, 'vn': txt['vn_raw'].to_numpy()})
               .groupby(['pair', 'vn'], dropna=False).size().reset_index(name='n'))
        # the majority non zero code of the (itemid, value) group
        plaus = cnt[cnt['vn'].notna() & ~cnt['vn'].isin(list(SENTINEL_VALUES)) &
                    (cnt['vn'] > 0) & (cnt['vn'] <= 60)]
        has_nz = set()
        if len(plaus):
            plaus = plaus.sort_values('n', ascending=False).drop_duplicates('pair')
            lut[plaus['pair'].to_numpy()] = plaus['vn'].to_numpy()
            has_nz = set(plaus['pair'].to_numpy().tolist())
        # no non zero code: the code is either 0 or the measurement is not numeric at all.
        # A real 0 dominates the group, an injected 0 is only a small fraction of it.
        zc = cnt[cnt['vn'] == 0].groupby('pair')['n'].sum()
        ec = cnt[cnt['vn'].isna()].groupby('pair')['n'].sum()
        if len(zc):
            empties = ec.reindex(zc.index).fillna(0)
            for p in zc.index[zc.to_numpy() > empties.to_numpy()]:
                if p not in has_nz:
                    lut[p] = 0.0
    ce['vn_fix'] = np.nan
    if tmask.any():
        ce.loc[tmask, 'vn_fix'] = lut[pair]
    # (b) numeric valued rows: valuenum is the numeric value, unless it is a native
    #     MIMIC error (value == valuenum and physiologically impossible)
    ce.loc[~tmask, 'vn_fix'] = ce.loc[~tmask, 'value_num']
    # (c) native MIMIC errors -> patient/item median of the clean readings
    ce = repair_native_errors(ce, tmask)
    ce['valuenum_out'] = ce['vn_fix'].map(fmt_float)
    if dedup_mode == 'rawfull':
        ce = ce.drop_duplicates(subset=[c for c in ce.columns
                                       if c not in ('value_num', 'vn_raw', 'vn_fix', 'valuenum_out',
                                                    'st_dt', 'landmark', 'value')])
    chart = ce[['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'valuenum_out', 'valueuom']].copy()
    chart.columns = ['subject_id', 'hadm_id', 'stay_id', 'charttime', 'itemid', 'valuenum', 'valueuom']
    chart['charttime'] = chart['charttime'].dt.strftime('%Y-%m-%d %H:%M:%S')
    chart = dedup_rows(chart, dedup_mode if dedup_mode not in ('rawfull', 'rawpre') else 'none')
    log['chartevents_rows'] = len(chart)

