#!/usr/bin/env python3
"""
Replay entry point for the ICU5000 result package.

    python3 scripts/replay.py --raw_root {raw_root} --output_dir {output_dir}

Rebuilds the whole 13 file package from a raw MIMIC-IV slice.  Only
{raw_root} and {output_dir} are needed (the train reference is optional and
only used for the self-check report).
"""
import argparse
import json
import os
import subprocess
import sys

HERE = os.path.dirname(os.path.abspath(__file__))
PIPELINE = os.path.join(HERE, "icu5000_pipeline.py")


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--raw_root", required=True)
    ap.add_argument("--output_dir", required=True)
    ap.add_argument("--train_reference", default=None,
                    help="optional: reference package for a self check report")
    ap.add_argument("--workdir", default=None)
    args = ap.parse_args()

    os.makedirs(args.output_dir, exist_ok=True)
    cmd = [sys.executable, PIPELINE, "--raw_root", args.raw_root,
           "--output_dir", args.output_dir]
    print("[replay]", " ".join(cmd), flush=True)
    out = subprocess.run(cmd, capture_output=True, text=True)
    print(out.stdout)
    if out.returncode != 0:
        print(out.stderr, file=sys.stderr)
        return out.returncode

    report = {"output_dir": os.path.abspath(args.output_dir), "files": {}}
    for rel in ["admissions.csv", "cohort.csv", "demographics.csv", "diagnoses.csv",
                "procedures.csv", "medications.csv", "labs.csv",
                "icu/icustays.csv", "icu/chartevents.csv", "icu/inputevents.csv",
                "icu/outputevents.csv", "multimodal/ecg_manifest.csv",
                "multimodal/ecg_measurements.csv"]:
        p = os.path.join(args.output_dir, rel)
        n = sum(1 for _ in open(p)) - 1 if os.path.exists(p) else -1
        report["files"][rel] = n

    if args.train_reference and os.path.isdir(args.train_reference):
        try:
            sys.path.insert(0, HERE)
            from selfcheck import compare
            report["selfcheck"] = compare(args.output_dir, args.train_reference,
                                          verbose=False)
        except Exception as e:      # pragma: no cover
            report["selfcheck_error"] = str(e)

    if args.workdir:
        rp = os.path.join(args.workdir, "replay_report.json")
        with open(rp, "w") as fh:
            json.dump(report, fh, indent=2)
    print(json.dumps({"files": report["files"]}, indent=2))
    return 0


if __name__ == "__main__":
    sys.exit(main())
