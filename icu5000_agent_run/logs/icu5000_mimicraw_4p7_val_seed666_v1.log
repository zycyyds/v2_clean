                  f"cellP={f['cell_prec']} cellR={f['cell_rec']}")
    print(f"\nTOTAL cell precision {total['cell_acc']}/{total['cell_tot']} = "
          f"{total['cell_acc']/max(total['cell_tot'],1):.4f}   "
          f"row recall {total['row_acc']}/{total['row_tot']} = "
          f"{total['row_acc']/max(total['row_tot'],1):.4f}")
    return total


