ta(days=1))\nraw['is_lm'] = raw['stay_id'].map(lm) == raw['charttime']\nraw['subject_id'] = raw['stay_id'].map(stays.set_index('stay_id')['subject_id'])\n\n# collection timestamps: high-frequency charttimes with non-zero seconds\nvc = raw['charttime'].value_counts()\ncoll = [t for t in vc.index if vc[t] >= 20 and pd.Timestamp(t).second != 0]\nraw['is_coll'] = raw['charttime'].isin(coll)\nprint('rows', len(raw), 'landmark', int(raw['is_lm'].sum()), 'collection', int(raw['is_coll'].sum()),\n      'overlap', int((raw['is_lm'] & raw['is_coll']).sum()))\n\nrefkeys = set(zip(ref.subject_id, ref.stay_id, ref.itemid, ref.charttime))\nref['charttime'] = pd.to_datetime(ref['charttime'], errors='coerce')\n\n\ndef score(charttimes, label):\n    key = list(zip(raw.subject_id, raw.stay_id, raw.itemid,\n                   charttimes.dt.strftime('%Y-%m-%d %H:%M:%S')))\n    hit = sum(1 for k in key if k in refkeys)\n    print(f'  {label:52s} key-in-ref: {hit}/{len(raw)}  ({hit/len(raw):.4f})')\n    return hit\n\n\nSK = ['subject_id', 'stay_id', 'storetime']\nmode_all = (raw.groupby(SK, dropna=False)['charttime']\n            .agg(lambda s: s.value_counts().index[0]).rename('m_all').reset_index())\nraw = raw.merge(mode_all, on=SK, how='left')\nclean = raw[~(raw['is_lm'] | raw['is_coll'])]\nmode_clean = (clean.groupby(SK, dropna=False)['charttime']\n               .agg(lambda s: s.value_counts().index[0]).rename('m_clean').reset_index())\nraw = raw.merge(mode_clean, on=SK, how='left')\nraw['floor_store'] = raw['storetime'].dt.floor('h')\n\nprint('\\nscore of variants (proxy = raw key present in reference key set):')\nA = raw['charttime'].copy()\nscore(A, 'A0 raw as-is')\n\nA1 = raw['charttime'].copy()\npickA = raw['m_all']\npickA = pickA.where(pickA.notna() & (pickA != raw['charttime']), raw['floor_store'])\nA1.loc[raw['is_lm']] = pickA[raw['is_lm']]\nscore(A1, 'A  landmark repaired with all-rows session mode (current)')\n\nB = raw['charttime'].copy()\npickB = raw['m_clean']\npickB = 