orms\": {\n        \"charttime\": \"the injector replaced every charttime by the unix epoch -> restored as the hour the event was stored in (floor(storetime)); 198/445 reference rows match this rule\",\n        \"value\": \"numeric text column\",\n        \"itemid/hadm_id\": \"restored like in the other ICU tables\"\n      },\n      \"aggregation\": \"one row per output event\",\n      \"train_evidence\": \"445 raw rows = 445 reference rows with the same row order; all 445 raw charttimes are 1970-01-01 00:00:00 while 344 reference charttimes are hour aligned\"\n    },\n    \"multimodal/ecg_manifest.csv\": {\n      \"raw_input\": \"ecg/record_list.csv + icu/icustays.csv\",\n      \"primary_key\": [\"subject_id\", \"study_id\"],\n      \"time_anchor\": \"ecg_time\",\n      \"filter\": \"ecg_time inside the ICU stay window [intime, outtime]\",\n      \"field_transforms\": {\n        \"hadm_id/stay_id/intime/outtime\": \"taken from the matching ICU stay\",\n        \"waveform_path\": \"constant ECG root prefix + ecg/record_list.path\",\n        \"hea_exists/dat_exists\": \"constant False (no waveform files are shipped with the slice)\"\n      },\n      \"aggregation\": \"one row per ECG study inside an ICU stay window\",\n      \"train_evidence\": \"2 of the 5 reference rows can be produced from the raw slice; the other 3 belong to subject 13802162 whose ECG studies are not part of the raw slice (the raw ecg/record_list.csv only carries 3 of the 10 key patients)\"\n    },\n    \"multimodal/ecg_measurements.csv\": {\n      \"raw_input\": \"ecg/machine_measurements.csv + icu/icustays.csv\",\n      \"primary_key\": [\"subject_id\", \"study_id\"],\n      \"time_anchor\": \"ecg_time\",\n      \"filter\": \"study_id of the studies that are inside an ICU stay window\",\n      \"field_transforms\": {\"hadm_id/stay_id\": \"taken from the matching ICU stay\"},\n      \"aggregation\": \"one row per ECG study\",\n      \"train_evidence\": \"same 2/5 coverage as the manifest (the raw ecg table carries 55 studies of which only 2 fall into a stay window)\"\n    }\n  },\n  \"error_patterns\": [\n    {\n      \"id\": \"itemid_alias_carevue\",\n      \"tables\": [\"icu/chartevents.csv\", \"icu/inputevents.csv\"],\n      \"detection\": \"itemid matches ^992[0-9]{5}$\",\n      \"repair\": \"replace by '2' + the last five digits (Metavision ids start with 2)\",\n      \"train_evidence\": \"2633 chart rows and 1996 input rows carry an alias id; every reconstructed id exists in the reference (0 unknown ids), e.g. 99224004 -> 224004, 99220046 -> 220046\",\n      \"severity\": \"key column - unrepaired rows never join to the reference\"\n    },\n    {\n      \"id\": \"injected_placeholder_itemid\",\n      \"tables\": [\"icu/chartevents.csv\"],\n      \"detection\": \"itemid == 999001\",\n      \"repair\": \"drop the row\",\n      \"train_evidence\": \"2881 rows carry the placeholder id - exactly the number of label leakage rows the task reports for train - and the reference contains no 999001 row at all\"\n    },\n    {\n      \"id\": \"foreign_hadm_id\",\n      \"tables\": [\"icu/chartevents.csv\", \"icu/inputevents.csv\", \"icu/outputevents.csv\"],\n      \"detection\": \"hadm_id != the hadm_id of the stay in icu/icustays.csv\",\n      \"repair\": \"rewrite hadm_id from icu/icustays.csv\",\n      \"train_evidence\": \"2274 chart rows (and 10 hadm ids used by 8 subjects in inputevents) disagree with the stay; the reference has 0 such rows\"\n    },\n    {\n      \"id\": \"charttime_to_landmark\",\n      \"tables\": [\"icu/chartevents.csv\"],\n      \"detection\": \"charttime == outtime(stay) + 1 day\",\n      \"repair\": \"restore the chart session time (the most frequent charttime of the rows sharing subject/stay/storetime), fallback = floor(storetime)\",\n      \"train_evidence\": \"3325 train rows sit on the landmark while the reference has none; the session mode restores 2698 of 3058 (88%)\"\n    },\n    {\n      \"id\": \"icustays_outtime_before_int