import pandas as pd, numpy as np, re
from collections import Counter
BASE = '/Users/mac/PycharmProjects/v2_clean/datasets/val_views/icu5000_mimicraw_47'
raw = pd.read_csv(BASE + '/train/raw/icu/chartevents.csv', dtype=str)
ref = pd.read_csv(BASE + '/train/reference/icu/chartevents.csv', dtype=str)
stays = pd.read_csv(BASE + '/train/raw/icu/icustays.csv', dtype=str)
def fix_itemid(s):
    if isinstance(s, str) and re.fullmatch(r'992\d{5}', s): return '2' + s[3:]
    return s
raw['itemid'] = raw['itemid'].map(fix_itemid)
raw['hadm_id'] = raw['stay_id'].map(stays.set_index('stay_id')['hadm_id'])
stays['intime'] = pd.to_datetime(stays.intime)
stays['outtime'] = stays.intime + pd.to_timedelta(stays.los.astype(float) * 86400, unit='s')
lm = {r.stay_id: (r.outtime + pd.Timedelta(days=1)).strftime('%Y-%m-%d %H:%M:%S') for r in stays.itertuples()}
raw = raw[raw.itemid != '999001'].drop_duplicates()
raw['is_lm'] = raw.stay_id.map(lm) == raw.charttime
refkeys = set(zip(ref.subject_id, ref.stay_id, ref.itemid, ref.charttime))
# session mode
SK = ['subject_id', 'stay_id', 'storetime']
mode = raw.groupby(SK, dropna=False)['charttime'].agg(lambda s: s.value_counts().index[0]).rename('ct_mode').reset_index()
sessn = raw.groupby(SK, dropna=False)['charttime'].size().rename('sess_n').reset_index()
raw = raw.merge(mode, on=SK, how='left').merge(sessn, on=SK, how='left')
raw['own_ok'] = [(r.subject_id, r.stay_id, r.itemid, r.charttime) in refkeys for r in raw.itertuples()]
raw['mode_ok'] = [(r.subject_id, r.stay_id, r.itemid, r.ct_mode) in refkeys for r in raw.itertuples()]
print('total rows', len(raw))
print('own key in ref:', int(raw.own_ok.sum()), 'not in ref:', int((~raw.own_ok).sum()))
bad = raw[~raw.own_ok]
print('of the bad ones: landmark', int(bad.is_lm.sum()), 'mode_ok', int(bad.mode_ok.sum()))
good = raw[raw.own_ok]
print('of the good ones: mode differs from own', int((good.charttime != good.ct_mode).sum()), 'mode_ok too', int(good.mode_ok.sum()))
# rule: only repair rows that are "impossible": charttime > storetime, or landmark, or charttime outside window
st = pd.to_datetime(raw.storetime, errors='coerce')
ct = pd.to_datetime(raw.charttime)
impossible = (ct > st) | raw.is_lm
print('impossible rows:', int(impossible.sum()), 'of which own_ok:', int(raw.loc[impossible, "own_ok"].sum()), 'mode_ok:', int(raw.loc[impossible, "mode_ok"].sum()))
print('repair impact: repair impossible rows -> mode: correct', int((raw.loc[impossible,'mode_ok']).sum()), 'wrong', int((impossible.sum() - raw.loc[impossible,'mode_ok'].sum())))
# what if we repair ALL rows whose charttime != session mode
rep = raw.charttime != raw.ct_mode
print('rows differing from session mode:', int(rep.sum()), 'of which own_ok (would be broken):', int(raw.loc[rep,'own_ok'].sum()), 'mode_ok:', int(raw.loc[rep,'mode_ok'].sum()))

