eference duration (min) describe:'); print(p['dur_min'].describe().to_string())\nprint('exact +1min:', round(float((p['dur_min'] == 1).mean()), 4))\nprint('duration == 0:', round(float((p['dur_min'] == 0).mean()), 4))\np['orig_rate_h'] = p['originalamount_n'] / p['rate_n'].replace(0, np.nan)\np['raw_dur_h'] = (p['endtime'] - p['starttime']).dt.total_seconds() / 3600\nhas_rate = p['rate_n'].notna() & (p['rate_n'] > 0)\nprint('rows with rate:', int(has_rate.sum()))\nm = has_rate & p['ref_end'].notna()\nprint('  ref duration == originalamount/rate (h):',\n      round(float(np.isclose(p.loc[m, 'dur_min'] / 60, p.loc[m, 'orig_rate_h'], rtol=0.02).mean()), 4))\nprint('  raw endtime duration == originalamount/rate:',\n      round(float(np.isclose(p.loc[has_rate, 'raw_dur_h'], p.loc[has_rate, 'orig_rate_h'], rtol=0.02).mean()), 4))\nprint('  raw endtime == starttime+1min:', round(float((p['raw_dur_h'] * 60 == 1).mean()), 4))\nprint('  raw endtime == ref endtime   :', round(float((p['endtime'] == p['ref_end']).mean()), 4))\nprint('  raw duration (min) top:', (p['raw_dur_h'] * 60).value_counts().head(6).to_dict())\nprint('  ref duration (min) top:', p['dur_min'].value_counts().head(6).to_dict())\nprint('  raw dur == ref dur:', round(float(np.isclose(p['raw_dur_h'] * 60, p['dur_min']).mean()), 4))\n"}
