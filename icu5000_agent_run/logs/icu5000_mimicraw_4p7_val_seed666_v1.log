int(f\"  {name:44s} text-exact {int(ok[sel].sum()):4d}/{int(sel.sum())}   all {int(ok.sum())}/{len(ok)}\")\n\nfor label, sel in [(\"bolus (no rate)\", m.rate.isna().to_numpy()),\n                   (\"rate rows\", m.rate.notna().to_numpy())]:\n    print(\"==\", label, int(sel.sum()))\n    sc(\"orig\", m.orig.fillna(m.tot).to_numpy(), sel)\n    sc(\"F(orig/60)*60\", F(m.orig.fillna(m.tot).to_numpy() / 60.0) * 60.0, sel)\n    sc(\"F(F(orig/60)*60)\", F(F(m.orig.fillna(m.tot).to_numpy() / 60.0) * 60.0), sel)\n    sc(\"F(tot/60)*60\", F(m.tot.to_numpy() / 60.0) * 60.0, sel)\n    sc(\"F(orate/60)*60\", F(m.orate.to_numpy() / 60.0) * 60.0, sel)\n    sc(\"F(orig/60)*60 vs F(orate/60)*60 pick max\", np.where(np.isclose(F(m.orate.to_numpy()/60.0)*60.0, m.orig.fillna(m.tot).to_numpy(), rtol=1e-3),\n                                                               F(m.orate.to_numpy()/60.0)*60.0, F(m.orig.fillna(m.tot).to_numpy()/60.0)*60.0), sel)\n    # mixed: orig when it matches exactly, else the float32 formula\n    base = m.orig.fillna(m.tot).to_numpy()\n    f32 = F(base / 60.0) * 60.0\n    sc(\"orig if exact else F(orig/60)*60\", np.where(np.isclose(base, m.ga.to_numpy(), rtol=1e-9, atol=1e-12), base, f32), sel)\n"}
