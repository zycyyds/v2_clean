(lambda i: CHARTEVENT_RANGES.get(i, (np.nan, np.nan))[0])\n    hi = ce['itemid'].map(lambda i: CHARTEVENT_RANGES.get(i, (np.nan, np.nan))[1])\n    vn = ce['vn_fix']\n    sentinel = vn.isin(list(SENTINEL_VALUES))\n    in_range = vn.notna() & (vn != 0) & lo.notna() & (vn >= lo) & (vn <= hi)\n    out_of_range = vn.notna() & (vn != 0) & lo.notna() & ~in_range\n    # a native error is documented in the value text column as well\n    same_as_value = (~text_mask) & (vn == ce['value_num'])\n    cand1 = out_of_range & same_as_value\n    cand2 = sentinel & same_as_value\n    if not (cand1.any() or cand2.any()):\n        return ce\n    # median pools: class 1 -> in-range readings, class 2 -> non sentinel readings\n    base1 = ce[in_range]\n    med1 = base1.groupby(['subject_id', 'itemid'])['vn_fix'].median()\n    base2 = ce[~sentinel & vn.notna() & (vn != 0)]\n    med2 = base2.groupby(['subject_id', 'itemid'])['vn_fix'].median()\n    for mask, med in ((cand1, med1), (cand2, med2)):\n        if not mask.any():\n            continue\n        sub = ce.loc[mask, ['subject_id', 'itemid', 'vn_fix']].copy()\n        keys = list(zip(sub['subject_id'], sub['itemid']))\n        repl = [med.get(k, np.nan) for k in keys]\n        devs = []\n        oks = []\n        for k, v, r in zip(keys, repl, sub['vn_fix']):\n            if pd.isna(v):\n                devs.append(np.nan); oks.append(False); continue\n            devs.append(abs(v - r) / abs(v) if v != 0 else np.inf)\n            # deviation is measured against the patient baseline (the median)\n            oks.append(abs(v - r) / abs(v) >= 0.20 if v != 0 else True)\n        newv = [v if (o and pd.notna(v)) else r for v, o, r in zip(repl, oks, sub['vn_fix'])]\n        ce.loc[mask, 'vn_fix'] = newv\n    return ce"}
