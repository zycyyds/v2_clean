    # ----------------------------------------------------------- chartevents
    def build_chartevents(self):
        ce = self.r["chartevents"].copy()
        n0 = len(ce)
        rawcols = list(ce.columns)
        # 1. label-leakage inserted rows: valuenum carries the '(insert)' marker
        raw_vn = ce["valuenum"]
        vn_num = pd.to_numeric(raw_vn.replace("", np.nan), errors="coerce")
        leak = raw_vn.astype(str).str.strip().ne("") & vn_num.isna()
        ce = ce[~leak].copy()
        vn_num = vn_num[~leak]
        n_leak = n0 - len(ce)
        # 2. itemid alias injection (key column)
        ce["itemid"] = map_categorical(ce["itemid"], unalias_itemid)
        # 3. stay_id corruption: a spurious leading digit (cross table id misalignment)
        raw_stay = ce["stay_id"]
        def fix_stay(s):
            if s in self.known_stays:
                return s
            for k in range(1, 4):
                if s[k:] in self.known_stays:
                    return s[k:]
            return s
        ce["stay_id"] = map_categorical(ce["stay_id"], fix_stay)
        n_stayfix = int((ce["stay_id"].astype(str) != raw_stay.astype(str)).sum())
        # 4. hadm_id must agree with the icustay of the stay
        ce["hadm_id"] = map_categorical(ce["stay_id"], lambda s: self.stay2hadm.get(s, s))
        # 5. charttime corruption: charttime pushed to outtime + 1 day (outside the stay)
        out1 = {s: (ts(o) + pd.Timedelta(days=1)) for s, o in self.stay_out.items() if ts(o) is not None}
        ct = pd.to_datetime(ce["charttime"], errors="coerce")
        bad = ct.eq(categorical_values(ce["stay_id"], lambda s: out1.get(s))) & ct.notna()
        n_ct = int(bad.sum())
        if n_ct:
            ce["charttime"] = self._recover_charttime(ce, bad)
        # 6. de-duplicate *after* the key repairs (itemid / stay_id / charttime) and
        #    *before* the value repair: the injected duplicate rows carry a
        #    corrupted key, so they only become visible duplicates once the key
        #    is repaired, while repairing the values would create new duplicates
        h = None
        for c in rawcols:
            hc = pd.util.hash_pandas_object(ce[[c]], index=False).astype("uint64")
            h = hc if h is None else (h * np.uint64(1000003) + hc)
        keep = ~h.duplicated()
        n_dup = int((~keep).sum())
        ce = ce[keep].reset_index(drop=True)
        vn_num = vn_num[keep.to_numpy()].reset_index(drop=True)
        # 7. valuenum repairs (unit scale / sentinel injections)
        ce, vt = self._fix_valuenum(ce, vn_num)
        # 8. native MIMIC errors are detected on the cleaned values
        native_flag = self._native_flags(ce, vt)
        # 9. native MIMIC errors -> patient median (computed on the final clean table)
        vals = to_num(ce["valuenum"])
        repl = self._median_transform(ce, vals)
        with np.errstate(divide="ignore", invalid="ignore"):
            dev = (vals - repl).abs() / repl.abs()
        dev = dev.where(repl != 0, np.inf)
        use = native_flag & repl.notna() & (dev >= 0.20)
        if use.any():
            vals[use] = repl[use]
        ce["valuenum"] = vals
        cols = ["subject_id", "hadm_id", "stay_id", "charttime", "itemid", "valuenum", "valueuom"]
        ce = ce[cols].reset_index(drop=True)
        ce["valuenum"] = as_float_col(ce["valuenum"])
        self.report["chartevents"] = dict(raw=n0, leak_removed=n_leak,
                                          stay_fixed=n_stayfix, charttime_fixed=n_ct,
                                          dup_removed=n_dup, native_fixed=int(use.sum()),
                                          out=len(ce))
        self.r["chartevents_out"] = ce
        return ce

    def _fix_valuenum(self, ce, vn_num):
        """repair the injected valuenum errors

        * value text numeric and different from valuenum -> the value text is the
          true measurement (unit scale x100, sentinel codes, -1 style codes)
        * value text not numeric (descriptive chart row) -> a sentinel code or a
          zero in valuenum is injected garbage, the original value was empty
        """
        vt = self._value_numbers(ce)
        numeric_text = vt.notna()
        same = (vn_num == vt) | (vn_num.isna() & vt.isna())
        use_vt = numeric_text & ~same
        vals = vn_num.copy()
        if use_vt.any():
            vals[use_vt] = vt[use_vt]
        # text rows: sentinels and zeros are injected garbage -> empty
        text = ~numeric_text.to_numpy()
        garbage = text & (vals.isin(SENTINEL_VALUES).to_numpy() | (vals == 0).to_numpy())
        if garbage.any():
            vals[garbage] = np.nan
        ce["valuenum"] = vals
        return ce, vt

    def _native_flags(self, ce, vt):
        """rows whose value text equals the valuenum and that are outside the
        physiological range of the item (or carry a sentinel code)"""
        vals = to_num(ce["valuenum"])
        lo = ce["itemid"].map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[0])
        hi = ce["itemid"].map(lambda i: IMPOSSIBLE_RANGE.get(str(i), (np.nan, np.nan))[1])
        oor = vals.notna() & lo.notna() & ((vals < lo) | (vals > hi)) & (vals != 0)
        sent = vals.isin(SENTINEL_VALUES)
        return vt.notna() & vals.notna() & (vt == vals) & (oor | sent)

    def _median_transform(self, ce, vals):
        """per (subject_id, itemid) median of the usable readings"""
        ok, _ = self._usable_mask(ce)
        pool = vals.where(ok)
        tmp = pd.DataFrame({"s": ce["subject_id"], "i": ce["itemid"], "v": pool})
        return tmp.groupby(["s", "i"], observed=True)["v"].transform("median")

    @staticmethod
    def _recover_charttime(ce, bad):
        """the true charttime of a corrupted row is not recoverable; use the
        charttime of the charting session (same patient/stay/storetime/caregiver)
        when it is unique, otherwise the hour of the storetime."""
        key = ce[["subject_id", "stay_id", "storetime", "caregiver_id"]]
        h = pd.util.hash_pandas_object(key, index=False).to_numpy()
        ct = ce["charttime"].to_numpy()
        keep = ~bad.to_numpy()
        sub = pd.DataFrame({"h": h[keep], "ct": ct[keep]})

