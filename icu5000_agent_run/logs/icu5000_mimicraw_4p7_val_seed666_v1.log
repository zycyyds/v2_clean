:00:00\", \"outtime\": \"2149-01-05 00:00:00\",\n                   \"los\": 4.0})\nic.to_csv(os.path.join(BASE, \"icu\", \"icustays.csv\"), index=False)\nfor t in [\"admissions\", \"patients\", \"diagnoses_icd\", \"procedures_icd\", \"prescriptions\", \"labevents\"]:\n    p = os.path.join(BASE, \"hosp\", t + \".csv\")\n    if not os.path.exists(p):\n        pd.DataFrame({\"subject_id\": [subs[0]], \"hadm_id\": [hadms[0]]}).to_csv(p, index=False)\nfor t in [\"inputevents\", \"outputevents\"]:\n    p = os.path.join(BASE, \"icu\", t + \".csv\")\n    if not os.path.exists(p):\n        pd.DataFrame({\"subject_id\": [subs[0]], \"hadm_id\": [hadms[0]], \"stay_id\": [stays[0]]}).to_csv(p, index=False)\n\ndef rss():\n    return resource.getrusage(resource.RUSAGE_SELF).ru_maxrss / 1e6   # bytes (macOS)\n\nt0 = time.time()\np = P.Pipeline(BASE, os.path.join(HERE, \"..\", \"artifacts\", \"bench_out\"))\np.load()\nt1 = time.time(); print(f\"load {time.time()-t0:.1f}s  peakRSS {rss():.2f} GB\")\np.fix_icustays()\np.build_cohort()\np.build_chartevents()\nt2 = time.time(); print(f\"chartevents {time.time()-t1:.1f}s  peakRSS {rss():.2f} GB  rows={len(p.r['chartevents_out'])}\")\n"}
