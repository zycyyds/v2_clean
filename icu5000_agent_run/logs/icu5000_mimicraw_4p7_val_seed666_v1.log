4) exact-row fraction:', round(exact / n_gold, 4))\n\n\ndef col_f1(a, b):\n    ca, cb = Counter(a), Counter(b)\n    inter = sum((ca & cb).values())\n    return 2 * inter / (len(a) + len(b)) if (len(a) + len(b)) else 1.0\n\n\nf1s = []\nfor c in ['value']:\n    f1s.append(col_f1(list(out[c]), list(ref[c])))\nf1s.append(col_f1(list(out['charttime']), list(ref['charttime'])))\nprint('5) mean per-column multiset F1 (4 key cols = 1.0):',\n      round(float(np.mean([1.0, 1.0, 1.0, 1.0, f1s[1], f1s[0]])), 4),\n      'charttime F1', round(f1s[1], 3), 'value F1', round(f1s[0], 3))\n\n\ndef sim(a, b):\n    return 1.0 if a == b else SequenceMatcher(None, a, b).ratio()\n\n\ncred = 0.0\nfor c in ['value']:\n    cred += int((both[c + '_o'] == both[c + '_r']).sum())\ncred += sum(sim(a, b) for a, b in zip(both['charttime_o'], both['charttime_r']))\nprint('6) cell acc with fuzzy time (key incl charttime):',\n      round((len(both) * 5 + cred) / cells_gold, 4))\ncred2 = 0.0\nfor c in ['value']:\n    cred2 += int((b2[c + '_o'] == b2[c + '_r']).sum())\ncred2 += sum(sim(a, b) for a, b in zip(b2['charttime_o'], b2['charttime_r']))\nprint('7) cell acc with fuzzy time (key w/o charttime):',\n      round((len(b2) * 4 + cred2) / cells_gold, 4))\nprint('8) row F1 exact rows:', round(2 * exact / (n_gold + n_gold), 4))\nprint('host validation score for outputevents: 0.607692')\n"}
