ect_id\", \"hadm_id\"], \"labs (subject,hadm)\"),\n                    ([\"subject_id\", \"hadm_id\", \"storetime\", \"itemid\"], \"labs (+itemid)\")]:\n    g = lab.groupby(keys)[\"ct\"]\n    first = g.first(); nuni = g.nunique()\n    mp = first[nuni == 1]\n    if len(mp):\n        key = pd.MultiIndex.from_frame(m[list(keys)])\n        sess = pd.Series(mp.reindex(key).to_numpy(), index=m.index)\n    else:\n        sess = pd.Series(np.nan, index=m.index)\n    for floor_it, flabel in [(False, \"exact\"), (True, \"floored to the hour\")]:\n        cand = sess.dt.floor(\"h\") if floor_it else sess\n        ok = m.gct == cand\n        print(f\"  {label:34s} {flabel:18s} avail {int(sess.notna().sum()):4d} correct {int(ok.sum()):4d} \"\n              f\"| union with floor {int((ok | (m.gct == m.floorh)).sum()):4d}\")\n"}
