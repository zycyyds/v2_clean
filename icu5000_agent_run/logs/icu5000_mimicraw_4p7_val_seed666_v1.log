 the raw rows with the gold rows (key + occurrence on the corrupted key)\nK = [\"subject_id\", \"hadm_id\", \"stay_id\", \"charttime\", \"itemid\"]\nce[\"occ\"] = ce.groupby(K, dropna=False).cumcount()\ngold[\"occ\"] = gold.groupby(K, dropna=False).cumcount()\nmg = gold.merge(ce.drop(columns=[\"charttime\", \"value\", \"valueuom\"]), on=K + [\"occ\"], how=\"left\",\n                suffixes=(\"_g\", \"_r\"))\nprint(\"merged\", len(mg), \"unmatched\", int(mg.ct.isna().sum()))\nmg[\"gct\"] = pd.to_datetime(mg.charttime_g)\n\ndef sess_map(df, keys):\n    g = df.groupby(keys)[\"ct\"]\n    first = g.first(); nuni = g.nunique()\n    return first[nuni == 1]\n\ndef lookup(mp, frame, keys):\n    if not len(mp):\n        return pd.Series(pd.NaT, index=frame.index, dtype=\"datetime64[ns]\")\n    key = pd.MultiIndex.from_frame(frame[list(keys)])\n    return pd.Series(pd.to_datetime(mp.reindex(key).to_numpy()), index=frame.index, dtype=\"datetime64[ns]\")\n\nres = {}\nfor label, df, keys in [\n    (\"chartevents (subject,stay,storetime,caregiver)\", good, [\"subject_id\", \"stay_id\", \"storetime\", \"caregiver_id\"]),\n    (\"chartevents (subject,stay,storetime)\", good, [\"subject_id\", \"stay_id\", \"storetime\"]),\n    (\"labs (subject,hadm,storetime)\", lab, [\"subject_id\", \"hadm_id\", \"storetime\"]),\n    (\"labs (subject,hadm,storetime) [labevents only of the cohort]\", lab, [\"subject_id\", \"hadm_id\", \"storetime\"]),\n]:\n    mp = sess_map(df, keys)\n    if \"labs\" in label:\n        keys = [\"subject_id\", \"hadm_id\", \"storetime\"]\n    s = lookup(mp, mg, keys)\n    ok = (mg.gct == s) & mg.shifted.fillna(False)\n    print(f\"  {label:52s} avail {int(s.notna().sum()):6d} correct {int(ok.sum()):6d}\")\n    res[label] = (s, ok)\n\n# combined: chartevents session first, labs session as fallback\nce_s, ce_ok = res[\"chartevents (subject,stay,storetime,caregiver)\"]\nlb_s, lb_ok = res[\"labs (subject,hadm,storetime)\"]\nfloor = pd.to_datetime(mg.storetime, errors=\"coerce\").dt.floor(\"h\")\ncomb = ce_s.where(ce_s.notna(), lb_s)\ncomb = comb.where(comb.notna(), floor)\nok_comb = (mg.gct == comb) & mg.shifted.fillna(False)\nprint(\"\\ncombined (chartevents session -> labs session -> floor):\",\n      int(ok_comb.sum()), \"of\", int(mg.shifted.fillna(False).sum()), \"corrupted rows\")\nce_only = ce_s.where(ce_s.notna(), floor)\nprint(\"chartevents session -> floor:                    \", int((mg.gct == ce_only).sum()))\nprint(\"floor only:                                      \", int((mg.gct == floor).sum()))\n"}
