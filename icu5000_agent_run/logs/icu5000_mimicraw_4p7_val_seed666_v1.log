32).astype(np.float64)\ngold_txt = m.amount_g.to_numpy()\nrate = m.rate.to_numpy(float)\nweight = m.w.to_numpy(float)\ndur = m.dur.to_numpy(float)\nrpm = np.where(per_hour, rate / 60.0, rate)\n\ndef score(name, vals, sel):\n    v = np.asarray(vals, dtype=float)\n    ok = np.array([repr(float(x)) == g for x, g in zip(v, gold_txt)])\n    print(f\"  {name:46s} text {int(ok[sel].sum()):5d}/{int(sel.sum()):5d}\")\n\nsel = per_kg\nprint(\"== per-kg rows (all) ==\", int(sel.sum()))\nvariants = {\n    \"F(rpm*dur*w)/1e3\": F(rpm * dur * weight) / 1000.0,\n    \"F(F(rpm*dur)*w)/1e3\": F(F(rpm * dur) * weight) / 1000.0,\n    \"F(rpm*F(dur)*w)/1e3\": F(rpm * F(dur) * weight) / 1000.0,\n    \"F(F(rpm)*dur)*w/1e3\": F(F(rpm) * dur) * weight / 1000.0,\n    \"F(rpm)*F(dur)*F(w)/1e3\": F(rpm) * F(dur) * F(weight) / 1000.0,\n    \"F(F(rpm*dur*w)/1e3)\": F(F(rpm * dur * weight) / 1000.0),\n    \"F(rpm*dur)*F(w)/1e3\": F(rpm * dur) * F(weight) / 1000.0,\n    \"F(rpm*F(dur*w))/1e3\": F(rpm * F(dur * weight)) / 1000.0,\n    \"F(F(rpm*F(dur))*F(w))/1e3\": F(F(rpm * F(dur)) * F(weight)) / 1000.0,\n    \"F(rpm/1e3*dur*w)\": F(rpm / 1000.0 * dur * weight),\n    \"F(rpm*dur*w)/1e3 (w as f32)\": F(rpm * dur * F(weight)) / 1000.0,\n}\nfor k, v in variants.items():\n    score(k, v, sel & ~mcg2mg)\nprint(\"== per-kg mcg->mg rows ==\", int((sel & mcg2mg).sum()))\nfor k, v in variants.items():\n    score(k, v, sel & mcg2mg)\nprint(\"== plain rows (control) ==\", int((~sel).sum()))\nfor k, v in {\"F(rpm)*dur\": F(rpm) * dur, \"F(rpm*dur)\": F(rpm * dur),\n             \"F(F(rpm)*dur)\": F(F(rpm) * dur)}.items():\n    score(k, v, ~sel)\n"}
