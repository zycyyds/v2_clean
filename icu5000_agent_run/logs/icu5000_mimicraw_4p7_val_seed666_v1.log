 x) else x)\nknown = set(ic.stay_id)\ndef fix_stay(s):\n    if s in known:\n        return s\n    for k in range(1, 4):\n        if s[k:] in known:\n            return s[k:]\n    return s\nce[\"stay_id\"] = ce.stay_id.map(fix_stay)\nce[\"ct\"] = pd.to_datetime(ce.charttime, errors=\"coerce\")\nout1 = {s: (pd.to_datetime(o_) + pd.Timedelta(days=1)) for s, o_ in zip(ic.stay_id, ic.outtime)}\nce[\"shifted\"] = [(out1.get(s) is not None and c == out1.get(s)) for s, c in zip(ce.stay_id, ce.ct)]\ngood = ce[~ce.shifted]\nprint(\"chartevents rows\", len(ce), \"shifted\", int(ce.shifted.sum()), \"usable\", len(good))\n\ndef session_map(keys):\n    g = good.groupby(keys)[\"ct\"]\n    first = g.first(); nuni = g.nunique()\n    return first[nuni == 1]\n\ndef test(keys, label):\n    mp = session_map(keys)\n    if len(mp):\n        key = pd.MultiIndex.from_frame(m[list(keys)])\n        sess = mp.reindex(key)\n    else:\n        sess = pd.Series(np.nan, index=m.index)\n    ok_sess = m.gct == sess\n    ok_floor = m.gct == m.floorh\n    print(f\"  {label:52s} sess avail {int(sess.notna().sum()):4d} correct {int(ok_sess.sum()):4d} \"\n          f\"| floor {int(ok_floor.sum()):4d} | union {int((ok_sess|ok_floor).sum()):4d} \"\n          f\"| sess-and-not-floor {int((ok_sess & ~ok_floor).sum()):4d}\")\n    return sess\n\ntest([\"subject_id\", \"stay_id\", \"storetime\"], \"(subject,stay,storetime)\")\ntest([\"subject_id\", \"stay_id\", \"storetime\", \"caregiver_id\"], \"(subject,stay,storetime,caregiver)\")\ntest([\"subject_id\", \"stay_id\", \"caregiver_id\"], \"(subject,stay,caregiver)\")\n# charttime on the hour of the session start: floor the session charttime\nmp = session_map([\"subject_id\", \"stay_id\", \"storetime\"])\nif len(mp):\n    key = pd.MultiIndex.from_frame(m[[\"subject_id\", \"stay_id\", \"storetime\"]])\n    sess = mp.reindex(key)\n    sess_h = sess.dt.floor(\"h\")\n    print(\"  session charttime floored to the hour:\", int((m.gct == sess_h).sum()))\n# the nearest session charttime (absolute distance)\nif len(mp):\n    d = (m.gct - sess).dt.total_seconds().abs()\n    print(\"  |gold - session| distribution (h):\", (d / 3600).describe()[[\"25%\", \"50%\", \"75%\"]].round(2).to_dict())\n    print(\"  |gold - floor(st)| distribution (h):\",\n          ((m.gct - m.floorh).dt.total_seconds().abs() / 3600).describe()[[\"25%\", \"50%\", \"75%\"]].round(2).to_dict())\n"}
