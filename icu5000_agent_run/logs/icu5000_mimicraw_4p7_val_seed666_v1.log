Let me implement:
```python
def read_csv_chunks(path, dtypes, parse_dates, chunksize=2_000_000):
    parts = []
    for ch in pd.read_csv(path, dtype=dtypes, keep_default_na=False, parse_dates=parse_dates, chunksize=chunksize):
        parts.append(ch)
    return concat_categories(parts)

def concat_categories(parts):
    if len(parts) == 1: return parts[0]
    catcols = [c for c in parts[0].columns if isinstance(parts[0][c].dtype, pd.CategoricalDtype)]
    union = {}
    for c in catcols:
        s = set()
        for ch in parts: s.update(ch[c].cat.categories)
        union[c] = sorted(s)
    for ch in parts:
        for c in catcols:
            ch[c] = ch[c].cat.set_categories(union[c])
    return pd.concat(parts, ignore_index=True, copy=False)
```
