ished'] = raw['statusdescription'].fillna('') == 'FinishedRunning'\n    return raw, ref\n\n\nraw, ref = load('train')\n# ---------- delivery structure: (linkorderid, starttime) ----------\ng = raw.groupby(['linkorderid', 'starttime'], sort=True)\ndeliv = g.agg(n=('itemid', 'size'),\n              any_rate=('has_rate', 'any'),\n              any_finished=('finished', 'any')).reset_index()\n# the \"main\" row = the row of the delivery that carries a rate\nmainrows = raw[raw['has_rate']].sort_values(['linkorderid', 'starttime'])\nmainrows = mainrows.drop_duplicates(subset=['linkorderid', 'starttime'], keep='first')\nmainrows = mainrows[['linkorderid', 'starttime', 'rate_n', 'originalamount_n', 'finished']]\ndeliv = deliv.merge(mainrows, on=['linkorderid', 'starttime'], how='left', suffixes=('', '_main'))\ndeliv = deliv.sort_values(['linkorderid', 'starttime'])\ndeliv['next_start'] = deliv.groupby('linkorderid')['starttime'].shift(-1)\ndeliv['chain_min'] = (deliv['next_start'] - deliv['starttime']).dt.total_seconds() / 60\n# duration of the main row of the delivery\nrate_dur = deliv['originalamount_n'] / deliv['rate_n'].replace(0, np.nan) * 60\ndur_main = pd.Series(np.nan, index=deliv.index)\nuse = deliv['finished'].fillna(False) & deliv['rate_n'].notna() & (deliv['rate_n'] > 0)\ndur_main = dur_main.mask(use, rate_dur.round())\ndur_main = dur_main.mask(dur_main.isna() & deliv['chain_min'].notna(), deliv['chain_min'])\ndur_main = dur_main.mask(dur_main.isna() & ~deliv['any_rate'], 1.0)\ndur_main = dur_main.mask(dur_main.isna(), rate_dur.round())\ndeliv['dur_main'] = dur_main\n# amount delivered by the main row\namt_main = pd.Series(np.nan, index=deliv.index)\namt_main = amt_main.mask(use, deliv['originalamount_n'])\namt_main = amt_main.mask(amt_main.isna() & deliv['chain_min'].notna(),\n                          deliv['rate_n'] * deliv['chain_min'] / 60)\namt_main = amt_main.mask(amt_main.isna() & ~deliv['any_rate'], deliv['originalamount_n'])\ndeliv['amt_main'] = amt_main\n\nD = deliv.set_index(['linkorderid', 'starttime'])\nkey = pd.MultiIndex.from_arrays([raw['linkorderid'], raw['starttime']])\nraw['dur_deliv'] = D['dur_main'].reindex(key).values\nraw['amt_main'] = D['amt_main'].reindex(key).values\nraw['main_orig'] = D['originalamount_n'].reindex(key).values\nraw['chain_min'] = D['chain_min'].reindex(key).values\nraw['deliv_any_rate'] = D['any_rate'].reindex(key).values\n\n# ---------- row level rules ----------\nrow_rate_dur = (raw['originalamount_n'] / raw['rate_n'].replace(0, np.nan) * 60).round()\ndur = pd.Series(np.nan, index=raw.index)\n# a) row has a rate and finished -> ordered amount / rate\ndur = dur.mask(raw['has_rate'] & raw['finished'], row_rate_dur)\n# b) row has a rate and not finished -> the chain (next delivery start) else ordered/rate\ndur = dur.mask(raw['has_rate'] & ~raw['finished'] & raw['chain_min'].notna(), raw['chain_min'])\ndur = dur.mask(raw['has_rate'] & ~raw['finished'] & raw['chain_min'].isna(), row_rate_dur)\n# c) row has no rate -> the duration of the delivery (the main row's duration) else 1 minute\ndur = dur.mask(~raw['has_rate'] & raw['deliv_any_rate'].fillna(False), raw['dur_deliv'])\ndur = dur.mask(~raw['has_rate'] & ~raw['deliv_any_rate'].fillna(False), 1.0)\nraw['dur_pred'] = dur\n\namt = raw['originalamount_n'].copy()\n# main row (has a rate)\nmfin = raw['has_rate'] & raw['finished']\nmntf = raw['has_rate'] & ~raw['finished']\namt = amt.mask(mfin, raw['originalamount_n'])\namt = amt.mask(mntf, raw['rate_n'] * raw['dur_pred'] / 60)\n# component row of a delivery with a main row -> main amount * (own originalamount / main originalamount)\nfrac = raw['originalamount_n'] / raw['main_orig'].replace(0, np.nan)\ncomp = (~raw['has_rate']) & raw['deliv_any_rate'].fillna(False) & frac.notna()\namt = amt.mask(comp, raw['amt_main'] * frac)\n\nraw['end_pred'] = raw['starttime'] + pd.to_timedelta(raw['dur_pred'].fillna(1.0) * 60, unit='s')\nraw['amt_str'] = amt.map(fmt)\nraw['end_str'] = raw['end_pred'].dt.strftime('%Y-%m-%d %H:%M:%S')\n\n# ---------- pair with the reference ----------\npairs = []\nfor k, sub in raw.groupby(['subject_id', 'stay_id', 'itemid', 'starttime']):\n    r = ref[(ref.subject_id == k[0]) & (ref.stay_id == k[1]) & (ref.itemid == k[2]) & (ref.starttime == k[3])]\n    if len(r) != len(sub):\n        continue\n    for i in range(len(sub)):\n        pairs.append({**sub.iloc[i].to_dict(), 'ref_amount': r.iloc[i]['amount'], 'ref_end': r.iloc[i]['endtime']})\np = pd.DataFrame(pairs)\np['ref_amount_n'] = pd.to_numeric(p['ref_amount'], errors='coerce')\ncur_end = p['starttime'] + pd.to_timedelta(np.where(p['has_rate'], row_rate_dur.fillna(1.0), 1.0) * 60, unit='s')\nprint('rows paired:', len(p))\nprint()\nprint('ENDTIME  new rule   :', round(float((p['end_str'] == p['ref_end']).mean()), 4))\nprint('         current rule:', round(float((cur_end.dt.strftime('%Y-%m-%d %H:%M:%S') == p['ref_end']).mean()), 4))\nprint()\nprint('AMOUNT   new rule (str)  :', round(float((p['amt_str'] == p['ref_amount']).mean()), 4))\nprint('         current (str)     :', round(float((p['originalamount_n'].map(fmt) == p['ref_amount']).mean()), 4))\nprint('         new rule (numeric):', round(float((p['amt_str'].map(float).round(6) == p['ref_amount_n'].round(6)).mean()), 4))\nprint('         current  (numeric):', round(float((p['originalamount_n'].map(fmt).map(float).round(6) == p['ref_amount_n'].round(6)).mean()), 4))\nprint()\nfor name, m in (('no rate (bolus)', ~p['has_rate'] & ~p['deliv_any_rate'].fillna(False)),\n                ('no rate (component)', ~p['has_rate'] & p['deliv_any_rate'].fillna(False)),\n                ('rate+finished', p['has_rate'] & p['finished']),\n                ('rate+other', p['has_rate'] & ~p['finished'])):\n    if m.sum():\n        print(f'  {name:20s} n={int(m.sum()):5d} end={float((p[\"end_str\"][m] == p[\"ref_end\"][m]).mean()):.4f} '\n              f'amt_str={float((p[\"amt_str\"][m] == p[\"ref_amount\"][m]).mean()):.4f} '\n              f