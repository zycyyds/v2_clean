```python
def _segment_minutes(self, i):
    if "linkorderid" not in i.columns:
        return pd.Series(np.nan, index=i.index)
    t = pd.to_datetime(i.starttime, errors="coerce")
    key = pd.DataFrame({"stay": i.stay_id, "link": i.linkorderid, "t": t})
    h = pd.util.hash_pandas_object(key, index=False)
    # one row per (stay, link, start time) = one segment
    seg = pd.DataFrame({"h": h.to_numpy(), "stay": key["stay"].to_numpy(),
                        "link": key["link"].to_numpy(), "t": key["t"].to_numpy()})
    seg = seg.sort_values(["stay", "link", "t"])
    first = ~seg.duplicated(["stay", "link", "t"], keep="first")
    u = seg[first]
    nxt = u.groupby(["stay", "link"], observed=True)["t"].shift(-1)
    mins = (nxt - u["t"]).dt.total_seconds() / 60.0
    lookup = pd.Series(mins.to_numpy(), index=u["h"].to_numpy())
    out = pd.Series(h.map(lookup).to_numpy(), index=i.index)
    return out
```
