def map_categorical(series, func):
    """apply func element-wise to a (possibly categorical) series, keeping it
    categorical when the input was categorical (memory friendly)."""
    if isinstance(series.dtype, pd.CategoricalDtype):
        cats = list(series.cat.categories)
        new = [func(c) for c in cats]
        uniq = list(dict.fromkeys(new))
        lut = {v: i for i, v in enumerate(uniq)}
        code_map = np.array([lut[v] for v in new], dtype=np.int32)
        codes = series.cat.codes.to_numpy()
        newcodes = np.where(codes >= 0, code_map[np.clip(codes, 0, None)], -1)
        return pd.Categorical.from_codes(newcodes, categories=uniq)
    return series.map(func)
```
